---
// 全局浮动分享条。桌面：左侧竖排固定；移动：底部横条固定。零第三方脚本、不追踪。
// 海湾市场优先 WhatsApp。分享链接构建期拼好（纯静态）；复制链接走客户端脚本。
import Icon from './Icon.astro';
const { url, title } = Astro.props;

const encUrl = encodeURIComponent(url);
const encTitle = encodeURIComponent(title);
const encTitleUrl = encodeURIComponent(`${title} ${url}`);

const waHref = `https://wa.me/?text=${encTitleUrl}`;
const xHref = `https://twitter.com/intent/tweet?text=${encTitle}&url=${encUrl}`;
const tgHref = `https://t.me/share/url?url=${encUrl}&text=${encTitle}`;
---
<div class="share-bar" data-share-url={url} data-share-title={title}>
  <span class="sb-label-d">شارك</span>
  <span class="sb-label-m"><Icon id="ico-share" size={17} />شارك الموقع</span>
  <div class="sb-btns">
    <a class="sb-btn wa" href={waHref} target="_blank" rel="noopener" aria-label="واتساب" title="واتساب"><Icon id="ico-whatsapp" size={21} /></a>
    <a class="sb-btn x" href={xHref} target="_blank" rel="noopener" aria-label="إكس" title="إكس"><Icon id="ico-x" size={18} /></a>
    <a class="sb-btn tg" href={tgHref} target="_blank" rel="noopener" aria-label="تيليجرام" title="تيليجرام"><Icon id="ico-telegram" size={20} /></a>
    <button type="button" class="sb-btn copy" data-copy aria-label="نسخ الرابط" title="نسخ الرابط">
      <Icon id="ico-link" size={19} class="sb-copy-icon" />
      <Icon id="ico-check" size={19} class="sb-check-icon" />
    </button>
  </div>
  <span class="sr-only" role="status" aria-live="polite" data-copy-status></span>
</div>

<style>
  .share-bar {
    position: fixed; z-index: 200; background: #fff;
    display: flex; align-items: center;
    box-shadow: 0 8px 30px rgba(16,40,28,.12);
  }
  .sb-btns { display: flex; align-items: center; }
  .sb-btn {
    display: flex; align-items: center; justify-content: center;
    border: none; cursor: pointer; text-decoration: none;
    transition: filter .15s ease;
  }
  .sb-btn:hover { filter: brightness(.96); }
  .sb-btn.wa { background: #EAF3EE; color: #1A9E5E; }
  .sb-btn.x  { background: #F0EFE9; color: #1B2D24; }
  .sb-btn.tg { background: #E7F1F7; color: #2A8CC4; }
  .sb-btn.copy { background: #F7EFDB; color: #977322; }
  .sb-check-icon { display: none; }
  .sb-btn.copied .sb-copy-icon { display: none; }
  .sb-btn.copied .sb-check-icon { display: inline-block; color: #1A9E5E; }

  /* ===== 桌面：屏幕左侧竖排（物理 left，与设计一致；右侧圆角朝向内容） ===== */
  @media (min-width: 860px) {
    .share-bar {
      left: 0; top: 50%; transform: translateY(-50%);
      flex-direction: column; gap: 8px; padding: 12px 10px;
      border: 1px solid #E6E2D5; border-left: none;
      border-radius: 0 16px 16px 0;
    }
    .sb-label-d { font-size: 11px; font-weight: 600; color: var(--color-text-faint); text-align: center; letter-spacing: .04em; }
    .sb-label-m { display: none; }
    .sb-btns { flex-direction: column; gap: 8px; }
    .sb-btn { inline-size: 44px; block-size: 44px; border-radius: 12px; }
  }

  /* ===== 移动：底部横条 ===== */
  @media (max-width: 859px) {
    .share-bar {
      inset-inline: 0; inset-block-end: 0;
      background: rgba(255,255,255,.94); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
      border-block-start: 1px solid #E6E2D5; box-shadow: 0 -6px 24px rgba(16,40,28,.08);
      padding-block: 9px calc(9px + env(safe-area-inset-bottom)); padding-inline: clamp(12px,5vw,24px); gap: 10px;
    }
    .sb-label-d { display: none; }
    .sb-label-m { display: flex; align-items: center; gap: 7px; font-size: 13px; font-weight: 600; color: #42514A; }
    .sb-label-m :global(.icon) { color: var(--color-primary); }
    .sb-btns { margin-inline-start: auto; gap: 9px; }
    .sb-btn { inline-size: 44px; block-size: 44px; border-radius: 12px; }
  }
</style>

<script>
  // 复制链接 + 三级回退。多实例安全（实际全局仅一个）。
  for (const root of document.querySelectorAll('.share-bar')) {
    const url = root.dataset.shareUrl || location.href;

    async function copyToClipboard(text) {
      try {
        if (navigator.clipboard && window.isSecureContext) {
          await navigator.clipboard.writeText(text);
          return true;
        }
      } catch (_) { /* 落到 execCommand 回退 */ }
      try {
        const ta = document.createElement('textarea');
        ta.value = text; ta.style.position = 'fixed'; ta.style.insetInlineStart = '-9999px';
        ta.setAttribute('readonly', '');
        document.body.appendChild(ta); ta.select();
        const ok = document.execCommand('copy');
        document.body.removeChild(ta);
        return ok;
      } catch (_) { return false; }
    }

    const copyBtn = root.querySelector('[data-copy]');
    const status = root.querySelector('[data-copy-status]');
    if (copyBtn) {
      copyBtn.addEventListener('click', async () => {
        const ok = await copyToClipboard(url);
        if (status) status.textContent = ok ? 'تم نسخ الرابط' : 'تعذّر النسخ';
        if (ok) {
          copyBtn.classList.add('copied');
          setTimeout(() => { copyBtn.classList.remove('copied'); if (status) status.textContent = ''; }, 1800);
        }
      });
    }
  }
</script>
