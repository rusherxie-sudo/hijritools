---
// FAQ 折叠手风琴。原生 <details name> 实现单开（零 JS，旧浏览器降级为可多开）。
// 内容始终在 DOM 中（利于 SEO 与 FAQPage 结构化数据）。
const { faqs, title = 'أسئلة شائعة' } = Astro.props;
---
<section class="prose faq">
  <h2>{title}</h2>
  <div class="faq-list">
    {faqs.map((f) => (
      <details class="faq-item" name="faq">
        <summary>
          <span>{f.q}</span>
          <svg class="faq-chevron" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
        </summary>
        <div class="faq-a"><p>{f.a}</p></div>
      </details>
    ))}
  </div>
</section>
