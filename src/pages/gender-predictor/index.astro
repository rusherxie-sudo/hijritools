---
import ToolLayout from '../../layouts/ToolLayout.astro';
import Icon from "../../components/Icon.astro";
import { toolIconId } from "../../data/icons.js";
import Faq from "../../components/Faq.astro";
import Disclaimer from '../../components/Disclaimer.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import { getTool } from '../../data/tools.js';
import { HIJRI_MONTHS_AR } from '../../lib/hijri.js';
import { webAppJsonLd, faqJsonLd, graph } from '../../lib/seo.js';

const tool = getTool('gender-predictor');
const months = HIJRI_MONTHS_AR.slice(1); // 去掉索引 0 的空串
const faqs = [
  { q: 'ما هو الجدول الصيني لتوقع نوع الجنين؟', a: 'جدول قديم منسوب للصين يربط عمر الأم وشهر الحمل بنوع الجنين المتوقع. هو للتسلية فقط ولا أساس علمي له.' },
  { q: 'هل الجدول الصيني دقيق؟', a: 'لا. النتيجة للتسلية والترفيه فقط ولا يمكن الاعتماد عليها؛ الطريقة الموثوقة لمعرفة نوع الجنين هي السونار لدى الطبيب.' },
  { q: 'كيف أستخدم الجدول الصيني بالتقويم الهجري؟', a: 'أدخلي عمرك وشهر الحمل بالتقويم الهجري، ويعرض الجدول التوقع مباشرة. تذكّري أنه للتسلية فقط ولا أساس علمي له.' },
  { q: 'ما الفرق بين الجدول الصيني والسونار؟', a: 'السونار (الألتراساوند) وسيلة طبية دقيقة تُظهر نوع الجنين من الأسبوع ١٨-٢٠ من الحمل. أما الجدول الصيني فهو مجرد ترفيه يعتمد على معادلة رياضية قديمة دون أي دليل طبي.' },
  { q: 'هل يمكن استخدام الجدول الصيني قبل الحمل؟', a: 'لا، لأن الجدول يعتمد على شهر الحمل الفعلي. لكن بعض النساء يستخدمنه للمتعة بعد معرفة الحمل للمقارنة بين التوقّع والنتيجة الحقيقية لاحقًا.' },
  { q: 'من أين أتى الجدول الصيني؟', a: 'تقول الأسطورة إنه اكتُشف في مقبرة ملكية صينية عمرها ٧٠٠ عام، وكان يُستخدم في البلاط الإمبراطوري لتوقع جنس المواليد. لكن لا يوجد أي دليل أثري أو علمي يثبت هذه الرواية.' },
  { q: 'هل يختلف الجدول الصيني باختلاف التقويم الهجري أو الميلادي؟', a: 'يجب استخدام شهر الحمل بالتقويم القمري (الهجري) لأن الجدول الأصلي صُمم وفق التقويم القمري الصيني. أداتنا تحسب مباشرة بالهجري لتعطيك التوقّع الأقرب للنسخة الأصلية.' },
  { q: 'هل عمر الأم في الجدول الصيني يُحسب بالسنوات الهجرية أم الميلادية؟', a: 'الجدول يستخدم عمر الأم بالسنوات (وليس بالتقويم الهجري أو الميلادي تحديدًا). أدخلي عمرك الحالي بالسنة — فالفارق بين التقويمين لا يتجاوز سنة واحدة في معظم الأعمار.' },
  { q: 'كم نسبة دقة الجدول الصيني حسب الدراسات؟', a: 'الدراسات العلمية القليلة التي فحصت الجدول الصيني وجدت أن نسبة دقته لا تتجاوز ٥٠٪ — أي مثل رمي العملة المعدنية. لا يوجد أي دليل إحصائي على أنه أفضل من الصدفة.' },
  { q: 'كيف أحسب نوع الجنين بالطرق الطبية؟', a: 'الطرق الطبية الدقيقة تشمل: السونار (من الأسبوع ١٨)، فحص NIPT (من الأسبوع ١٠)، فحص بزل السلى. استشيري طبيبك لمعرفة الخيار المناسب لحالتك.' },
];
const jsonLd = graph(
  webAppJsonLd({ name: tool.titleAr, description: tool.descAr, path: '/gender-predictor/' }),
  faqJsonLd(faqs),
);
---
<ToolLayout title={tool.titleAr} description={tool.descAr} path="/gender-predictor/" jsonLd={jsonLd}>
  <div class="tool-head">
    <span class="tool-head-chip"><Icon id={toolIconId(tool.slug)} size={28} /></span>
    <div class="tool-head-text">
      <h1>{tool.titleAr}</h1>
      <p class="tool-intro">{tool.descAr}</p>
    </div>
  </div>

  <p class="fun-note">🎎 للتسلية فقط — هذا الجدول لا يستند إلى أي أساس علمي.</p>

  <div class="card">
    <div class="row">
      <div class="field" style="flex:0 1 160px"><label for="age">عمر الأم (سنة)</label><input type="number" id="age" value="28" min="18" max="45" /></div>
      <div class="field" style="flex:0 1 220px">
        <label for="mode">طريقة إدخال شهر الحمل</label>
        <select id="mode">
          <option value="hijri">اختيار الشهر الهجري</option>
          <option value="greg">من تاريخ الحمل الميلادي</option>
        </select>
      </div>
      <div class="field" id="field-hijri" style="flex:0 1 200px">
        <label for="hmonth">شهر الحمل (هجري)</label>
        <select id="hmonth">{months.map((m, i) => (<option value={i + 1}>{m}</option>))}</select>
      </div>
      <div class="field hidden" id="field-greg" style="flex:0 1 200px">
        <label for="gdate">تاريخ الحمل (ميلادي)</label>
        <input type="date" id="gdate" />
      </div>
    </div>
    <button class="btn" id="calc">توقّع نوع الجنين</button>
    <p class="error-text hidden" id="err"></p>
  </div>

  <div class="result hidden" id="result">
    <div style="color:var(--color-text-muted)">النتيجة المتوقعة (للتسلية)</div>
    <div class="result-main" id="out">-</div>
    <div id="out-month" style="color:var(--color-text-muted)"></div>
  </div>

  <article class="prose" style="margin-block-start:var(--space-8)">
    <h2>عن الجدول الصيني لتوقع نوع الجنين</h2>
    <p>الجدول الصيني لتوقع نوع الجنين — أو ما يُعرف بـ"الجدول الصيني للحمل" — هو أحد أشهر الخرافات القديمة التي لا تزال تثير فضول الحوامل حول العالم. تقول الأسطورة إن هذا الجدول اكتُشف قبل أكثر من ٧٠٠ عام في مقبرة إمبراطورية صينية، وكان أفراد البلاط الملكي يستخدمونه لتوقّع جنس المولود قبل ولادته.</p>
    <p>يعتمد الجدول على عاملين فقط: <strong>عمر الأم عند حدوث الحمل</strong> و<strong>شهر الحمل القمري</strong>. عند تقاطع العمر مع الشهر في خلايا الجدول تظهر النتيجة: ذكر (👦) أو أنثى (👧). ورغم بساطة الفكرة، لا يوجد أي دليل علمي أو إحصائي يثبت صحة هذه الطريقة.</p>
    <p>في نسختنا من الجدول الصيني، اعتمدنا <strong>التقويم الهجري (الأشهر القمرية)</strong> بدلاً من الميلادي، لأن الجدول الأصلي صُمم أساسًا وفق التقويم القمري الصيني — مما يجعل النسخة الهجرية أقرب إلى فكرة الجدول الأصلية من النسخ الميلادية المنتشرة على الإنترنت.</p>
    <p><strong>تنبيه مهم:</strong> الجدول الصيني للتسلية والترفيه فقط. لا تعتمدي عليه في أي قرار طبي أو أسري. الطريقة الوحيدة المؤكدة لمعرفة نوع الجنين هي الفحوصات الطبية مثل السونار (الألتراساوند) أو فحص الدم NIPT. نسبتهما تصل إلى أكثر من ٩٥٪.</p>
    <h2>كيف يعمل الجدول الصيني بالهجري؟</h2>
    <p>استخدام الأداة سهل جدًا:</p>
    <ol>
      <li>أدخلي <strong>عمرك الحالي</strong> بالسنوات (بين ١٨ و٤٥ سنة).</li>
      <li>اختاري <strong>شهر الحمل</strong> — إما باختيار الشهر الهجري مباشرة من القائمة، أو بإدخال تاريخ الحمل الميلادي لتحويله تلقائيًا إلى الشهر الهجري.</li>
      <li>اضغطي على "توقّع نوع الجنين" لتحصلي على النتيجة فورًا.</li>
    </ol>
    <p>يمكنك تجربة أعمار وأشهر مختلفة للمتعة! بعض الأمهات يحببن مقارنة توقّع الجدول مع نتيجة السونار بعد معرفة نوع الجنين الحقيقي. شاركي النتيجة مع العائلة والأصدقاء للمرح فقط.</p>
  </article>

  <Disclaimer variant="entertainment" />

  <Faq faqs={faqs} />

  <RelatedTools slugs={tool.related} />
</ToolLayout>

<script>
  import { predictGender } from '../../lib/gender.js';
  import { gregorianToHijri, HIJRI_MONTHS_AR } from '../../lib/hijri.js';
  import { parseISODate } from '../../lib/date-utils.js';

  const $ = (id) => document.getElementById(id);
  const showErr = (msg) => { const e = $('err'); e.textContent = msg; e.classList.remove('hidden'); $('result').classList.add('hidden'); };

  // 输入模式切换
  $('mode').addEventListener('change', () => {
    const greg = $('mode').value === 'greg';
    $('field-greg').classList.toggle('hidden', !greg);
    $('field-hijri').classList.toggle('hidden', greg);
  });

  function run() {
    const age = parseInt($('age').value, 10);
    if (!Number.isInteger(age) || age < 18 || age > 45) { showErr('عمر الأم يجب أن يكون بين ١٨ و٤٥ سنة.'); return; }

    let hmonth;
    if ($('mode').value === 'greg') {
      const d = parseISODate($('gdate').value);
      if (!d) { showErr('يرجى إدخال تاريخ الحمل الميلادي.'); return; }
      hmonth = gregorianToHijri(d, 0).hm;
    } else {
      hmonth = parseInt($('hmonth').value, 10);
    }

    try {
      const g = predictGender(age, hmonth);
      $('out').textContent = g === 'male' ? '👦 ذكر' : '👧 أنثى';
      $('out-month').textContent = `حسب الجدول الصيني — شهر الحمل: ${HIJRI_MONTHS_AR[hmonth]}`;
      $('err').classList.add('hidden');
      $('result').classList.remove('hidden');
    } catch (e) {
      showErr('تعذّر التوقّع، تأكد من المدخلات.');
    }
  }

  $('calc').addEventListener('click', run);
</script>

<style>
  .fun-note { background: var(--color-accent-light); color: var(--color-warning); padding: var(--space-3) var(--space-4); border-radius: var(--radius-sm); font-weight: 700; font-size: var(--fs-small); }
</style>
