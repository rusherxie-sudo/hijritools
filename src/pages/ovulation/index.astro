---
import ToolLayout from '../../layouts/ToolLayout.astro';
import Icon from "../../components/Icon.astro";
import { toolIconId } from "../../data/icons.js";
import Faq from "../../components/Faq.astro";
import Disclaimer from '../../components/Disclaimer.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import { getTool } from '../../data/tools.js';
import { webAppJsonLd, faqJsonLd, graph } from '../../lib/seo.js';

const tool = getTool('ovulation');
const faqs = [
  { q: 'كيف أحسب أيام التبويض؟', a: 'يحدث التبويض عادةً قبل ١٤ يومًا من موعد الدورة القادمة. ندخل تاريخ أول يوم في آخر دورة وطول الدورة، فنحسب يوم التبويض وفترة الخصوبة وموعد الدورة القادمة.' },
  { q: 'ما هي أيام الخصوبة الأعلى للحمل؟', a: 'فترة الخصوبة تمتد من ٥ أيام قبل التبويض إلى يوم بعده، لأن الحيوانات المنوية قد تعيش حتى ٥ أيام والبويضة نحو يوم.' },
  { q: 'هل النتيجة مؤكدة؟', a: 'النتيجة تقديرية وتختلف بين النساء وحسب انتظام الدورة. للتأكد استشيري طبيبك.' },
];
const jsonLd = graph(
  webAppJsonLd({ name: tool.titleAr, description: tool.descAr, path: '/ovulation/' }),
  faqJsonLd(faqs),
);
---
<ToolLayout title={tool.titleAr} description={tool.descAr} path="/ovulation/" jsonLd={jsonLd}>
  <div class="tool-head">
    <span class="tool-head-chip"><Icon id={toolIconId(tool.slug)} size={28} /></span>
    <div class="tool-head-text">
      <h1>{tool.titleAr}</h1>
      <p class="tool-intro">{tool.descAr}</p>
    </div>
  </div>

  <div class="card">
    <div class="row">
      <div class="field"><label for="lmp">أول يوم في آخر دورة شهرية</label><input type="date" id="lmp" /></div>
      <div class="field" style="flex:0 1 200px"><label for="cycle">طول الدورة (يوم)</label><input type="number" id="cycle" value="28" min="20" max="45" /></div>
    </div>
    <button class="btn" id="calc">احسبي</button>
    <p class="error-text hidden" id="err"></p>
  </div>

  <div class="result hidden" id="result">
    <div style="color:var(--color-text-muted)">يوم التبويض المتوقع</div>
    <div class="result-main num" id="ovu">-</div>
    <div class="num" id="ovu-hijri" style="color:var(--color-primary-dark)"></div>
    <hr class="gold-divider" />
    <div class="result-grid">
      <div class="stat"><div class="v num" id="fertile">-</div><div class="l">فترة الخصوبة العالية</div></div>
      <div class="stat"><div class="v num" id="next-period">-</div><div class="l">الدورة القادمة</div></div>
    </div>
  </div>

  <Disclaimer variant="health" />

  <!-- المحتوى التعليمي -->
  <div class="card tool-guide">
    <h2>ما هو التبويض ولماذا يهمك؟</h2>
    <p>التبويض هو خروج بويضة ناضجة من المبيض، ويحدث عادةً مرة واحدة في كل دورة شهرية. فترة الخصوبة تمتد من ٥ أيام قبل يوم التبويض إلى يوم بعده، لأن الحيوانات المنوية قد تعيش حتى ٥ أيام داخل الجهاز التناسلي الأنثوي.</p>

    <h2>كيف أعرف يوم التبويض؟</h2>
    <p>الطريقة الأكثر شيوعًا هي حساب ١٤ يومًا قبل موعد الدورة القادمة. إذا كانت دورتك ٢٨ يومًا، فيحدث التبويض حول اليوم ١٤. لكن هذه الطريقة غير دقيقة للنساء اللواتي دوراتهن غير منتظمة.</p>

    <h2>علامات التبويض</h2>
    <ul>
      <li><strong>تغيّر الإفرازات:</strong> تصبح شفافة ومطاطة كزلال البيض</li>
      <li><strong>ارتفاع طفيف في الحرارة:</strong> ٠.٣–٠.٥ درجة بعد التبويض</li>
      <li><strong>ألم خفيف:</strong> في أحد جانبي البطن (mittelschmerz)</li>
      <li><strong>زيادة الرغبة:</strong> الجنسية تزداد طبيعيًا</li>
    </ul>

    <h2>نصائح لزيادة فرص الحمل</h2>
    <ul>
      <li>العلاقة خلال فترة الخصوبة (الأيام ١٠–١٦ من الدورة)</li>
      <li>الحفاظ على وزن صحي</li>
      <li>تجنب التدخين والكافيين الزائد</li>
      <li>استخدام <a href="/ovulation/">حاسبة التبويض</a> لتحديد الأيام المثلى</li>
    </ul>
  </div>

  <Faq faqs={faqs} />

  <RelatedTools slugs={tool.related} />
</ToolLayout>

<script>
  import { ovulationFromLMP } from '../../lib/ovulation.js';
  import { formatGregorian, formatHijri } from '../../lib/hijri.js';
  import { parseISODate } from '../../lib/date-utils.js';

  const $ = (id) => document.getElementById(id);
  const showErr = (msg) => { const e = $('err'); e.textContent = msg; e.classList.remove('hidden'); $('result').classList.add('hidden'); };

  function run() {
    const lmp = parseISODate($('lmp').value);
    if (!lmp) { showErr('يرجى إدخال تاريخ آخر دورة شهرية.'); return; }
    const cycle = parseInt($('cycle').value, 10);
    if (!Number.isInteger(cycle) || cycle < 20 || cycle > 45) { showErr('طول الدورة يجب أن يكون بين ٢٠ و٤٥ يومًا.'); return; }

    const r = ovulationFromLMP(lmp, cycle, 0);
    $('ovu').textContent = formatGregorian(r.ovulationDay);
    $('ovu-hijri').textContent = formatHijri(r.ovulationHijri);
    $('fertile').textContent = `${formatGregorian(r.fertileStart)} – ${formatGregorian(r.fertileEnd)}`;
    $('next-period').textContent = formatGregorian(r.nextPeriod);
    $('err').classList.add('hidden');
    $('result').classList.remove('hidden');
  }

  $('calc').addEventListener('click', run);
  $('lmp').addEventListener('change', run);
  $('cycle').addEventListener('change', run);
</script>
