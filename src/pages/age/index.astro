---
import ToolLayout from '../../layouts/ToolLayout.astro';
import Icon from "../../components/Icon.astro";
import { toolIconId } from "../../data/icons.js";
import Faq from "../../components/Faq.astro";
import Disclaimer from '../../components/Disclaimer.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import { getTool } from '../../data/tools.js';
import { gccOrder, countries } from '../../data/countries.js';
import { webAppJsonLd, faqJsonLd, graph } from '../../lib/seo.js';

const tool = getTool('age');
const faqs = [
  { q: 'كيف يُحسب العمر بالهجري؟', a: 'نحوّل تاريخ ميلادك وتاريخ اليوم إلى تقويم أم القرى ونحسب الفرق بالسنوات والأشهر والأيام الهجرية. السنة الهجرية أقصر من الميلادية بنحو ١١ يومًا، لذا يزيد عمرك الهجري سنة تقريبًا كل ٣٣ سنة.' },
  { q: 'هل يمكنني حساب العمر حتى تاريخ معيّن وليس اليوم؟', a: 'نعم، غيّر حقل «حتى تاريخ» لحساب عمرك في أي يوم مستقبلي أو ماضٍ.' },
  { q: 'متى عيد ميلادي القادم؟', a: 'نعرض العد التنازلي لعيد ميلادك الميلادي والهجري معًا.' },
];
const jsonLd = graph(
  webAppJsonLd({ name: tool.titleAr, description: tool.descAr, path: '/age/' }),
  faqJsonLd(faqs),
);
---
<ToolLayout title={tool.titleAr} description={tool.descAr} path="/age/" jsonLd={jsonLd}>
  <div class="tool-head">
    <span class="tool-head-chip"><Icon id={toolIconId(tool.slug)} size={28} /></span>
    <div class="tool-head-text">
      <h1>{tool.titleAr}</h1>
      <p class="tool-intro">{tool.descAr}</p>
    </div>
  </div>

  <div class="card">
    <div class="row">
      <div class="field"><label for="birth">تاريخ الميلاد (ميلادي)</label><input type="date" id="birth" /></div>
      <div class="field"><label for="asof">حتى تاريخ</label><input type="date" id="asof" /></div>
      <div class="field" style="flex:0 1 160px">
        <label for="country">الدولة</label>
        <select id="country">{gccOrder.map((cc) => (<option value={cc}>{countries[cc].nameAr}</option>))}</select>
      </div>
    </div>
    <button class="btn" id="calc">احسب العمر</button>
    <p class="error-text hidden" id="err"></p>
  </div>

  <div class="result hidden" id="result">
    <div class="result-main"><span class="num" id="g-years">0</span> سنة <span class="num" id="g-months">0</span> شهر <span class="num" id="g-days">0</span> يوم</div>
    <div style="color:var(--color-text-muted)">بالتقويم الميلادي</div>
    <hr class="gold-divider" />
    <div style="font-size:1.4rem;font-weight:700;color:var(--color-primary-dark)">
      <span class="num" id="h-years">0</span> سنة <span class="num" id="h-months">0</span> شهر <span class="num" id="h-days">0</span> يوم
    </div>
    <div style="color:var(--color-text-muted)">بالتقويم الهجري</div>

    <div class="result-grid">
      <div class="stat"><div class="v num" id="total-months">0</div><div class="l">إجمالي الأشهر</div></div>
      <div class="stat"><div class="v num" id="total-weeks">0</div><div class="l">إجمالي الأسابيع</div></div>
      <div class="stat"><div class="v num" id="total-days">0</div><div class="l">إجمالي الأيام</div></div>
      <div class="stat"><div class="v num" id="total-hours">0</div><div class="l">إجمالي الساعات</div></div>
      <div class="stat"><div class="v num" id="total-minutes">0</div><div class="l">إجمالي الدقائق</div></div>
      <div class="stat"><div class="v" id="weekday">-</div><div class="l">يوم الميلاد</div></div>
      <div class="stat"><div class="v num" id="next-greg">0</div><div class="l">يوم حتى ميلادك الميلادي</div></div>
      <div class="stat"><div class="v num" id="next-hijri">0</div><div class="l">يوم حتى ميلادك الهجري</div></div>
    </div>
  </div>

  <Disclaimer variant="calc" />

  <!-- المحتوى التعليمي -->
  <div class="card tool-guide">
    <h2>لماذا أحسب عمري بالتقويمين معًا؟</h2>
    <p>في دول الخليج العربي، كثير من المعاملات الرسمية تتطلب العمر بالتقويم الهجري إلى جانب الميلادي. بطاقة الهوية السعودية مثلًا تعرض تاريخ الميلاد بالتقويمين. وفهم الفرق بين العمرين مفيد للتخطيط (سفر، تقاعد، دراسة) حيث أن السنة الهجرية أقصر بحوالي ١١ يومًا من الميلادية.</p>

    <h2>كيف يختلف العمر الهجري عن الميلادي؟</h2>
    <p>كل ١١ يومًا فرق بين التقويمين يتراكم. بعد ٣٣ سنة ميلادية، يصبح العمر الهجري أكبر بسنة كاملة تقريبًا. هذا يعني:</p>
    <ul>
      <li>عند بلوغك ٣٣ سنة ميلادية ← عمرك الهجري حوالي ٣٤ سنة</li>
      <li>عند بلوغك ٦٦ سنة ميلادية ← عمرك الهجري حوالي ٦٨ سنة</li>
      <li>عند بلوغك ٩٩ سنة ميلادية ← عمرك الهجري حوالي ١٠٢ سنة</li>
    </ul>
    <p>هذا الفرق مهم عند حساب مواعيد التقاعد والالتزامات الدينية التي ترتبط بالتقويم الهجري.</p>

    <h2>استخدامات عملية لحاسبة العمر</h2>
    <ul>
      <li><strong>التسجيل المدرسي:</strong> بعض المدارس تحدد سن القبول بالتقويم الميلادي، لكن الوثائق الرسمية قد تكون بالتقويم الهجري.</li>
      <li><strong>التأمين الصحي:</strong> شركات التأمين تستعمل العمر الميلادي لحساب الأقساط والوثائق.</li>
      <li><strong>التخطيط للحج والعمرة:</strong> العمر الهجري يحسب بطريقة مختلفة للحج (عمر يوم ٩ ذو الحجة).</li>
      <li><strong>المعاملات الحكومية:</strong> استخراج أو تجديد بطاقة الهوية، جواز السفر، الرخصة.</li>
    </ul>

    <h2>نصيحة: احتفظ بتاريخ ميلادك بالتقويمين</h2>
    <p>أنشئ سجلًا بحفظ تاريخ ميلادك بالتقويمين الميلادي والهجري. ستجده مفيدًا عند ملء نماذج حكومية في السعودية والإمارات ودول الخليج الأخرى. التحويل بين التقويمين متاح في <a href="/hijri/">محول التاريخ</a>.</p>

    <h2>حاسبة العمر: طريقة دقيقة لمعرفة عمرك باليوم والشهر والسنة</h2>
    <p>حاسبة العمر هي أداة مجانية تحسب عمرك بدقة عالية بالتقويمين الميلادي والهجري معًا. تكفي إدخال تاريخ ميلادك، وتقوم الأداة فورًا بحساب سنواتك وأشهرك وأيامك، إضافة إلى إجمالي الأسابيع والأيام والساعات والدقائق التي عشتها منذ يوم ميلادك. تعمل حاسبة العمر دون الحاجة إلى تسجيل أو تحميل أي برنامج، وتدعم جميع دول مجلس التعاون الخليجي. كما تحسب الأداة العد التنازلي لعيد ميلادك القادم بالتقويمين، فتعرف بالضبط كم يومًا تبقّى على ذكرى ميلادك المقبلة.</p>

    <h2>اعرف عمرك بالميلادي في ثوانٍ</h2>
    <p>لكي اعرف عمرك بالميلادي، ما عليك سوى إدخال تاريخ ميلادك في حقل «تاريخ الميلاد» ثم الضغط على زر «احسب العمر». مثلًا، إذا وُلدت في ١٥ مارس ١٩٩٠، واليوم ٨ يوليو ٢٠٢٦، فإن عمرك الميلادي هو ٣٦ سنة و٣ أشهر و٢٣ يومًا. أما إجمالي الأيام التي عشتها فيبلغ نحو ١٣٢٦٤ يومًا، أي ما يقارب ٣١٨٣٣٦ ساعة، أو نحو ١٩ مليون دقيقة. هذه الأرقام مفيدة عند ملء النماذج الرسمية أو عند التخطيط لمناسبات مثل عيد الميلاد أو التقاعد. كما تساعدك الأداة على معرفة يوم الأسبوع الذي وُلدت فيه، فمثلًا من وُلد في ١٥ مارس ١٩٩٠ كان ذلك يوم الخميس.</p>

    <h2>الفرق بين العمر الميلادي والعمر الهجري بالأرقام</h2>
    <p>السنة الهجرية تعادل ٣٥٤ يومًا تقريبًا، بينما السنة الميلادية ٣٦٥ يومًا، أي بفارق ١١ يومًا في السنة. يتراكم هذا الفارق مع الوقت فيصبح عمرك الهجري أكبر من عمرك الميلادي. على سبيل المثال، شخص وُلد في ١ يناير ١٩٩٠ ميلادي، يكون تاريخ ميلاده الهجري تقريبًا في شهر جمادى الآخرة ١٤١٠ هـ. وعند حساب العمر في ٨ يوليو ٢٠٢٦ (الموافق ١٣ محرم ١٤٤٨ هـ)، نجد أن العمر الميلادي ٣٦ سنة، بينما العمر الهجري نحو ٣٧ سنة و٧ أشهر. بعد ٣٣ سنة ميلادية يصبح عمرك الهجري أكبر بسنة كاملة، وبعد ٦٦ سنة ميلادية يزيد بسنتين. هذا الفرق مهم جدًا في المعاملات الشرعية كالحج والصيام وزكاة الفطر. لتحويل أي تاريخ بين التقويمين بدقة، استخدم <a href="/hijri/">محول التاريخ الهجري الميلادي</a>.</p>

    <h2>حساب الفرق بين تاريخين ومقارنة الأعمار</h2>
    <p>إذا احتجت إلى حساب الفرق بين تاريخين محددين وليس بالضرورة تاريخ ميلادك، يمكنك استخدام <a href="/date-diff/">حاسبة الفرق بين تاريخين</a> لمعرفة عدد الأيام والشهور والسنوات بين أي تاريخين ميلاديين، وهي مفيدة لحساب مدة العقود أو فترة الخدمة في العمل أو المدة بين حدثين. كما توفر <a href="/age-diff/">حاسبة فرق العمر بين شخصين</a> إمكانية مقارنة عمرين معًا لمعرفة الفارق بالأيام والأسابيع والأشهر والسنوات، وهي مفيدة لمقارنة عمر الأخوة أو الأزواج أو لحساب الفرق العمري في عقود التأمين والمعاملات الرسمية. وبذلك تحصل على مجموعة متكاملة من الأدوات لإدارة كل ما يتعلق بالتواريخ والأعمار.</p>

    <h2>أمثلة عملية على حساب العمر</h2>
    <p>تستخدم حاسبة العمر في كثير من المواقف اليومية. فمثلًا، لمعرفة متى يبلغ الطفل سن المدرسة، يحسب الأهل عمره بالتقويم الميلادي عند بدء العام الدراسي. ولحساب سن التقاعد، يعتمد الموظفون على العمر بالتقويمين حسب جهة العمل: الجهات الحكومية في السعودية تعتمد التقويم الهجري، بينما الشركات الخاصة تعتمد الميلادي. كما تستخدم الأسر حاسبة العمر لتتبع مراحل نمو الأطفال وحساب مواعيد التطعيم الدورية. وفي العقود الرسمية كعقود العمل والتأمين، يُكتب تاريخ الميلاد بالتقويمين لتفادي أي لبس في حساب السن، خصوصًا عند التعامل مع جهات مختلفة.</p>
  </div>

  <Faq faqs={faqs} />

  <RelatedTools slugs={tool.related} />
</ToolLayout>

<script>
  import { computeAge } from '../../lib/age.js';
  import { MIN_GREGORIAN_YEAR, MAX_GREGORIAN_YEAR } from '../../lib/hijri.js';
  import { todayUtc, parseISODate, toISODate } from '../../lib/date-utils.js';

  const $ = (id) => document.getElementById(id);
  const offsets = { sa: 0, ae: 0, qa: 0, kw: 0, bh: 0, om: 0 };

  $('asof').value = toISODate(todayUtc());

  const showErr = (msg) => { const e = $('err'); e.textContent = msg; e.classList.remove('hidden'); $('result').classList.add('hidden'); };

  function run() {
    const birth = parseISODate($('birth').value);
    const asof = parseISODate($('asof').value) || todayUtc();
    const err = $('err'); const res = $('result');
    if (!birth) { showErr('يرجى إدخال تاريخ الميلاد.'); return; }
    // 友好范围提示：超出乌姆库拉历支持区间时给阿语说明（而非底层中文报错）
    if (birth.getUTCFullYear() < MIN_GREGORIAN_YEAR || asof.getUTCFullYear() > MAX_GREGORIAN_YEAR) {
      showErr(`يدعم الحساب الهجري سنوات الميلاد من ${MIN_GREGORIAN_YEAR} إلى ${MAX_GREGORIAN_YEAR} ميلادية فقط.`);
      return;
    }
    if (asof.getTime() < birth.getTime()) { showErr('تاريخ «حتى» لا يمكن أن يسبق تاريخ الميلاد.'); return; }
    try {
      const a = computeAge(birth, asof, offsets[$('country').value] ?? 0);
      $('g-years').textContent = a.gregorian.years;
      $('g-months').textContent = a.gregorian.months;
      $('g-days').textContent = a.gregorian.days;
      $('h-years').textContent = a.hijri.years;
      $('h-months').textContent = a.hijri.months;
      $('h-days').textContent = a.hijri.days;
      $('total-months').textContent = a.totalMonths.toLocaleString('en-US');
      $('total-weeks').textContent = a.totalWeeks.toLocaleString('en-US');
      $('total-days').textContent = a.totalDays.toLocaleString('en-US');
      $('total-hours').textContent = a.totalHours.toLocaleString('en-US');
      $('total-minutes').textContent = a.totalMinutes.toLocaleString('en-US');
      $('weekday').textContent = a.birthWeekday;
      $('next-greg').textContent = a.nextGregorianBirthday.daysUntil;
      $('next-hijri').textContent = a.nextHijriBirthday.daysUntil;
      err.classList.add('hidden'); res.classList.remove('hidden');
    } catch (e) {
      showErr('تعذّر الحساب، تأكّد من صحة التواريخ المدخلة.');
    }
  }

  $('calc').addEventListener('click', run);
  $('birth').addEventListener('change', run);
  $('asof').addEventListener('change', run);
  $('country').addEventListener('change', run);
</script>
