---
import ToolLayout from '../layouts/ToolLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import { liveTools, categoryNamesAr, toolLink } from '../data/tools.js';
import { webAppJsonLd, websiteJsonLd, organizationJsonLd, graph } from '../lib/seo.js';

const title = 'أدوات وحاسبات بالتقويم الهجري والميلادي';
const description =
  'حاسبات ومحوّلات دقيقة بالعربية: التاريخ الهجري، حاسبة العمر، الفرق بين تاريخين، الحمل، النسبة المئوية، وضريبة القيمة المضافة لدول الخليج.';

const byCategory = {};
for (const t of liveTools) (byCategory[t.category] ||= []).push(t);

const jsonLd = graph(
  websiteJsonLd(),
  organizationJsonLd(),
  webAppJsonLd({ name: 'HijriTools', description, path: '/' }),
);
---
<ToolLayout title={title} description={description} path="/" jsonLd={jsonLd} wide>
  <h1>أدوات وحاسبات بالتقويم الهجري والميلادي</h1>
  <p class="tool-intro">
    مجموعة حاسبات سريعة ودقيقة بالعربية تعمل وفق تقويم أم القرى الرسمي — تحويل التواريخ،
    حساب العمر، الحمل، النسبة المئوية، وضريبة القيمة المضافة في دول الخليج. بدون تسجيل، وبدون انتظار.
  </p>

  {Object.entries(byCategory).map(([cat, items]) => (
    <section>
      <h2>{categoryNamesAr[cat] ?? cat}</h2>
      <ul class="tool-grid">
        {items.map((t) => (
          <li>
            <a href={toolLink(t)}>
              <span class="ico">{t.icon}</span>
              <span class="t">{t.shortAr}</span>
              <span class="d">{t.descAr}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <AdSlot />
</ToolLayout>
