---
import ToolLayout from '../layouts/ToolLayout.astro';
import Icon from '../components/Icon.astro';
import { liveTools, categoryNamesAr, toolLink } from '../data/tools.js';
import { categoryMeta, toolIconId } from '../data/icons.js';
import { webAppJsonLd, websiteJsonLd, organizationJsonLd, graph } from '../lib/seo.js';

const title = 'أدوات وحاسبات بالتقويم الهجري والميلادي';
const description =
  'حاسبات ومحوّلات دقيقة بالعربية: التاريخ الهجري، حاسبة العمر، الفرق بين تاريخين، الحمل، النسبة المئوية، وضريبة القيمة المضافة لدول الخليج.';

const byCategory = {};
for (const t of liveTools) (byCategory[t.category] ||= []).push(t);

const jsonLd = graph(
  websiteJsonLd(),
  organizationJsonLd(),
  webAppJsonLd({ name: 'HijriTools', description, path: '/' }),
);
---
<ToolLayout title={title} description={description} path="/" jsonLd={jsonLd} bleed>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="hero-star" aria-hidden="true">
      <svg width="92" height="92" viewBox="0 0 100 100">
        <rect x="24" y="24" width="52" height="52" rx="11" fill="none" stroke="var(--color-primary)" stroke-width="2.5"/>
        <rect x="24" y="24" width="52" height="52" rx="11" transform="rotate(45 50 50)" fill="none" stroke="var(--color-accent)" stroke-width="2.5"/>
      </svg>
    </div>
    <div class="hero-inner">
      <span class="hero-badge"><Icon id="ico-spark" size={14} filled />أدوات الخليج العربي المجانية</span>
      <h1 class="hero-h1">كل الحاسبات والأدوات التي تحتاجها في مكانٍ واحد</h1>
      <p class="hero-lead">تحويل التواريخ الهجرية، وحاسبات الصحة والمال والتعليم — مجانية بالكامل، تعمل في متصفحك دون تسجيل.</p>
      <div class="hero-cta">
        <a class="btn" href="#tools">استكشف الأدوات<Icon id="ico-chev" size={17} /></a>
        <a class="btn btn-secondary" href="/about/">تعرّف علينا</a>
      </div>
      <nav class="hero-popular" aria-label="الأكثر استخدامًا">
        <span class="hp-label">الأكثر استخدامًا:</span>
        <a href="/gender-predictor/">توقع نوع الجنين</a>
        <a href="/hijri/">تحويل التاريخ الهجري</a>
        <a href="/calendar/1448/">التقويم الهجري 1448</a>
        <a href="/age/">حاسبة العمر</a>
        <a href="/love-match/">حاسبة الحب</a>
      </nav>
    </div>
  </section>

  <!-- 工具分类 -->
  <div class="container" id="tools">
    {Object.entries(byCategory).map(([cat, items]) => (
      <section class="tool-section" id={`c-${cat}`}>
        <div class="section-head">
          <span class="section-chip"><Icon id={categoryMeta[cat]?.icon ?? 'ico-spark'} /></span>
          <div class="section-titles">
            <h2>{categoryNamesAr[cat] ?? cat}</h2>
            {categoryMeta[cat]?.sub && <span class="section-sub">{categoryMeta[cat].sub}</span>}
          </div>
          <span class="section-count" dir="ltr">{String(items.length).padStart(2, '0')}</span>
        </div>
        <ul class="tool-grid">
          {items.map((t) => (
            <li>
              <a class="tool-card" href={toolLink(t)}>
                <span class="tool-chip"><Icon id={toolIconId(t.slug)} size={22} /></span>
                <span class="tool-text">
                  <span class="t">{t.shortAr}</span>
                  <span class="d">{t.descAr}</span>
                </span>
                <Icon id="ico-chev" size={18} class="tool-chev" />
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  <!-- 最新文章 -->
  <section class="blog-section">
    <div class="container">
      <div class="section-head">
        <span class="section-chip"><svg class="icon " width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><use href="/sprite.svg#ico-book"></use></svg></span>
        <div class="section-titles">
          <h2>المدونة</h2>
          <span class="section-sub">مقالات وأدلة عن الأدوات الهجرية والصحة والمال</span>
        </div>
      </div>
      <div class="blog-preview-grid">
        <a href="/blog/hijri-converter-guide/" class="bp-card">
          <div class="bp-meta">التاريخ الهجري</div>
          <h3>تحويل التاريخ من هجري لميلادي: دليل كامل</h3>
          <p>دليل شامل لتحويل التاريخ بين الهجري والميلادي وفق تقويم أم القرى.</p>
        </a>
        <a href="/blog/zakat-calculator-guide/" class="bp-card">
          <div class="bp-meta">الزكاة والمال</div>
          <h3>دليل الزكاة: كيف تحسب زكاة مالك وذهبك؟</h3>
          <p>دليل كامل لحساب الزكاة مع أمثلة عملية ونسبة ربع العشر.</p>
        </a>
        <a href="/blog/weighted-percentage-guide/" class="bp-card">
          <div class="bp-meta">التعليم</div>
          <h3>حساب النسبة الموزونة: دليل القبول الجامعي</h3>
          <p>تعرف على طريقة حساب النسبة الموزونة للقبول في الجامعات السعودية.</p>
        </a>
      </div>
      <div class="blog-all-link"><a href="/blog/">جميع المقالات ←</a></div>
    </div>
  </section>
</ToolLayout>

<style>
  /* Hero「الأكثر استخدامًا」快捷入口：首屏直接导流到高流量工具，降低跳出。 */
  .hero-popular {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-block-start: var(--space-6);
  }
  .hero-popular .hp-label {
    font-size: var(--fs-small);
    font-weight: 700;
    color: var(--color-text-muted);
  }
  .hero-popular a {
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--color-border-input);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-primary);
    font-size: var(--fs-small);
    font-weight: 600;
    text-decoration: none;
    transition: border-color var(--duration-fast) var(--ease-out), background var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out);
  }
  .hero-popular a:hover {
    border-color: var(--color-primary);
    background: var(--color-primary-light);
    transform: translateY(-1px);
  }
</style>
