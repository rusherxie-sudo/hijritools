---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import Faq from "../../../components/Faq.astro";
import RelatedTools from '../../../components/RelatedTools.astro';
import { articleJsonLd, faqJsonLd, graph } from '../../../lib/seo.js';

const title = 'دليل مؤشر كتلة الجسم (BMI): كيف تحسبه وماذا يعني';
const description = 'دليل شامل عن مؤشر كتلة الجسم: كيف يحسب، ماذا تعني النتيجة، وكيف يختلف بين الرجال والنساء والأطفال.';
const faqs = [
  { q: 'ما هو مؤشر كتلة الجسم (BMI)؟', a: 'مؤشر كتلة الجسم هو رقم يُحسب بقسمة الوزن بالكيلوجرام على مربع الطول بالمتر. يُستخدم كمؤشر تقريبي لحالة الجسم الصحية، حيث يشير إلى ما إذا كان الوزن ضمن النطاق الطبيعي أو أقل أو أكثر منه.' },
  { q: 'كيف أحسب مؤشر كتلة الجسم؟', a: 'معادلة حساب BMI هي: الوزن (كجم) ÷ (الطول بالمتر)². مثال: شخص وزنه ٧٠ كجم وطوله ١.٧٥ متر يكون BMI = ٧٠ ÷ (١.٧٥)² = ٢٢.٨٦. يمكنك استخدام حاسبة BMI مباشرة على هجري تولز.' },
  { q: 'ما هي تصنيفات مؤشر كتلة الجسم؟', a: 'تصنيفات BMI حسب منظمة الصحة العالمية: أقل من ١٨.٥ = ناقص وزن، ١٨.٥–٢٤.٩ = وزن طبيعي، ٢٥–٢٩.٩ = زيادة وزن، ٣٠ فأكثر = سمنة. هذه التصنيفات تنطبق على البالغين من سن ٢٠ فما فوق.' },
  { q: 'هل مؤشر كتلة الجسم دقيق للجميع؟', a: 'لا، BMI له قيود مهمة. لا يميز بين كتلة العضلات والدهون في الجسم، поэтому спортсмен с большой мышечной массой может иметь высокий BMI при низком содержании жира. كما يختلف التفسير حسب العمر والعرق والجنس.' },
  { q: 'ما هي البدائل المتاحة لقياس صحة الوزن؟', a: 'من البدائل المفيدة: محيط الخصر (أكثر دقة من BMI للإشارة إلى دهون البطن)، نسبة الخصر إلى الورك، نسبة الدهون في الجسم، ومحيط الرقبة. هذه المقاييس تعطي صورة أوضح عن المخاطر الصحية الفعلية.' },
];

const jsonLd = graph(
  articleJsonLd({ name: title, description, path: '/blog/bmi-guide/', datePublished: '2026-06-30', authorName: 'HijriTools' }),
  faqJsonLd(faqs),
);
---
<ToolLayout title={title} description={description} path="/blog/bmi-guide/" jsonLd={jsonLd} ogType="article" breadcrumb={[{name:'الرئيسية',path:'/'},{name:'المدونة',path:'/blog/'},{name:'دليل BMI',path:'/blog/bmi-guide/'}]}>
  <article class="blog-article">
    <div class="ba-meta">
      <span class="ba-cat">الصحة</span>
      <span>2026-06-30</span>
      <span>٦ دقائق قراءة</span>
    </div>
    <h1>{title}</h1>

    <p class="ba-intro">مؤشر كتلة الجسم (BMI) هو أحد أشهر المقاييس المستخدمة عالميًا لتقييم العلاقة بين الوزن والطول. على الرغم من بساطته، إلا أنه يبقى أداة مهمة لفهم الحالة الصحية العامة. في هذا الدليل الشامل، نشرح كل ما تحتاج معرفته عن BMI: من طريقة حسابه إلى تصنيفاته وقيوده، مع أدوات عملية تساعدك على تقييم وزنك بدقة.</p>

    <h2>ما هو مؤشر كتلة الجسم (BMI)؟</h2>
    <p>مؤشر كتلة الجسم (Body Mass Index) هو مقياس يقارن الوزن بالطول، ويُستخدم كمؤشر تقريبي على ما إذا كان الشخص يتمتع بوزن صحي مقارنة لطوله. تم تطوير هذا المقياس في القرن التاسع عشر على يد العالم البلجيكي أدولف كيتليه، وأصبح اليوم المعيار الأكثر استخدامًا من قبل المنظمات الصحية حول العالم.</p>
    <p>الهدف من BMI ليس قياس نسبة الدهون في الجسم مباشرة، بل إعطاء فكرة عامة تساعد الأطباء والمختصين في تحديد ما إذا كان الشخص معرضًا لمخاطر صحية مرتبطة بالوزن. مع ذلك، يجب فهم أن BMI وحده لا يكفي لتقييم الصحة بشكل كامل، إذ يجب مراعاة عوامل أخرى مثل العمر والجنس ومستوى النشاط البدني.</p>

    <h2>معادلة حساب مؤشر كتلة الجسم</h2>
    <p>حساب BMI بسيط جدًا ويتبع المعادلة التالية:</p>
    <p class="formula"><strong>BMI = الوزن (كجم) ÷ (الطول بالمتر)²</strong></p>
    <p>لنفهم ذلك بمثال عملي:</p>
    <ul>
      <li><strong>البيانات:</strong> شخص وزنه ٧٥ كجم وطوله ١.٨٠ متر</li>
      <li><strong>الخطوة ١:</strong> نحسب مربع الطول: ١.٨٠ × ١.٨٠ = ٣.٢٤</li>
      <li><strong>الخطوة ٢:</strong> نقسم الوزن على مربع الطول: ٧٥ ÷ ٣.٢٤ = ٢٣.١٥</li>
      <li><strong>النتيجة:</strong> BMI = ٢٣.١٥ وهو ضمن النطاق الطبيعي</li>
    </ul>
    <p>بدلاً من الحساب اليدوي، يمكنك استخدام <a href="/bmi/">حاسبة BMI</a> مباشرة على هجري تولز للحصول على النتيجة فورًا مع التصنيف المناسب لعمرك وجنسك.</p>

    <h2>تصنيفات مؤشر كتلة الجسم</h2>
    <p>حسب تصنيفات منظمة الصحة العالمية للبالغين (٢٠ سنة فأكثر)، ينقسم BMI إلى الفئات التالية:</p>
    <ul>
      <li><strong>أقل من ١٨.٥:</strong> ناقص وزن — قد يحتاج إلى مراجعة غذائية لزيادة الوزن بطريقة صحية</li>
      <li><strong>من ١٨.٥ إلى ٢٤.٩:</strong> وزن طبيعي — يشير إلى توازن جيد بين الوزن والطول</li>
      <li><strong>من ٢٥ إلى ٢٩.٩:</strong> زيادة في الوزن — يُنصح بتعديل نمط الحياة</li>
      <li><strong>من ٣٠ إلى ٣٤.٩:</strong> سمنة درجة أولى — повышенный риск заболеваний</li>
      <li><strong>من ٣٥ إلى ٣٩.٩:</strong> سمنة درجة ثانية — риск заболеваний выше</li>
      <li><strong>٤٠ فأكثر:</strong> سمنة درجة ثالثة — требуется медицинская помощь</li>
    </ul>
    <p>تجدر الإشارة إلى أن هذه التصنيفات عالمية وقد تختلف قليلاً حسب العرق والبلد. على سبيل المثال، بعض الدراسات تشير إلى أن المخاطر الصحية تبدأ عند BMI أقل لدى الأشخاص من أصل آسيوي مقارنة بالأوروبيين.</p>

    <h2>قيود مؤشر كتلة الجسم</h2>
    <p>رغم شيوعه واستخدامه على نطاق واسع، إلا أن BMI لديه عدة قيود يجب معرفتها:</p>

    <h3>لا يميّز بين العضلات والدهون</h3>
    <p>أهم قيود BMI أنه لا يستطيع التمييز بين كتلة العضلات وكتلة الدهون. لذلك قد يظهر BMI مرتفعًا لدى الرياضيين الذين يمتلكون عضلات كثيفة، رغم أن نسبة الدهون في أجسامهم منخفضة جدًا. في المقابل، قد يكون BMI طبيعيًا لشخص مسن يفقد عضلاته تدريجيًا رغم ارتفاع نسبة الدهون.</p>

    <h3>لا يختلف حسب العمر بشكل كافٍ</h3>
    <p>مع التقدم في العمر، تتغير طبيعة الجسم وتوزيع الدهون. بعض المنظمات الصحية توصي بنطاقات BMI مختلفة لكبار السن، إذ أن القليل من الوزن الإضافي قد يكون的保护يًا في الشيخوخة.</p>

    <h3>يختلف حسب العرق والجنس</h3>
    <p>التصنيفات الحالية مبنية أساسًا على دراسات على أشخاص من أصل أوروبي. أثبتت الدراسات أن نسب الدهون في الجسم تختلف بين الأعراق عند نفس BMI. كما أن النساء عمومًا يميلون لامتلاك نسبة دهون أعلى من الرجال عند نفس BMI.</p>

    <h3>لا يقيس توزيع الدهون</h3>
    <p>الدراسات تثبت أن الدهون المتراكمة حول البطن (الدهون الحشوية) أكثر خطورة من الدهون المتراكمة في مناطق أخرى مثل الفخذين. BMI لا يعطيك أي معلومات عن مكان توزيع الدهون في الجسم.</p>

    <h2>بدائل أفضل لقياس صحة الوزن</h2>
    <p>نظرًا لقيود BMI، يُنصح باستخدام مقاييس إضافية للحصول على صورة أدق:</p>

    <h3>محيط الخصر</h3>
    <p>محيط الخصر هو مؤشر بسيط وفعال لقياس دهون البطن. حسب منظمة الصحة العالمية:</p>
    <ul>
      <li><strong>للرجال:</strong> أكثر من ١٠٢ سم = повышенный риск</li>
      <li><strong>للنساء:</strong> أكثر من ٨٨ سم = повышенный риск</li>
    </ul>

    <h3>نسبة الخصر إلى الورك</h3>
    <p>تحسب بقسمة محيط الخصر على محيط الورك. تعطي فكرة عن توزيع الدهون في الجسم. النسبة الأعلى من ١.٠ للرجال أو ٠.٨٥ للنساء تشير إلى تراكم الدهون حول البطن.</p>

    <h3>نسبة الدهون في الجسم</h3>
    <p>تقيس النسبة الفعلية للدهون في الجسم. يمكن قياسها بأجهزة خاصة في العيادات أو باستخدام أجهزة تحليل المعاوقة الكهربائية الحيوية (BIA). النسب الصحية:</p>
    <ul>
      <li><strong>للرجال:</strong> ١٠–٢٠٪</li>
      <li><strong>للنساء:</strong> ١٨–٢٨٪</li>
    </ul>

    <h2>أدوات مساعدة لتقييم وزنك</h2>
    <p>لا يكفي معرفة BMI فقط، بل من المفيد استخدام مجموعة أدوات للحصول على صورة شاملة:</p>
    <ul>
      <li><a href="/bmi/"><strong>حاسبة BMI</strong></a> — احسب مؤشر كتلة الجسم الآن</li>
      <li><a href="/ideal-weight/"><strong>حاسبة الوزن المثالي</strong></a> — اعرف وزنك المثالي بناءً على طولك وعمرك</li>
      <li><a href="/calories/"><strong>حاسبة السعرات الحرارية</strong></a> — حدد احتياجاتك اليومية من الطاقة</li>
    </ul>

    <div class="cta-box">
      <p>احسب مؤشر كتلة جسمك الآن</p>
      <a href="/bmi/" class="btn">استخدم حاسبة BMI</a>
    </div>

    <Faq faqs={faqs} />

    <RelatedTools slugs={['bmi', 'ideal-weight', 'calories']} />
  </article>
</ToolLayout>

