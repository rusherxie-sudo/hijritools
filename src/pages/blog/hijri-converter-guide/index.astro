---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import Faq from "../../../components/Faq.astro";
import RelatedTools from '../../../components/RelatedTools.astro';
import { getTool } from '../../../data/tools.js';
import { articleJsonLd, faqJsonLd, graph } from '../../../lib/seo.js';

const tool = getTool('hijri');
const title = 'تحويل التاريخ من هجري لميلادي: دليل كامل للتحويل بين التقويمين';
const description = 'دليل شامل لتحويل التاريخ من الهجري إلى الميلادي والعكس. تعرف على طريقة التحويل وفق تقويم أم القرى، الفرق بين التقويمين، ولماذا يختلف التاريخ بين الدول العربية.';

const faqs = [
  { q: 'كيف أحول التاريخ من هجري إلى ميلادي؟', a: 'يمكنك تحويل التاريخ من هجري إلى ميلادي بسهولة باستخدام حاسبة تحويل التاريخ. أدخل السنة الهجرية والشهر واليوم، وتحصل على التاريخ الميلادي المقابل بدقة وفق تقويم أم القرى.' },
  { q: 'كم يساوي عام 1448 هجري بالميلادي؟', a: 'العام الهجري 1448 هـ يوافق تقريبًا عام 2026-2027 ميلادي. يبدأ 1448 هـ في 25 يونيو 2026 م حسب تقويم أم القرى.' },
  { q: 'هل تختلف نتيجة التحويل من دولة لأخرى؟', a: 'نعم، قد تختلف نتيجة التحويل بين الدول بيوم واحد أحيانًا، لأن بداية الشهر الهجري ترتبط برؤية الهلال التي تختلف من بلد لآخر. لذلك توفر حاسبة هجريTools خيار تعديل الدولة لمطابقة التقويم المحلي.' },
  { q: 'ما هو تقويم أم القرى؟', a: 'هو التقويم الهجري الرسمي المعتمد في المملكة العربية السعودية ومعظم دول الخليج. يُحسب فلكيًا مسبقًا لسنوات قادمة، ويعتمد في معظم التطبيقات الرسمية والتقويمات الإلكترونية.' },
];

const jsonLd = graph(
  articleJsonLd({ name: title, description, path: '/blog/hijri-converter-guide/', datePublished: '2026-06-27', authorName: 'HijriTools' }),
  faqJsonLd(faqs),
);
---
<ToolLayout title={title} description={description} path="/blog/hijri-converter-guide/" jsonLd={jsonLd} ogType="article" breadcrumb={[{name:'الرئيسية',path:'/'},{name:'المدونة',path:'/blog/'},{name:'تحويل التاريخ من هجري لميلادي',path:'/blog/hijri-converter-guide/'}]}>
  <article class="blog-article">
    <div class="ba-meta">
      <span class="ba-cat">التاريخ الهجري</span>
      <span>2026-06-27</span>
      <span>٥ دقائق قراءة</span>
    </div>
    <h1>{title}</h1>

    <p class="ba-intro">تحويل التاريخ من الهجري إلى الميلادي من أكثر العمليات التي يحتاجها المسلمون يوميًا، خاصة في دول الخليج العربي حيث يُستخدم التقويم الهجري إلى جانب الميلادي في المعاملات الرسمية والحياة اليومية. في هذا الدليل الشامل، نقدم لك كل ما تحتاج معرفته عن تحويل التواريخ بين التقويمين.</p>

    <h2>ما هو الفرق بين التقويم الهجري والميلادي؟</h2>
    <p>التقويم الهجري (أو الإسلامي) يعتمد على دورة القمر حول الأرض، حيث تستغرق كل دورة قمرية حوالي ٢٩.٥٣ يومًا. لذلك فإن السنة الهجرية تتكون من ٣٥٤ أو ٣٥٥ يومًا، أي أقصر بحوالي ١٠–١١ يومًا من السنة الميلادية التي تعتمد على دورة الشمس حول الأرض (٣٦٥ يومًا).</p>
    <p>هذا الفرق يعني أن <strong>كل ٣٣ سنة هجرية تقابل حوالي ٣٢ سنة ميلادية</strong>. ونتيجة لذلك، تتنقل الأشهر الهجرية عبر الفصول الميلادية على مدار السنوات. فمثلًا، شهر رمضان يتقدم بحوالي ١٠ أيام كل عام ميلادي.</p>

    <h2>طريقة تحويل التاريخ من هجري إلى ميلادي</h2>
    <p>أسهل طريقة لتحويل التاريخ من هجري إلى ميلادي هي استخدام أداة تحويل التاريخ الإلكترونية. كل ما عليك فعله هو:</p>
    <ol>
      <li><strong>اختيار اتجاه التحويل:</strong> اختر «هجري إلى ميلادي»</li>
      <li><strong>إدخال السنة الهجرية:</strong> أدخل السنة مثل 1448</li>
      <li><strong>اختيار الشهر واليوم:</strong> حدد الشهر واليوم الهجري</li>
      <li><strong>اختيار الدولة:</strong> لضبط ما يناسب رؤية الهلال في بلدك</li>
    </ol>
    <p>بعدها تحصل على التاريخ الميلادي المقابل بدقة. <a href="/hijri/">جرب حاسبة تحويل التاريخ الآن</a>.</p>

    <h2>تحويل التاريخ من ميلادي إلى هجري</h2>
    <p>لتحويل التاريخ من ميلادي إلى هجري، العملية معاكسة ولكنها بنفس السهولة. أدخل التاريخ الميلادي (اليوم، الشهر، السنة) لتحصل على التاريخ الهجري الموافق. هذا مفيد لـ:</p>
    <ul>
      <li>معرفة تاريخ ميلادك بالهجري</li>
      <li>معرفة تاريخ مناسبة بالهجري بناءً على تاريخ ميلادي محدد</li>
      <li>حساب موعد رمضان والأعياد بالهجري</li>
    </ul>

    <h2>تقويم أم القرى</h2>
    <p><strong>تقويم أم القرى</strong> هو التقويم الهجري الرسمي المعتمد في المملكة العربية السعودية. يُحسب فلكيًا بناءً على معايير دقيقة لولادة الهلال، ويُستخدم في تحديد بدايات الأشهر الهجرية والمناسبات الإسلامية في السعودية ومعظم دول الخليج.</p>
    <p>مزايا تقويم أم القرى:</p>
    <ul>
      <li>معتمد رسميًا من الجهات الحكومية السعودية</li>
      <li>مُحتسب لسنوات قادمة مسبقًا (حتى 1500 هـ)</li>
      <li>دقيق فلكيًا ضمن معايير محددة لرؤية الهلال</li>
      <li>مستخدم في أنظمة التشغيل والتطبيقات حول العالم</li>
    </ul>
    <p>يرجى ملاحظة أن الدول الأخرى قد تختلف عن تقويم أم القرى بيوم واحد أحيانًا، حسب رؤية الهلال المحلية. توفر <a href="/hijri/">حاسبة هجريTools</a> خيار تعديل الدولة لمراعاة هذه الاختلافات.</p>

    <h2>لماذا يختلف التاريخ الهجري بين الدول؟</h2>
    <p>سبب الاختلاف يعود إلى <strong>رؤية الهلال</strong>. بداية الشهر الهجري تحدد برؤية القمر الجديد بعد غروب الشمس. إذا رؤي الهلال في بلد ولم يُرَ في بلد آخر، فقد يختلف أول الشهر بين البلدين. هذا طبيعي ومألوف في العالم الإسلامي.</p>
    <p>على سبيل المثال، غالبًا ما تعلن سلطنة عُمان بداية الشهر قبل أو بعد السعودية بيوم. لذلك عند تحويل التاريخ، من المهم مراعاة الدولة التي تتبعها.</p>

    <h2>الأشهر الهجرية بالترتيب</h2>
    <ol class="month-list">
      <li><strong>محرم</strong> — شهر حرام</li>
      <li><strong>صفر</strong></li>
      <li><strong>ربيع الأول</strong> — شهر المولد النبوي</li>
      <li><strong>ربيع الآخر</strong></li>
      <li><strong>جمادى الأولى</strong></li>
      <li><strong>جمادى الآخرة</strong></li>
      <li><strong>رجب</strong> — شهر حرام</li>
      <li><strong>شعبان</strong></li>
      <li><strong>رمضان</strong> — شهر الصيام</li>
      <li><strong>شوال</strong> — شهر عيد الفطر</li>
      <li><strong>ذو القعدة</strong> — شهر حرام</li>
      <li><strong>ذو الحجة</strong> — شهر حرام، فيه عيد الأضحى والحج</li>
    </ol>

    <h2>كيف تستخدم حاسبة تحويل التاريخ من هجري لميلادي؟</h2>
    <p>استخدام حاسبة تحويل التاريخ من هجري لميلادي سهل جدًا:</p>
    <ol>
      <li>ادخل إلى <a href="/hijri/">صفحة تحويل التاريخ</a></li>
      <li>اختر اتجاه التحويل (ميلادي→هجري أو هجري→ميلادي)</li>
      <li>أدخل التاريخ في الحقل المناسب</li>
      <li>اختر دولتك لضبط رؤية الهلال</li>
      <li>يظهر التاريخ المحول فوريًا مع اليوم والمناسبات</li>
    </ol>
    <p>تدعم الحاسبة تحويل التواريخ <strong>بشكل فوري</strong> — لن تحتاج إلى الضغط على أي زر، فقط أدخل التاريخ يظهر الناتج مباشرة.</p>

    <div class="cta-box">
      <p>حوّل التاريخ الآن بسهولة ودقة</p>
      <a href="/hijri/" class="btn">تحويل التاريخ من هجري لميلادي</a>
    </div>

    <Faq faqs={faqs} />

    <RelatedTools slugs={['age', 'date-diff', 'calendar']} />
  </article>
</ToolLayout>

