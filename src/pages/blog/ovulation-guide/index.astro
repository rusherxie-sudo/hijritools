---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import Faq from "../../../components/Faq.astro";
import RelatedTools from '../../../components/RelatedTools.astro';
import { articleJsonLd, faqJsonLd, graph } from '../../../lib/seo.js';
const title = 'دليل التبويض: كيفية حساب أيام الخصوبة';
const description = 'دليل شامل عن التبويض وأيام الخصوبة. تعرفي على كيفية حساب يوم التبويض، فترة الخصوبة، علامات التبويض، والفرق بين التبويض بالهجري والميلادي.';
const faqs = [
  { q: 'ما هي علامات التبويض؟', a: 'أبرز علامات التبويض: تغير الإفرازات المهبلية لتصبح شفافة ومطاطة كزلال البيض، ارتفاع طفيف في درجة حرارة الجسم الأساسية، ألم خفيف في أحد جانبي البطن، زيادة الرغبة الجنسية، وانتفاخ طفيف في الثديين.' },
  { q: 'هل يمكن حساب التبويض بالتقويم الهجري؟', a: 'نعم، يمكن حساب التبويض بالتقويم الهجري بنفس الطريقة المتبعة في التقويم الميلادي. <a href="/ovulation/">حاسبة التبويض</a> تدعم كلا التقويمين — أدخلي تاريخ آخر دورة بالهجري أو الميلادي وستحصلين على أيام التبويض وفترة الخصوبة.' },
  { q: 'كم يومًا تستمر فترة الخصوبة؟', a: 'فترة الخصوبة تستمر حوالي ٦ أيام: ٥ أيام قبل يوم التبويض + يوم التبويض نفسه. البويضة تعيش ١٢-٢٤ ساعة فقط بعد خروجها، بينما الحيوانات المنوية تعيش حتى ٥ أيام داخل الجهاز التناسلي الأنثوي.' },
];
const jsonLd = graph(articleJsonLd({ name: title, description, path: '/blog/ovulation-guide/', datePublished: '2026-06-28', authorName: 'HijriTools' }), faqJsonLd(faqs));
---
<ToolLayout title={title} description={description} path="/blog/ovulation-guide/" jsonLd={jsonLd} ogType="article" breadcrumb={[{name:'الرئيسية',path:'/'},{name:'المدونة',path:'/blog/'},{name:'دليل التبويض',path:'/blog/ovulation-guide/'}]}>
  <article class="blog-article">
    <div class="ba-meta"><span class="ba-cat">الصحة والحمل</span><span>2026-06-28</span><span>٧ دقائق قراءة</span></div>
    <h1>{title}</h1>
    <p class="ba-intro">معرفة أيام التبويض هي المفتاح للتخطيط للحمل أو تجنبه. سواء كنتِ تحاولين الإنجاب أو ترغبين في فهم دورتك الشهرية بشكل أفضل، هذا الدليل يشرح لكِ كل ما تحتاجين معرفته عن التبويض وفترة الخصوبة بالتفصيل.</p>

    <h2>ما هو التبويض؟</h2>
    <p>التبويض هو عملية خروج بويضة ناضجة من المبيض إلى قناة فالوب، وتحدث عادة مرة واحدة في كل دورة شهرية، حوالي اليوم ١٤ من الدورة (إذا كانت دورتك ٢٨ يومًا). بعد خروجها، تعيش البويضة لمدة ١٢-٢٤ ساعة فقط — وهذا هو الوقت المتاح للتخصيب.</p>

    <h2>علامات التبويض</h2>
    <p>يمكنكِ التعرف على أيام التبويض من خلال مراقبة جسمك. إليكِ أهم العلامات:</p>
    <ul>
      <li><strong>تغير الإفرازات المهبلية:</strong> تصبح شفافة ومطاطة وزَلِقة، تشبه زلال البيض النيء. هذه الإفرازات تساعد الحيوانات المنوية على البقاء حية والوصول إلى البويضة.</li>
      <li><strong>ارتفاع درجة حرارة الجسم الأساسية:</strong> ترتفع درجة حرارة الجسم بمقدار ٠.٣-٠.٥ درجة مئوية بعد التبويض وتستمر حتى الدورة التالية. قياس الحرارة يوميًا صباحًا قبل النهوض يساعد في تتبع نمط التبويض.</li>
      <li><strong>ألم التبويض (Mittelschmerz):</strong> ألم خفيف أو مغص في أحد جانبي أسفل البطن، يستمر من بضع دقائق إلى عدة ساعات.</li>
      <li><strong>زيادة الرغبة الجنسية:</strong> تلاحظ كثير من النساء زيادة طبيعية في الرغبة الجنسية قرب وقت التبويض.</li>
    </ul>

    <h2>كيف تحسبين أيام التبويض؟</h2>
    <p>لحساب يوم التبويض المتوقع:</p>
    <ul>
      <li>حددي تاريخ أول يوم من آخر دورة شهرية لكِ.</li>
      <li>احسبي طول دورتك الشهرية (عدد الأيام بين أول يوم في دورتين متتاليتين).</li>
      <li>يوم التبويض = تاريخ آخر دورة + (طول الدورة - ١٤) يومًا.</li>
      <li>فترة الخصوبة = ٥ أيام قبل يوم التبويض + يوم التبويض نفسه.</li>
    </ul>
    <p>مثال: إذا كانت دورتك ٢٨ يومًا وآخر دورة بدأت في ١ يناير، فيوم التبويض المتوقع هو ١٥ يناير، وفترة الخصوبة من ١٠-١٥ يناير.</p>

    <h2>التبويض بالتقويم الهجري والميلادي</h2>
    <p>لا فرق في طريقة حساب التبويض بين التقويم الهجري والميلادي — الدورة الشهرية محكومة بفسيولوجيا الجسم وليس بالتقويم. الفرق الوحيد هو في تدوين التواريخ:</p>
    <ul>
      <li>إذا كنتِ تسجلين مواعيد دورتكِ بالتقويم الهجري، أدخلي تاريخ آخر دورة بالهجري في <a href="/ovulation/">حاسبة التبويض</a>.</li>
      <li>إذا كنتِ تستخدمين الميلادي، أدخليه بالميلادي.</li>
      <li>الحاسبة تظهر لكِ النتائج بالتقويمين معًا لتتمكني من التخطيط بسهولة.</li>
    </ul>

    <h2>العوامل المؤثرة في التبويض</h2>
    <p>عدة عوامل قد تؤثر على انتظام التبويض:</p>
    <ul>
      <li><strong>التوتر والضغط النفسي:</strong> قد يؤخر التبويض أو يمنعه تمامًا في بعض الدورات.</li>
      <li><strong>تغيرات الوزن:</strong> النحافة الشديدة أو السمنة تؤثر على التوازن الهرموني.</li>
      <li><strong>الرياضة المفرطة:</strong> التمارين الشاقة جدًا قد تسبب انقطاع التبويض.</li>
      <li><strong>العمر:</strong> جودة التبويض وانتظامه تقل مع التقدم في العمر، خاصة بعد سن ٣٥.</li>
      <li><strong>تكيس المبايض:</strong> من أكثر أسباب عدم انتظام التبويض شيوعًا.</li>
    </ul>

    <h2>متى يجب استشارة الطبيب؟</h2>
    <p>استشيري طبيبكِ إذا كنتِ:</p>
    <ul>
      <li>تحاولين الحمل لأكثر من سنة (أو ٦ أشهر إذا كان عمركِ فوق ٣٥) دون نجاح.</li>
      <li>دورتكِ غير منتظمة جدًا (أقل من ٢١ يومًا أو أكثر من ٣٥ يومًا).</li>
      <li>تشكين في عدم حدوث تبويض (انقطاع الدورة لشهور).</li>
      <li>تعانين من ألم شديد أثناء الدورة أو التبويض.</li>
    </ul>

    <div class="cta-box"><p>احسبي أيام التبويض وفترة الخصوبة بدقة</p><a href="/ovulation/" class="btn">حاسبة التبويض</a></div>

    <Faq faqs={faqs} />
    <RelatedTools slugs={['pregnancy', 'period', 'gender-predictor']} />
  </article>
</ToolLayout>
