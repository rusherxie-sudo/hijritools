---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import Faq from "../../../components/Faq.astro";
import RelatedTools from '../../../components/RelatedTools.astro';
import { articleJsonLd, faqJsonLd, graph } from '../../../lib/seo.js';

const title = 'ضريبة القيمة المضافة في دول الخليج: معدلاتها واستثناءاتها';
const description = 'دليل شامل عن ضريبة القيمة المضافة في دول الخليج العربي الست: معدلات VAT في السعودية والإمارات والبحرين وعمان وقطر والكويت، والسلع المعفاة.';
const faqs = [
  { q: 'ما هي نسبة ضريبة القيمة المضافة في كل دولة خليجية؟', a: 'تختلف النسب بين دول الخليج: السعودية ١٥٪، الإمارات ٥٪، البحرين ١٠٪، عُمان ٥٪. أما قطر والكويت فلم تُطبّقا ضريبة القيمة المضافة حتى الآن. يمكن مقارنة المعدلات بسهولة عبر <a href="/vat/">حاسبة ضريبة القيمة المضافة</a>.' },
  { q: 'ما الفرق بين السلع المعفاة وسلع نسبة الصفر في ضريبة القيمة المضافة؟', a: 'السلع المعفاة (Zero-rate) تعني أن الضريبة = ٠٪ ويمكن للمكلف استرداد ضريبة المدخلات، مثل الأدوية والتصدير والنقل الدولي. أما السلع المعفاة من الضريبة (Exempt) فلا يمكن استرداد الضريبة على المدخلات، وتشمل الخدمات المالية والتأمين وتأجير العقارات السكنية.' },
  { q: 'هل يجب على المنشآت الصغيرة التسجيل في ضريبة القيمة المضافة؟', a: 'التسجيل الإلزامي يعتمد على حجم الإيرادات. في السعودية مثلًا، التسجيل إلزامي إذا تجاوزت الإيرادات السنوية ٣٧٥,٠٠٠ ريال، واختياري عند تجاوز ١٨٧,٥٠٠ ريال. الحدود تختلف من دولة لأخرى، لذا يُنصح بالتحقق من الجهات الضريبية المحلية في كل دولة.' },
  { q: 'متى سيتم تطبيق ضريبة القيمة المضافة في قطر والكويت؟', a: 'لم تُعلَن حتى الآن عن مواعيد نهائية لتطبيق ضريبة القيمة المضافة في قطر أو الكويت.' },
  { q: 'ما هي عقوبات عدم التسجيل في ضريبة القيمة المضافة؟', a: 'تختلف العقوبات من دولة لأخرى. في السعودية، تصل غرامة التأخير في التسجيل إلى ١٠,٠٠٠ ريال، وغرامة التأخير في تقديم الإقرار من ٥٪ إلى ٢٥٪ من قيمة الضريبة المستحقة. في الإمارات، يمكن أن تصل الغرامات إلى ٥٠,٠٠٠ درهم.' },
];
const jsonLd = graph(
  articleJsonLd({ name: title, description, path: '/blog/vat-gcc-guide/', datePublished: '2026-06-30', authorName: 'HijriTools' }),
  faqJsonLd(faqs),
);
---
<ToolLayout title={title} description={description} path="/blog/vat-gcc-guide/" jsonLd={jsonLd} ogType="article" breadcrumb={[{name:'الرئيسية',path:'/'},{name:'المدونة',path:'/blog/'},{name:'دليل VAT الخليج',path:'/blog/vat-gcc-guide/'}]}>
  <article class="blog-article">
    <div class="ba-meta"><span class="ba-cat">المالية والضرائب</span><span>2026-06-30</span><span>٧ دقائق قراءة</span></div>
    <h1>{title}</h1>
    <p class="ba-intro">ضريبة القيمة المضافة (VAT) هي ضريبة غير مباشرة تفرضها معظم دول مجلس التعاون الخليجي على السلع والخدمات. تختلف معدلات هذه الضريبة اختلافًا كبيرًا بين الدول الخليجية الست، كما تتباين قائمة السلع المعفاة والخدمات المعفاة. في هذا الدليل، نعرض مقارنة شاملة تغطي جميع دول الخليج لمساعدتك في فهم نظام الضريبة المضافة أينما كنت.</p>

    <h2>ما هي ضريبة القيمة المضافة؟</h2>
    <p>ضريبة القيمة المضافة هي ضريبة تُفرض على القيمة المضافة في كل مرحلة من مراحل الإنتاج والتوزيع. يتحملها المستهلك النهائي في الغالب، بينما تقوم المنشآت بتحصيلها وتوريدها للجهات الضريبية. تطبّق دول مجلس التعاون الخليجي ستة أنظمة ضريبية متفاوتة، بعضهما يعتمد على نسبة واحدة، وبعضها يعتمد على نسب متعددة حسب نوع السلعة أو الخدمة.</p>

    <h2>معدلات ضريبة القيمة المضافة في دول الخليج</h2>
    <p>يتفاوت معدل ضريبة القيمة المضافة بين الدول الخليجية الست:</p>
    <table class="vat-table">
      <thead>
        <tr><th>الدولة</th><th>المعدل</th><th>سنة التطبيق</th><th>جهة الإلزام</th></tr>
      </thead>
      <tbody>
        <tr><td>🇸🇦 السعودية</td><td class="num">١٥٪</td><td>٢٠٢٠</td><td>هيئة الزكاة والضريبة والجمارك (ZATCA)</td></tr>
        <tr><td>🇦🇪 الإمارات</td><td class="num">٥٪</td><td>٢٠١٨</td><td>الهيئة الاتحادية للضرائب (FTA)</td></tr>
        <tr><td>🇧🇭 البحرين</td><td class="num">١٠٪</td><td>٢٠٢٢</td><td>الجهاز الوطني للإيرادات (NBR)</td></tr>
        <tr><td>🇴🇲 عُمان</td><td class="num">٥٪</td><td>٢٠٢١</td><td>جهاز الضرائب العماني</td></tr>
        <tr><td>🇶🇦 قطر</td><td class="num">—</td><td>لم تُطبَّق</td><td>—</td></tr>
        <tr><td>🇰🇼 الكويت</td><td class="num">—</td><td>لم تُطبَّق</td><td>—</td></tr>
      </tbody>
    </table>
    <p>تُعدّ السعودية صاحب أعلى معدل في الخليج (١٥٪)، بينما تتقاسم الإمارات وعُمان أدنى المعدلات المطبقة (٥٪). أما البحرين فأصبحت تفرض ١٠٪ اعتبارًا من ٢٠٢٢. قطر والكويت لم تُطبّقا الضريبة حتى الآن، لكنهما أعلنا عن خطط دراستها.</p>

    <h2>السلع والخدمات المعفاة حسب الدولة</h2>
    <p>تتشارك الدول الخليجية الست قائمة الإعفاءات مع بعض الاختلافات في التفاصيل:</p>

    <h3>السلع والخدمات الخاضعة لنسبة الصفر (٠٪)</h3>
    <ul>
      <li>تصدير السلع والخدمات خارج دول الخليج.</li>
      <li>الأدوية والمعدات الطبية المعتمدة.</li>
      <li>النقل الدولي للركاب والبضائع.</li>
      <li>المعادن الاستثمارية عالية النقاوة (ذهب وفضة ونحاس).</li>
      <li>بعض التوريدات المتعلقة بالقطاع الصحي والتعليمي (بشروط).</li>
    </ul>

    <h3>السلع والخدمات المعفاة من الضريبة</h3>
    <ul>
      <li>الخدمات المالية التقليدية والإسلامية (القروض، التمويل، الحسابات).</li>
      <li>خدمات التأمين وإعادة التأمين.</li>
      <li>تأجير العقارات السكنية.</li>
      <li>الخدمات الصحية في المرافق المعتمدة.</li>
      <li>الخدمات التعليمية في المؤسسات المعتمدة.</li>
    </ul>
    <p>تطبيق هذه الإعفاءات يختلف جزئيًا بين الدول. في الإمارات مثلًا، تم توسيع قائمة الإعفاءات لتشمل أيضًا بعض المواد الغذائية الأساسية، بينما تركز البحرين في إعفاءات القطاع الصحي والتعليمي.</p>

    <h2>من يجب عليه التسجيل في نظام ضريبة القيمة المضافة؟</h2>
    <p>التسجيل في نظام الضريبة المضافة إلزامي للمنشآت التي تتجاوز إيراداتها السنوية حدًا معينًا (حد التسجيل الإلزامي)، ويختلف هذا الحد من دولة لأخرى:</p>
    <ul>
      <li><strong>السعودية:</strong> إلزامي عند تجاوز ٣٧٥,٠٠٠ ريال سنويًا، واختياري من ١٨٧,٥٠٠ ريال.</li>
      <li><strong>الإمارات:</strong> إلزامي عند تجاوز ٣٧٥,٠٠٠ درهم سنويًا.</li>
      <li><strong>البحرين:</strong> إلزامي عند تجاوز ٣٧٥,٠٠٠ دينار سنويًا.</li>
      <li><strong>عُمان:</strong> إلزامي عند تجاوز ٣٨,٠٠٠ ريال عماني سنويًا (حد أدنى مقارنة بالدول الأخرى).</li>
    </ul>
    <p>يجب على أي شركة تعمل عبر الحدود بين دول الخليج مراجعة قواعد التسجيل في كل دولة تعمل فيها، إذ قد تختلف متطلبات التوريد العابر للحدود.</p>

    <h2>عقوبات عدم التسجيل والتسجيل المتأخر</h2>
    <p>تفرض كل دولة غرامات مالية على المخالفات الضريبية. في السعودية، تصل غرامة التأخير في التسجيل إلى ١٠,٠٠٠ ريال، وغرامة التأخير في تقديم الإقرار الضريبي إلى ٥٪–٢٥٪ من الضريبة المستحقة. في الإمارات، يمكن أن تصل الغرامات إلى ٥٠,٠٠٠ درهم مع احتمال الإيقاف التجاري.</p>
    <p>لتجنب هذه الغرامات، يُنصح بالتسجيل فورًا عند تجاوز حد التسجيل الإلزامي، وتقديم الإقرارات في مواعيدها حتى لو كانت قيمة الضريبة صفرًا.</p>

    <h2>أدوات مساعدة لحساب ضريبة القيمة المضافة</h2>
    <p>لحساب ضريبة القيمة المضافة في أي دولة خليجية بسهولة، استخدم <a href="/vat/">حاسبة ضريبة القيمة المضافة</a> التي تدعم جميع الدول الست. كما يمكنك استخدام <a href="/percentage/">حاسبة النسبة المئوية</a> لإجراء حسابات إضافية على الأسعار والأرباح.</p>

    <div class="cta-box">
      <p>احسب ضريبة القيمة المضافة لأي دولة خليجية</p>
      <a href="/vat/" class="btn">استخدم حاسبة ضريبة القيمة المضافة</a>
    </div>

    <Faq faqs={faqs} />
    <RelatedTools slugs={['vat', 'percentage']} />
  </article>
</ToolLayout>
