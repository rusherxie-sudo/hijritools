---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import Faq from "../../../components/Faq.astro";
import RelatedTools from '../../../components/RelatedTools.astro';
import { articleJsonLd, faqJsonLd, graph } from '../../../lib/seo.js';
const title = 'دليل المواريث: كيف يتم توزيع التركة في الشريعة الإسلامية؟';
const description = 'دليل شامل عن علم المواريث في الإسلام. تعرف على كيفية توزيع التركة، نصيب الزوج والزوجة والأبناء والبنات والوالدين حسب أحكام الشريعة.';
const faqs = [
  { q: 'ما هو نصيب الزوجة من الميراث؟', a: 'نصيب الزوجة من تركة زوجها: الثمن (١٢.٥٪) إن كان له فرع وارث (أبناء أو بنات)، والربع (٢٥٪) إن لم يكن له فرع وارث. وإذا تعددت الزوجات اشتركن في هذا النصيب بالتساوي.' },
  { q: 'كيف يقسم الميراث بين الأبناء والبنات؟', a: 'بعد إخراج أصحاب الفروض (الزوج/الزوجة، الوالدين)، الباقي يُقسم على الأبناء والبنات تعصيبًا: للذكر مثل حظ الأنثيين. مثلًا: ابنان وبنت — لكل ابن ٢/٥ والبنت ١/٥ من الباقي.' },
  { q: 'هل يرث الأحفاد من جدهم؟', a: 'الأصل أن الأحفاد لا يرثون مع وجود أبناء المتوفى (أعمامهم) — الأقرب فالأقرب. لكن بعض الدول طبقت "الوصية الواجبة" للأحفاد الذين مات أبوهم قبل الجد، فيعطون نصيب أبيهم بحد أقصى الثلث.' },
];
const jsonLd = graph(articleJsonLd({ name: title, description, path: '/blog/meeras-guide/', datePublished: '2026-06-28', authorName: 'HijriTools' }), faqJsonLd(faqs));
---
<ToolLayout title={title} description={description} path="/blog/meeras-guide/" jsonLd={jsonLd} ogType="article" breadcrumb={[{name:'الرئيسية',path:'/'},{name:'المدونة',path:'/blog/'},{name:'دليل المواريث',path:'/blog/meeras-guide/'}]}>
  <article class="blog-article">
    <div class="ba-meta"><span class="ba-cat">المال والشريعة</span><span>2026-06-28</span><span>٧ دقائق قراءة</span></div>
    <h1>{title}</h1>
    <p class="ba-intro">علم المواريث (الفرائض) من أهم علوم الشريعة الإسلامية وأدقها. وضع الله تعالى أحكام الميراث بنفسه في سورة النساء، لضمان توزيع عادل للتركة على مستحقيها. في هذا الدليل، نقدم شرحًا مبسطًا لأساسيات توزيع التركة حسب الشريعة الإسلامية.</p>

    <h2>أهمية علم المواريث</h2>
    <p>قال النبي ﷺ: «تعلموا الفرائض وعلموها الناس فإنها نصف العلم». وقد اهتم الفقهاء المسلمون بهذا العلم لأنه يضمن:</p>
    <ul>
      <li>عدالة التوزيع: أحكام قطعية لا مجال فيها للاجتهاد الشخصي.</li>
      <li>حقوق الجميع: يشمل الزوجة والأبناء والبنات والوالدين والإخوة.</li>
      <li>حفظ المال: يمنع النزاعات العائلية ويغلق باب الخلاف.</li>
    </ul>

    <h2>أصحاب الفروض (الأنصبة المحددة)</h2>
    <p>أصحاب الفروض هم الورثة الذين حدد القرآن الكريم نصيبهم بنسبة ثابتة. أهمهم:</p>
    <ul>
      <li><strong>الزوج:</strong> النصف إن لم يكن للزوجة فرع وارث، والربع إن كان لها فرع وارث.</li>
      <li><strong>الزوجة:</strong> الربع إن لم يكن للزوج فرع وارث، والثمن إن كان له فرع وارث.</li>
      <li><strong>الأب:</strong> السدس مع وجود الفرع الوارث الذكر، وإلا فالتعصيب.</li>
      <li><strong>الأم:</strong> الثلث إن لم يكن للمتوفى فرع وارث ولا إخوة، والسدس إن كان له فرع وارث أو إخوة.</li>
      <li><strong>البنت:</strong> النصف للواحدة، والثلثان لاثنتين فأكثر. مع الابن تصبح عصبة به.</li>
    </ul>

    <h2>مثال عملي: توزيع تركة</h2>
    <p>توفي رجل وترك زوجة وأم وابن وبنتين وتركة قدرها ١٠٠,٠٠٠ ريال:</p>
    <ul>
      <li>الزوجة: الثمن (١٢,٥٠٠ ريال) — لوجود فرع وارث.</li>
      <li>الأم: السدس (١٦,٦٦٧ ريال) — لوجود فرع وارث.</li>
      <li>الباقي: ٧٠,٨٣٣ ريال يقسم على الابن والبنتين تعصيبًا.</li>
      <li>للذكر مثل حظ الأنثيين: الابن ٤ أجزاء، كل بنت جزءان → ٤ + ٢ + ٢ = ٨ أجزاء.</li>
      <li>نصيب الابن: ٤/٨ × ٧٠,٨٣٣ = ٣٥,٤١٧ ريال.</li>
      <li>نصيب كل بنت: ٢/٨ × ٧٠,٨٣٣ = ١٧,٧٠٨ ريال.</li>
    </ul>
    <p>يمكنك استخدام <a href="/meeras/">حاسبة المواريث</a> لحساب الأنصبة تلقائيًا لأي تركة.</p>

    <h2>مبادئ هامة في الميراث</h2>
    <ul>
      <li><strong>الأقرب فالأقرب:</strong> الأقرب درجة للمتوفى يحجب الأبعد. الابن يحجب ابن الابن، والأب يحجب الجد.</li>
      <li><strong>أولو الأرحام:</strong> إذا لم يوجد أصحاب فروض ولا عصبات، تنتقل التركة إلى ذوي الأرحام (الأقارب من غير الورثة الشرعيين).</li>
      <li><strong>الميراث بعد الديون والوصية:</strong> توزع التركة بعد سداد الديون وتنفيذ الوصية الشرعية (بحد أقصى الثلث لغير الوارث).</li>
      <li><strong>لا وصية لوارث:</strong> لا يجوز للمتوفى أن يوصي لوارثه بأكثر من نصيبه الشرعي إلا بموافقة باقي الورثة.</li>
    </ul>

    <h2>حالات خاصة</h2>
    <ul>
      <li><strong>الكُلالة:</strong> إذا توفي شخص وليس له أبناء ولا أب، يرثه إخوته وأخواته.</li>
      <li><strong>الخنثى:</strong> يُعطى النصيب الأقل احتياطًا أو يُنتظر حتى يتبين أمره.</li>
      <li><strong>المفقود:</strong> يُحجز نصيبه حتى يظهر أو تحكم المحكمة بوفاته.</li>
      <li><strong>الحمل:</strong> يُحجز نصيب ذكرين احتياطًا حتى تلد المرأة.</li>
    </ul>

    <h2>الحاجة للرجوع للمختصين</h2>
    <p>هذا الدليل وحاسبة المواريث أدوات تقديرية مساعدة لفهم أساسيات علم الفرائض. في حالات التركات المعقدة (تعدد الورثة، وجود وصايا، ديون معقدة)، نوصي بشدة بالرجوع إلى:</p>
    <ul>
      <li>محكمة الأحوال الشخصية في بلدك.</li>
      <li>هيئة كبار العلماء أو دار الإفتاء.</li>
      <li>محامٍ متخصص في قضايا المواريث.</li>
    </ul>

    <div class="cta-box"><p>احسب أنصبة الورثة بدقة وحسب الشريعة</p><a href="/meeras/" class="btn">حاسبة المواريث</a></div>

    <Faq faqs={faqs} />
    <RelatedTools slugs={['zakat', 'percentage', 'vat']} />
  </article>
</ToolLayout>
