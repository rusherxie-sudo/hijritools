---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import Faq from "../../../components/Faq.astro";
import RelatedTools from '../../../components/RelatedTools.astro';
import { articleJsonLd, faqJsonLd, graph } from '../../../lib/seo.js';
const title = 'ضريبة القيمة المضافة في السعودية 2026: الدليل الكامل';
const description = 'كل ما تحتاج معرفته عن ضريبة القيمة المضافة في السعودية: النسبة الحالية (15٪)، طريقة الحساب، السلع المعفاة، والتسجيل في ضريبة القيمة المضافة.';
const faqs = [
  { q: 'كم نسبة ضريبة القيمة المضافة في السعودية 2026؟', a: 'نسبة ضريبة القيمة المضافة في السعودية حاليًا ١٥٪، بعد أن تم رفعها من ٥٪ في ١ يوليو ٢٠٢٠. وتظل النسبة ١٥٪ في عام ٢٠٢٦ ولم يطرأ عليها أي تغيير حتى الآن.' },
  { q: 'كيف أحسب ضريبة القيمة المضافة؟', a: 'لحساب الضريبة: اضرب السعر الصافي × ١٥٪ (أي × ٠.١٥). مثال: سلعة سعرها الصافي ١٠٠ ريال، الضريبة = ١٥ ريال، السعر شامل الضريبة = ١١٥ ريال. ولإزالة الضريبة من السعر الشامل: اقسم السعر على ١.١٥. استخدم <a href="/vat/sa/">حاسبة ضريبة القيمة المضافة</a> لحسابها فوريًا.' },
  { q: 'ما هي السلع المعفاة من ضريبة القيمة المضافة؟', a: 'السلع المعفاة تشمل: الخدمات المالية (القروض والتمويل الإسلامي)، خدمات التأمين، الخدمات الصحية، الخدمات التعليمية، وتأجير العقارات السكنية. كما تخضع بعض السلع لنسبة الصفر (0٪) مثل تصدير السلع والأدوية والمعدات الطبية.' },
];
const jsonLd = graph(articleJsonLd({ name: title, description, path: '/blog/vat-saudi-guide/', datePublished: '2026-06-28', authorName: 'HijriTools' }), faqJsonLd(faqs));
---
<ToolLayout title={title} description={description} path="/blog/vat-saudi-guide/" jsonLd={jsonLd} ogType="article" breadcrumb={[{name:'الرئيسية',path:'/'},{name:'المدونة',path:'/blog/'},{name:'ضريبة القيمة المضافة في السعودية',path:'/blog/vat-saudi-guide/'}]}>
  <article class="blog-article">
    <div class="ba-meta"><span class="ba-cat">المال والضرائب</span><span>2026-06-28</span><span>٧ دقائق قراءة</span></div>
    <h1>{title}</h1>
    <p class="ba-intro">ضريبة القيمة المضافة (VAT) هي ضريبة غير مباشرة تُفرض على معظم السلع والخدمات في المملكة العربية السعودية. في هذا الدليل الشامل، نغطي كل ما تحتاج معرفته عن ضريبة القيمة المضافة في السعودية لعام 2026: النسبة الحالية، طريقة الحساب، السلع المعفاة، وكيفية التسجيل.</p>

    <h2>نسبة ضريبة القيمة المضافة في السعودية</h2>
    <p>النسبة الحالية لضريبة القيمة المضافة في المملكة العربية السعودية هي <strong>١٥٪</strong>. بدأت الضريبة في ١ يناير ٢٠١٨ بنسبة ٥٪، ثم رُفعت إلى ١٥٪ اعتبارًا من ١ يوليو ٢٠٢٠. في عام ٢٠٢٦، لا تزال النسبة ١٥٪ دون أي تغيير رسمي حتى الآن.</p>

    <h2>طريقة حساب ضريبة القيمة المضافة</h2>
    <p>حساب ضريبة القيمة المضافة عملية بسيطة يمكنك القيام بها بثلاث طرق:</p>
    <ul>
      <li><strong>إضافة الضريبة إلى السعر الصافي:</strong> السعر شامل الضريبة = السعر الصافي × ١.١٥</li>
      <li><strong>استخراج الضريبة من السعر الشامل:</strong> قيمة الضريبة = السعر الشامل - (السعر الشامل ÷ ١.١٥)</li>
      <li><strong>حساب قيمة الضريبة فقط:</strong> قيمة الضريبة = السعر الصافي × ٠.١٥</li>
    </ul>
    <p>مثال: سلعة سعرها الصافي ١,٠٠٠ ريال — قيمة الضريبة = ١٥٠ ريال، السعر شامل الضريبة = ١,١٥٠ ريال.</p>

    <h2>السلع والخدمات الخاضعة للضريبة</h2>
    <p>تخضع معظم السلع والخدمات لضريبة القيمة المضافة في السعودية، وتنقسم إلى فئتين رئيسيتين:</p>

    <h3>النسبة الأساسية (١٥٪)</h3>
    <ul>
      <li>المواد الغذائية والمشروبات (باستثناء بعض الأساسيات).</li>
      <li>الملابس والإلكترونيات والأثاث.</li>
      <li>السيارات وقطع الغيار.</li>
      <li>خدمات الاتصالات والإنترنت.</li>
      <li>المطاعم والمقاهي وخدمات الفنادق.</li>
      <li>الخدمات المهنية والاستشارية.</li>
    </ul>

    <h3>السلع والخدمات المعفاة</h3>
    <ul>
      <li>الخدمات المالية (القروض، التمويل الإسلامي، الحسابات البنكية).</li>
      <li>خدمات التأمين بأنواعها.</li>
      <li>الخدمات الصحية في المستشفيات الحكومية والخاصة.</li>
      <li>الخدمات التعليمية (المدارس والجامعات).</li>
      <li>تأجير العقارات السكنية.</li>
    </ul>

    <h3>نسبة الصفر (٠٪)</h3>
    <p>بعض السلع تخضع لنسبة الصفر، مما يعني أن المكلف يمكنه استرداد الضريبة على مدخلاته:</p>
    <ul>
      <li>تصدير السلع إلى خارج دول مجلس التعاون.</li>
      <li>الأدوية والمعدات الطبية المسجلة.</li>
      <li>المعادن الاستثمارية (ذهب وفضة بنقاء ٩٩٪ فأعلى).</li>
      <li>النقل الدولي للركاب والبضائع.</li>
    </ul>

    <h2>التسجيل في ضريبة القيمة المضافة</h2>
    <p>التسجيل في ضريبة القيمة المضافة إلزامي للمنشآت التي تتجاوز إيراداتها السنوية <strong>٣٧٥,٠٠٠ ريال</strong> (حد التسجيل الإلزامي). ويمكن التسجيل الاختياري للمنشآت التي تتجاوز إيراداتها <strong>١٨٧,٥٠٠ ريال</strong>.</p>
    <p>يتم التسجيل عبر بوابة <strong>هيئة الزكاة والضريبة والجمارك</strong> (ZATCA) على الرابط: zatca.gov.sa. بعد التسجيل، تحصل المنشأة على رقم ضريبي ويجب عليها:</p>
    <ul>
      <li>إصدار فواتير ضريبية متوافقة مع متطلبات الهيئة.</li>
      <li>تقديم إقرارات ضريبية دورية (شهرية أو ربع سنوية حسب الإيرادات).</li>
      <li>الاحتفاظ بسجلات محاسبية لمدة ٦ سنوات على الأقل.</li>
    </ul>

    <h2>الفرق بين ضريبة القيمة المضافة في دول الخليج</h2>
    <p>تختلف نسبة ضريبة القيمة المضافة بين دول مجلس التعاون الخليجي:</p>
    <ul>
      <li><strong>السعودية:</strong> ١٥٪</li>
      <li><strong>الإمارات:</strong> ٥٪</li>
      <li><strong>قطر:</strong> ١٠٪ (اعتبارًا من ٢٠٢٥)</li>
      <li><strong>البحرين:</strong> ١٠٪</li>
      <li><strong>عُمان:</strong> ٥٪</li>
      <li><strong>الكويت:</strong> لم تُطبق بعد (قيد الدراسة).</li>
    </ul>
    <p>يمكنك استخدام <a href="/vat/">حاسبة ضريبة القيمة المضافة</a> لحساب الضريبة لأي دولة خليجية.</p>

    <h2>الغرامات والعقوبات</h2>
    <p>تفرض هيئة الزكاة والضريبة والجمارك غرامات على المخالفات الضريبية، منها:</p>
    <ul>
      <li>غرامة التأخير في التسجيل: تصل إلى ١٠,٠٠٠ ريال.</li>
      <li>غرامة التأخير في تقديم الإقرار: ٥٪-٢٥٪ من قيمة الضريبة المستحقة.</li>
      <li>غرامة عدم إصدار فواتير ضريبية: تصل إلى ٥٠,٠٠٠ ريال.</li>
      <li>غرامة التهرب الضريبي: غرامة تعادل قيمة الضريبة المستحقة + السجن.</li>
    </ul>

    <div class="cta-box"><p>احسب ضريبة القيمة المضافة في السعودية فوريًا</p><a href="/vat/sa/" class="btn">حاسبة ضريبة القيمة المضافة — السعودية</a></div>

    <Faq faqs={faqs} />
    <RelatedTools slugs={['percentage', 'discount', 'zakat']} />
  </article>
</ToolLayout>
