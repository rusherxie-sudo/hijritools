---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import Faq from "../../../components/Faq.astro";
import RelatedTools from '../../../components/RelatedTools.astro';
import { webAppJsonLd, faqJsonLd, graph } from '../../../lib/seo.js';
const title = 'حساب النسبة الموزونة: دليل القبول الجامعي في السعودية';
const description = 'دليل شامل لحساب النسبة الموزونة للقبول في الجامعات السعودية. تعرف على كيفية حساب النسبة الموزونة والمكافئة وأوزان القدرات والثانوية والتحصيلي.';
const faqs = [
  { q: 'ما هي النسبة الموزونة؟', a: 'النسبة الموزونة هي مجموع درجاتك في الثانوية العامة واختبار القدرات والاختبار التحصيلي مضروبة في أوزان محددة حسب كل جامعة. تتفاوت الأوزان بين الجامعات والتخصصات.' },
  { q: 'كيف أحسب النسبة الموزونة؟', a: 'استخدم حاسبة النسبة الموزونة. أدخل درجاتك في الثانوية والقدرات والتحصيلي، ثم اضبط الأوزان حسب جامعتك. تحسب الحاسبة نسبتك الموزونة مباشرة.' },
  { q: 'هل تختلف النسبة الموزونة من جامعة لأخرى؟', a: 'نعم، تختلف الأوزان بين الجامعات وبين التخصصات داخل الجامعة الواحدة. أوزان كلية الطب تختلف عن أوزان كلية الهندسة مثلاً.' },
];
const jsonLd = graph(webAppJsonLd({ name: title, description, path: '/blog/weighted-percentage-guide/' }), faqJsonLd(faqs));
---
<ToolLayout title={title} description={description} path="/blog/weighted-percentage-guide/" jsonLd={jsonLd}>
  <nav class="breadcrumb"><ol><li><a href="/">الرئيسية</a></li><li><a href="/blog/">المدونة</a></li><li><span aria-current="page">النسبة الموزونة</span></li></ol></nav>
  <article class="blog-article">
    <div class="ba-meta"><span class="ba-cat">التعليم</span><span>2026-06-27</span><span>٥ دقائق قراءة</span></div>
    <h1>{title}</h1>
    <p class="ba-intro">النسبة الموزونة هي معيار القبول الأساسي في معظم الجامعات السعودية. في هذا الدليل، نشرح لك بالتفصيل كيفية حساب النسبة الموزونة والمكافئة، أوزان القدرات والثانوية والتحصيلي، وكيف تستخدم حاسبة النسبة الموزونة لمعرفة فرص قبولك الجامعي.</p>

    <h2>ما هي النسبة الموزونة؟</h2>
    <p>النسبة الموزونة هي الدرجة المركبة التي تُحتسب بناءً على:</p>
    <ul><li>درجة الثانوية العامة (نسبة مئوية)</li><li>درجة اختبار القدرات العامة</li><li>درجة الاختبار التحصيلي</li></ul>
    <p>كل جامعة تضع أوزانًا مختلفة لهذه المعايير، وقد تختلف الأوزان بين التخصصات داخل الجامعة الواحدة. <a href="/weighted/">حاسبة النسبة الموزونة</a> تسمح لك بتعديل الأوزان حسب جامعتك.</p>

    <h2>الأوزان النموذجية في الجامعات السعودية</h2>
    <p>هذه أمثلة على الأوزان الشائعة:</p>
    <ul>
      <li><strong>نموذج ١:</strong> الثانوية ٣٠٪ + القدرات ٣٠٪ + التحصيلي ٤٠٪</li>
      <li><strong>نموذج ٢:</strong> الثانوية ٣٠٪ + القدرات ٤٠٪ + التحصيلي ٣٠٪</li>
      <li><strong>نموذج ٣:</strong> الثانوية ٥٠٪ + القدرات ٥٠٪ (بعض الكليات لا تشترط التحصيلي)</li>
    </ul>

    <h2>كيف تحسب النسبة الموزونة؟</h2>
    <ol>
      <li>أدخل درجاتك في <a href="/weighted/">حاسبة النسبة الموزونة</a></li>
      <li>اضبط الأوزان حسب نسب جامعتك</li>
      <li>يمكنك إضافة معايير إضافية إذا لزم الأمر</li>
      <li>تحسب الحاسبة نسبتك الموزونة مباشرة</li>
    </ol>

    <h2>النسبة الموزونة vs النسبة المكافئة</h2>
    <p>بعض الجامعات تستخدم مصطلح «النسبة المكافئة» بدلًا من «الموزونة». الفرق غالبًا في تسمية المعايير المشمولة. كلاهما يدمج الدرجات بأوزان مختلفة — <a href="/weighted/">حاسبة النسبة الموزونة</a> تتيح لك ضبط المعايير حسب آلية جامعتك.</p>

    <h2>اختبار القدرات العامة</h2>
    <p>اختبار القدرات هو اختبار موحد يقيس القدرات العقلية للطالب. يمكنك استخدام <a href="/qdrat/">حاسبة القدرات</a> لحساب نسبتك الموزونة الخاصة باختبار القدرات.</p>

    <div class="cta-box"><p>احسب نسبتك الموزونة الآن</p><a href="/weighted/" class="btn">حاسبة النسبة الموزونة</a></div>

    <Faq faqs={faqs} />
    <RelatedTools slugs={['qdrat', 'percentage', 'age']} />
  </article>
</ToolLayout>
<style>.blog-article{max-width:720px;margin:0 auto}.ba-meta{display:flex;gap:1rem;font-size:.85rem;color:var(--color-text-muted);margin-block-end:.5rem}.ba-cat{color:var(--color-primary);font-weight:600}h1{font-size:var(--fs-h2);margin-block:.25rem 1rem}.ba-intro{font-size:1.1rem;line-height:1.8;margin-block-end:2rem}h2{margin-block:2rem .75rem;font-size:var(--fs-h3)}p,li{line-height:1.9}ul,ol{padding-inline-start:1.5rem}li{margin-block-end:.4rem}.cta-box{background:var(--color-primary-light,#eaf3ee);border:1px solid var(--color-primary);border-radius:var(--radius);padding:var(--space-6);text-align:center;margin-block:2.5rem}.cta-box p{font-size:1.1rem;font-weight:600}.cta-box .btn{font-size:1.05rem;padding:.7rem 1.5rem}</style>
