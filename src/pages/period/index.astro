---
import ToolLayout from '../../layouts/ToolLayout.astro';
import Icon from "../../components/Icon.astro";
import { toolIconId } from "../../data/icons.js";
import Faq from "../../components/Faq.astro";
import Disclaimer from '../../components/Disclaimer.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import { getTool } from '../../data/tools.js';
import { webAppJsonLd, faqJsonLd, graph } from '../../lib/seo.js';

const tool = getTool('period');
const faqs = [
  { q: 'كيف أحسب موعد دورتي الشهرية القادمة؟', a: 'أدخلي تاريخ أول يوم في آخر دورة وطول دورتك بالأيام، فتضيف الحاسبة طول الدورة إلى ذلك التاريخ لتظهر لك موعد الدورة القادمة وأيام التبويض وفترة الخصوبة.' },
  { q: 'كم يبلغ طول الدورة الشهرية الطبيعي؟', a: 'يتراوح طول الدورة الطبيعي عادةً بين ٢١ و٣٥ يومًا، ومتوسطه ٢٨ يومًا. وقد يختلف قليلًا من شهر لآخر، خصوصًا إذا كانت الدورة غير منتظمة.' },
  { q: 'هل نتيجة الحاسبة مؤكدة؟', a: 'النتيجة تقديرية تعتمد على انتظام دورتك وثبات طولها. إذا كانت دورتك غير منتظمة فقد تختلف المواعيد فعليًا، وتبقى استشارة الطبيبة هي الأدق.' },
  { q: 'ما هي أيام التبويض وكيف تُحسب؟', a: 'يوم التبويض هو اليوم الذي تخرج فيه البويضة من المبيض، ويحدث عادةً قبل ١٤ يومًا من موعد الدورة القادمة. فترة الخصوبة تمتد ٥ أيام قبل التبويض ويوم التبويض نفسه.' },
  { q: 'كيف أعرف أن دورتي غير منتظمة؟', a: 'إذا كان الفارق بين أقصر وأطول دورة لديك أكثر من ٧-٩ أيام، أو إذا كانت مدتها تتغير بشكل كبير كل شهر، فقد تكون دورتك غير منتظمة. يُنصح بمراجعة الطبيبة.' },
  { q: 'هل يمكن استخدام حاسبة الدورة لتجنب الحمل؟', a: 'لا. حاسبة الدورة أداة تقديرية ولا تصلح كوسيلة لمنع الحمل. التبويض قد يختلف من شهر لآخر. استشيري طبيبتك لاختيار الوسيلة المناسبة.' },
  { q: 'هل تختلف الدورة بالتقويم الهجري عن الميلادي؟', a: 'لا تختلف مدة الدورة أو موعدها سواء بالتقويم الهجري أو الميلادي. أداتنا تعرض المواعيد بالتقويمين لراحتك — المدة واحدة والفارق فقط في التقويم المستخدم.' },
];
const jsonLd = graph(
  webAppJsonLd({ name: tool.titleAr, description: tool.descAr, path: '/period/' }),
  faqJsonLd(faqs),
);
---
<ToolLayout title={tool.titleAr} description={tool.descAr} path="/period/" jsonLd={jsonLd}>
  <div class="tool-head">
    <span class="tool-head-chip"><Icon id={toolIconId(tool.slug)} size={28} /></span>
    <div class="tool-head-text">
      <h1>{tool.titleAr}</h1>
      <p class="tool-intro">{tool.descAr}</p>
    </div>
  </div>

  <div class="card">
    <div class="row">
      <div class="field"><label for="last">أول يوم في آخر دورة شهرية</label><input type="date" id="last" /></div>
      <div class="field" style="flex:0 1 200px"><label for="cycle">طول الدورة (يوم)</label><input type="number" id="cycle" value="28" min="20" max="45" /></div>
    </div>
    <button class="btn" id="calc">احسبي</button>
    <p class="error-text hidden" id="err"></p>
  </div>

  <div class="result hidden" id="result">
    <div style="color:var(--color-text-muted)">موعد الدورة القادمة</div>
    <div class="result-main num" id="next">-</div>
    <div class="num" id="next-hijri" style="color:var(--color-primary-dark)"></div>
    <hr class="gold-divider" />
    <div class="result-grid">
      <div class="stat"><div class="v num" id="ovu">-</div><div class="l">يوم التبويض المتوقع</div></div>
      <div class="stat"><div class="v num" id="fertile">-</div><div class="l">فترة الخصوبة العالية</div></div>
    </div>
    <hr class="gold-divider" />
    <div style="color:var(--color-text-muted);margin-block-end:.5rem">مواعيد الدورات القادمة المتوقعة</div>
    <ul class="list-reset" id="future"></ul>
  </div>

  <Disclaimer variant="health" />

  <article class="prose" style="margin-block-start:var(--space-8)">
    <h2>كيفية حساب الدورة الشهرية بالهجري والميلادي</h2>
    <p>حاسبة الدورة الشهرية تساعدك على تتبّع دورتك بدقة، سواء كنت تخططين للحمل أو ترغبين فقط في معرفة مواعيد دوراتك القادمة. كل ما تحتاجينه هو <strong>تاريخ أول يوم في آخر دورة</strong> و<strong>متوسط طول دورتك</strong> المعتاد (عادةً ٢٨ يومًا).</p>
    <p>تعرض لك الحاسبة ثلاث معلومات أساسية:</p>
    <ul>
      <li><strong>موعد الدورة القادمة</strong> بالتقويمين الهجري والميلادي.</li>
      <li><strong>يوم التبويض المتوقع</strong> — وهو اليوم الأعلى خصوبة في الشهر.</li>
      <li><strong>فترة الخصوبة</strong> — الأيام الخمسة التي تسبق التبويض مع يوم التبويض نفسه، وهي الفترة المثلى لمحاولة الحمل.</li>
    </ul>
    <p>كما تعرض الحاسبة <strong>جدولًا بمواعيد ٦ دورات قادمة</strong> متوقعة، مما يساعدك على التخطيط المسبق لأسابيع وشهور قادمة. يمكنك أيضًا استخدام <a href="/ovulation/">حاسبة التبويض</a> لمعرفة أيام الخصوبة بمزيد من التفصيل.</p>
  </article>

  <Faq faqs={faqs} />

  <RelatedTools slugs={tool.related} />
</ToolLayout>

<style>
  .list-reset { list-style: none; padding: 0; margin: 0; }
  .list-reset li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: .5rem;
    border-block-end: 1px solid var(--color-border, #eee);
  }
  .list-reset li:last-child { border-block-end: 0; }
  .list-reset .idx { color: var(--color-text-muted); }
</style>

<script>
  import { nextPeriod, ovulationDay, fertileWindow, futurePeriods } from '../../lib/period.js';
  import { formatGregorian, formatHijri, gregorianToHijri } from '../../lib/hijri.js';
  import { parseISODate } from '../../lib/date-utils.js';

  const $ = (id) => document.getElementById(id);
  const fmt = (iso) => formatGregorian(parseISODate(iso));
  const showErr = (msg) => { const e = $('err'); e.textContent = msg; e.classList.remove('hidden'); $('result').classList.add('hidden'); };

  function run() {
    const lastISO = $('last').value;
    const last = parseISODate(lastISO);
    if (!last) { showErr('يرجى إدخال تاريخ أول يوم في آخر دورة شهرية.'); return; }
    const cycle = parseInt($('cycle').value, 10);
    if (!Number.isInteger(cycle) || cycle < 20 || cycle > 45) { showErr('طول الدورة يجب أن يكون بين 20 و45 يومًا.'); return; }

    const next = nextPeriod(lastISO, cycle);
    const ovu = ovulationDay(lastISO, cycle);
    const win = fertileWindow(lastISO, cycle);

    $('next').textContent = formatGregorian(parseISODate(next));
    $('next-hijri').textContent = formatHijri(gregorianToHijri(parseISODate(next), 0));
    $('ovu').textContent = formatGregorian(parseISODate(ovu));
    $('fertile').textContent = `${fmt(win.start)} – ${fmt(win.end)}`;

    const ul = $('future');
    ul.innerHTML = '';
    futurePeriods(lastISO, cycle, 6).forEach((iso, i) => {
      const li = document.createElement('li');
      const idx = document.createElement('span');
      idx.className = 'idx num';
      idx.textContent = `${i + 1}`;
      const date = document.createElement('span');
      date.className = 'num';
      date.textContent = formatGregorian(parseISODate(iso));
      li.append(idx, date);
      ul.appendChild(li);
    });

    $('err').classList.add('hidden');
    $('result').classList.remove('hidden');
  }

  $('calc').addEventListener('click', run);
  $('last').addEventListener('change', run);
  $('cycle').addEventListener('change', run);
</script>
