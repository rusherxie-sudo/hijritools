---
import ToolLayout from '../layouts/ToolLayout.astro';
import { graph } from '../lib/seo.js';

const title = 'الشروط وإخلاء المسؤولية';
const description = 'شروط استخدام HijriTools وإخلاء المسؤولية: جميع النتائج إرشادية وليست نصيحة طبية أو قانونية أو مالية أو دينية، مع حدود المسؤولية وحقوق الملكية الفكرية.';
---
<ToolLayout title={title} description={description} path="/terms/" jsonLd={graph()}>
  <h1>الشروط وإخلاء المسؤولية</h1>
  <section class="prose">
    <p style="color:var(--color-text-muted)">آخر تحديث: يونيو 2026</p>
    <p>
      باستخدامك موقع HijriTools فإنك توافق على الشروط والأحكام التالية. في حال عدم موافقتك
      عليها، يُرجى التوقف عن استخدام الموقع.
    </p>

    <h2>طبيعة الخدمة</h2>
    <p>
      يوفّر الموقع حاسبات ومحوّلات للأغراض العامة والإرشادية فقط. نبذل جهدنا لضمان دقة الحسابات
      عبر اختبارات آلية، لكننا لا نضمن خلوّها التام من الأخطاء أو ملاءمتها لكل حالة على حدة.
    </p>

    <h2>إخلاء المسؤولية: النتائج تقديرية ولا تُغني عن المختصين</h2>
    <p>جميع النتائج إرشادية وتقديرية، ولا تُعدّ بديلًا عن استشارة المختصين:</p>
    <ul>
      <li>الأدوات الصحية (مثل مؤشر كتلة الجسم والسعرات والحمل والتبويض) لا تُغني عن استشارة الطبيب، وليست تشخيصًا أو علاجًا.</li>
      <li>الأدوات المالية والضريبية لا تُعدّ استشارة مالية أو محاسبية؛ اعتمد دائمًا على الجهات الرسمية والمختصين.</li>
      <li>التواريخ الهجرية وفق تقويم أم القرى، وقد تختلف بدايات الأشهر والمناسبات فعليًا حسب إعلان الجهات الرسمية المختصة في كل دولة بناءً على رؤية الهلال.</li>
      <li>نتائج الأدوات ليست فتوى أو رأيًا شرعيًا.</li>
    </ul>

    <h2>حدود المسؤولية</h2>
    <p>
      لا يتحمّل HijriTools أو القائمون عليه أي مسؤولية عن أضرار مباشرة أو غير مباشرة أو عرضية
      تنشأ عن استخدام الموقع أو الاعتماد على نتائجه. الاستخدام يقع على مسؤوليتك الشخصية.
    </p>

    <h2>الملكية الفكرية</h2>
    <p>
      جميع محتويات الموقع من تصميم ونصوص وأدوات مملوكة لـ HijriTools ما لم يُذكر خلاف ذلك،
      ولا يجوز إعادة نشرها لأغراض تجارية دون إذن مسبق.
    </p>

    <h2>التعديلات</h2>
    <p>قد نحدّث هذه الشروط من وقت لآخر، ويُعدّ استمرارك في استخدام الموقع موافقةً على النسخة المحدّثة.</p>

    <h2>التواصل</h2>
    <p>لأي استفسار حول هذه الشروط، راسلنا على <a href="mailto:contact@hijritools.com">contact@hijritools.com</a>.</p>
  </section>
</ToolLayout>
