---
import ToolLayout from '../../layouts/ToolLayout.astro';
import Icon from "../../components/Icon.astro";
import { toolIconId } from "../../data/icons.js";
import Faq from "../../components/Faq.astro";
import Disclaimer from '../../components/Disclaimer.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import { getTool } from '../../data/tools.js';
import { webAppJsonLd, faqJsonLd, graph } from '../../lib/seo.js';

const tool = getTool('weighted');

// 沙特常见三项预设（权重可由用户修改，因大学不同而异）。
const rows = [
  { id: 'a', label: 'الثانوية العامة', score: 95, weight: 30 },
  { id: 'b', label: 'اختبار القدرات', score: 85, weight: 40 },
  { id: 'c', label: 'الاختبار التحصيلي', score: 88, weight: 30 },
];

const faqs = [
  {
    q: 'كيف أحسب النسبة الموزونة للقبول الجامعي؟',
    a: 'أدخل درجاتك في الثانوية العامة واختبار القدرات والاختبار التحصيلي، ثم اضبط وزن كل معيار حسب جامعتك (مثل ٣٠٪ ثانوية و٤٠٪ قدرات و٣٠٪ تحصيلي). تحسب الأداة المجموع المرجّح وتقسمه على مجموع الأوزان لتظهر لك النسبة الموزونة مباشرة.',
  },
  {
    q: 'هل أوزان النسبة الموزونة ثابتة في كل الجامعات؟',
    a: 'لا، تختلف الأوزان من جامعة لأخرى ومن تخصص لآخر، وقد تتغيّر كل عام. لذلك جعلنا الأوزان قابلة للتعديل؛ اعتمد دائمًا على الأوزان المعلنة في موقع جامعتك أو دليل القبول الرسمي.',
  },
  {
    q: 'ما الفرق بين النسبة الموزونة والنسبة المكافئة؟',
    a: 'كلتاهما تدمج درجاتك بأوزان مختلفة لمعايير القبول؛ والفرق غالبًا في المعايير المشمولة ونسب أوزانها حسب كل جامعة. تتيح لك هذه الحاسبة ضبط المعايير وأوزانها بحرّية لتطابق آلية جامعتك أيًّا كان مسمّاها.',
  },
  {
    q: 'ما هي النسبة الموزونة المطلوبة لدخول الطب؟',
    a: 'تختلف من جامعة لأخرى، لكنها عادةً تتراوح بين ٩٠٪ و٩٥٪ للتخصصات الصحية كالطب وطب الأسنان والصيدلة. بعض الجامعات تطلب أيضًا اجتياز المقابلة الشخصية بالإضافة للنسبة الموزونة.',
  },
  {
    q: 'هل النسبة الموزونة تشمل اختبار STEP أو IELTS؟',
    a: 'بعض الجامعات تشمل درجة اللغة الإنجليزية في النسبة الموزونة (عادة بوزن ١٠٪-٢٠٪). يمكنك إضافة درجة اختبار اللغة الإنجليزية كمعيار إضافي في الحاسبة بوزنه المعلن من جامعتك.',
  },
  {
    q: 'كيف أحسب النسبة الموزونة إذا كانت درجاتي من نظام المقررات؟',
    a: 'نظام المقررات يُحول إلى نسبة مئوية أولًا (غالبًا بتحويل المعدل التراكمي من ٥ أو ٤ إلى نسبة مئوية)، ثم تُستخدم النسبة المئوية كدرجة الثانوية العامة في حساب النسبة الموزونة.',
  },
  {
    q: 'كم نسبة القبول في جامعة الملك سعود وجامعة الملك عبدالعزيز؟',
    a: 'تختلف نسب القبول سنويًا وحسب التخصص. عمومًا: الطب ٩٥٪+، الهندسة ٨٥٪+، التخصصات الأدبية ٧٠-٧٥٪+. راجع بوابات القبول الإلكترونية الرسمية لكل جامعة لمعرفة أحدث النسب.',
  },
];

const jsonLd = graph(
  webAppJsonLd({ name: tool.titleAr, description: tool.descAr, path: '/weighted/' }),
  faqJsonLd(faqs),
);
---
<ToolLayout title={tool.titleAr} description={tool.descAr} path="/weighted/" jsonLd={jsonLd}>
  <div class="tool-head">
    <span class="tool-head-chip"><Icon id={toolIconId(tool.slug)} size={28} /></span>
    <div class="tool-head-text">
      <h1>{tool.titleAr}</h1>
      <p class="tool-intro">{tool.descAr}</p>
    </div>
  </div>

  <div class="card">
    <h2>أدخل درجاتك وأوزانها</h2>
    <p class="note">القِيم التالية افتراضية شائعة في الجامعات السعودية، وكل الحقول قابلة للتعديل. غيّر الأوزان لتطابق جامعتك؛ لا يُشترط أن يكون مجموعها ١٠٠ إذ تُحسب النسبة على أساس مجموع الأوزان.</p>

    <div class="wtbl" id="wtbl">
      <div class="wt-head">
        <span>المعيار</span>
        <span>الدرجة (٪)</span>
        <span>الوزن (٪)</span>
      </div>
      {rows.map((r) => (
        <div class="wt-row" data-row>
          <input type="text" class="wt-label" value={r.label} aria-label="اسم المعيار" />
          <input type="number" class="wt-score" value={r.score} min="0" max="100" step="0.01" inputmode="decimal" aria-label="الدرجة" />
          <input type="number" class="wt-weight" value={r.weight} min="0" step="0.01" inputmode="decimal" aria-label="الوزن" />
        </div>
      ))}
    </div>

    <div class="wt-actions">
      <button type="button" id="addRow" class="btn-secondary">+ إضافة معيار</button>
    </div>

    <div class="result" id="result">
      <div class="result-label">النسبة الموزونة</div>
      <span class="result-main"><span class="num" id="out">—</span><span class="pct">٪</span></span>
      <div class="result-sub">مجموع الأوزان: <span class="num" id="wsum">—</span>٪</div>
    </div>
  </div>

  <Disclaimer variant="calc" />

  <article class="prose" style="margin-block-start:var(--space-8)">
    <h2>دليل النسبة الموزونة للقبول الجامعي في السعودية</h2>
    <p>النسبة الموزونة هي المعيار الأساسي للقبول في الجامعات السعودية. تجمع بين <strong>درجة الثانوية العامة</strong> و<strong>اختبار القدرات العامة</strong> و<strong>الاختبار التحصيلي</strong>، بأوزان تختلف حسب الجامعة والتخصص. الهدف منها إعطاء صورة أكثر عدالة وشمولية عن مستوى الطالب بدلًا من الاعتماد على الثانوية فقط.</p>
    <p>الصيغة الأساسية لحساب النسبة الموزونة:</p>
    <p><strong>النسبة الموزونة = (درجة الثانوية × وزنها + درجة القدرات × وزنها + درجة التحصيلي × وزنه) ÷ مجموع الأوزان</strong></p>
    <p>أمثلة على أوزان شائعة:</p>
    <ul>
      <li><strong>التخصصات العلمية / الصحية:</strong> ٣٠٪ ثانوية + ٣٠٪ قدرات + ٤٠٪ تحصيلي.</li>
      <li><strong>التخصصات الإدارية والإنسانية:</strong> ٥٠٪ ثانوية + ٥٠٪ قدرات (بدون تحصيلي).</li>
      <li><strong>بعض الجامعات:</strong> ٤٠٪ ثانوية + ٣٠٪ قدرات + ٣٠٪ تحصيلي.</li>
    </ul>
    <p>إذا كنت تحسب النسبة المكافئة بدلًا من الموزونة، فهي نفس الطريقة لكن بمعيارين فقط (عادةً الثانوية والقدرات). حاسبتنا مرنة وتقبل أي عدد من المعايير بأي أوزان تريدها — فقط أدخل درجاتك وأوزانها.</p>
    <p>لمزيد من المساعدة: استخدم <a href="/gpa/">حاسبة المعدل التراكمي</a> لتحويل درجاتك إلى نسبة مئوية، أو <a href="/percentage/">حاسبة النسبة المئوية</a> لحساب النسبة المئوية لأي درجة.</p>

    <h2>كيف تعمل حاسبة الموزونة وكيف تحسب نسبتك بدقة؟</h2>
    <p>يعتمد <strong>حساب الموزونة</strong> على فكرة بسيطة في جوهرها: لكل معيار من معايير القبول وزن يعبر عن أهميته النسبية، فتُضرب درجة كل معيار في وزنه، ثم يُجمَع الناتج ويُقسَم على مجموع الأوزان. هذه <strong>حاسبة الموزونه</strong> التي بين يديك مصممة لتقبل أي عدد من المعايير بأي أوزان تختارها، فلا داعي للقلق إن كانت جامعتك تعتمد نظامًا غير تقليدي أو تضمّ اختبارات لغة أو مقابلات. كثير من الطلاب يكتبون في محركات البحث «<em>حساب الموزونه</em>» أو «<em>نسبه موزونة</em>» بصيغ إملائية مختلفة، وكلها تدل على نفس المفهوم. وبينما يستخدم كثير من الطلاب أداة <strong>غزوان</strong> الشهيرة لحساب النقاط، فإن حاسبتنا هنا تمنحك مرونة أكبر في تخصيص المعايير والأوزان، ومقارنة سيناريوهات قبول متعددة دون الحاجة لتثبيت أي تطبيق أو الاعتماد على مصدر واحد فقط.</p>
    <p>النقطة الجوهرية أن <strong>حساب الدرجه الموزونه</strong> ليس مجرد متوسط حسابي بسيط؛ فالمتوسط البسيط يعطي كل درجة أهمية متساوية، أما النسبة الموزونة فتعطي للمعايير الأهم وزنًا أكبر، وهذا ما يجعلها تعكس بدقة رؤية الجامعة لما ينبغي أن يُحتسب لصالح الطالب. على سبيل المثال، لو كانت درجتك في الثانوية ٩٠٪ وفي القدرات ٨٠٪، فإن المتوسط البسيط هو ٨٥٪، لكن إن كان وزن القدرات ٦٠٪ ووزن الثانوية ٤٠٪، فإن <strong>حساب الموزونة</strong> يعطي: (٩٠×٠٫٤٠ + ٨٠×٠٫٦٠) = ٨٤٪ — وهي قيمة أقرب إلى درجة القدرات لأن وزنها أعلى. هذا الفارق قد يحدد قبولك في تخصص تنافسي، لذلك لا تكتفِ بحساب المتوسط البسيط أبدًا.</p>

    <h2>حساب النسبة الموزونة للثانوي والجامعة: ما الفرق؟</h2>
    <p>يخلط كثير من الطلاب بين <strong>حساب النسبة الموزونة للثانوي</strong> وحساب النسبة الموزونة للجامعة، رغم أن بينهما فروقًا جوهرية في الغرض والطريقة. في المرحلة الثانوية، يقصد بـ«الموزونة» عادةً معدل درجات المواد بأوزان مختلفة (مثل أن يكون وزن مادة الرياضيات أكبر من وزن التربية البدنية أو الفنية)، وهذا ما تحسبه بعض المدارس لتحديد المعدل التراكمي للطالب بنهاية الفصل أو السنة. أما <strong>حساب الموزونه للجامعه</strong> فيقصد به النسبة التي تعتمدها الجامعات للقبول، وهي تجمع بين درجات الثانوية العامة واختبارات المركز الوطني للقياس (القدرات والتحصيلي) بأوزان محددة لكل تخصص.</p>
    <p>لذلك حين تبحث عن «<em>حساب الموزونة</em>»، حدد أولًا ما تحتاجه تحديدًا: هل هو معدل ثانوي موزون أم نسبة قبول جامعي موزونة؟ هذه الحاسبة مخصصة للنوع الثاني (القبول الجامعي)، أما لحساب معدلك التراكمي في الثانوية أو الجامعة فيمكنك استخدام <a href="/gpa/">حاسبة المعدل التراكمي الجامعي</a> التي تتعامل مع النظم الفصلية والسنوية بأنظمة مختلفة (من ٥، من ٤، من ١٠٠). ولتحويل أي درجة إلى نسبة مئوية بسيطة، جرّب <a href="/percentage/">حاسبة النسبة المئوية</a> التي تحسب لك النسبة في خطوة واحدة.</p>

    <h2>مثال عملي على حساب الدرجة الموزونة خطوة بخطوة</h2>
    <p>لنأخذ مثالًا واقعيًا يوضّح آلية <strong>حساب الدرجه الموزونه</strong>: طالبة سعودية حصلت على ٩٦٪ في الثانوية العامة، و٨٨ في اختبار القدرات، و٩١ في الاختبار التحصيلي، وتقدمت لكلية الطب في جامعة تستخدم الأوزان: ٣٠٪ ثانوية، ٤٠٪ قدرات، ٣٠٪ تحصيلي. تتم العملية كالتالي:</p>
    <ul>
      <li>الثانوية: ٩٦ × ٠٫٣٠ = ٢٨٫٨٠</li>
      <li>القدرات: ٨٨ × ٠٫٤٠ = ٣٥٫٢٠</li>
      <li>التحصيلي: ٩١ × ٠٫٣٠ = ٢٧٫٣٠</li>
      <li>المجموع المرجَّح: ٢٨٫٨٠ + ٣٥٫٢٠ + ٢٧٫٣٠ = ٩١٫٣٠</li>
      <li>مجموع الأوزان: ٣٠ + ٤٠ + ٣٠ = ١٠٠</li>
      <li>النسبة الموزونة النهائية: ٩١٫٣٠ ÷ ١٠٠ = <strong>٩١٫٣٠٪</strong></li>
    </ul>
    <p>لاحظ كيف أن درجة القدرات (٨٨) سحبت النتيجة نحو الأسفل أكثر من درجة الثانوية (٩٦)، وذلك لأن وزن القدرات أكبر. هذا يفسّر لماذا يركّز كثير من الطلاب على التحضير لاختبار القدرات أكثر من الثانوية عندما يستهدفون تخصصات تنافسية كالطب وطب الأسنان. لإعداد أفضل لاختبار القدرات وفهم كيف تتفاعل درجتك مع بقية المعايير، يمكنك الاطلاع على <a href="/qdrat/">حاسبة نسبة القبول للقدرات</a> التي تساعدك على تقدير موقفك وفقًا لدرجات متوقعة.</p>
    <p>مثال آخر لتخصص إداري يستخدم النسبة المكافئة (معيارين فقط): طالب حاصل على ٨٢٪ في الثانوية و٧٩ في القدرات، والأوزان ٥٠٪ لكل معيار. النسبة المكافئة = (٨٢×٠٫٥٠ + ٧٩×٠٫٥٠) = ٨٠٫٥٪. لو أردت مقارنة ذلك بنسبة موزونة ثلاثية المعايير، فقط أضف صفًا جديدًا في الحاسبة وأدخل وزن التحصيلي.</p>

    <h2>أوزان القبول في الجامعات السعودية: دليل سريع</h2>
    <p>تختلف أوزان القبول من جامعة لأخرى ومن تخصص لآخر داخل الجامعة نفسها، وقد تتغير من عام لآخر. فيما يلي أبرز الأنماط المعتمدة في الجامعات السعودية، لكنها أنماط عامة وليست قواعد ثابتة:</p>
    <ul>
      <li><strong>التخصصات الصحية (الطب، طب الأسنان، الصيدلة):</strong> غالبًا ٣٠٪ ثانوية + ٣٠٪ قدرات + ٤٠٪ تحصيلي، وهي الأعلى تنافسية وتتطلب نسبة موزونة فوق ٩٣٪ عادةً.</li>
      <li><strong>الهندسة والحاسوب:</strong> ٤٠٪ ثانوية + ٣٠٪ قدرات + ٣٠٪ تحصيلي في كثير من الجامعات، مع تركيز أعلى على الرياضيات والفيزياء.</li>
      <li><strong>التخصصات الإدارية:</strong> ٥٠٪ ثانوية + ٥٠٪ قدرات (دون تحصيلي) في بعض الجامعات، أو ٤٠٪ ثانوية + ٤٠٪ قدرات + ٢٠٪ تحصيلي في أخرى.</li>
      <li><strong>التخصصات الإنسانية والأدبية:</strong> غالبًا ٦٠٪ ثانوية + ٤٠٪ قدرات، وأحيانًا يشمل التحصيلي بوزن صغير.</li>
      <li><strong>بعض الجامعات الخاصة:</strong> قد تضمّ درجة اختبار اللغة الإنجليزية (STEP أو IELTS أو TOEFL) بوزن ١٠-٢٠٪ بدلًا من التحصيلي أو إلى جانبه.</li>
    </ul>
    <p>لا تعتمد على أوزان قديمة منسوخة من منتديات أو صور شاشة؛ دائمًا راجع <strong>بوابة القبول الإلكترونية</strong> لجامعتك في العام الذي تتقدم فيه، لأن الجامعات قد تعدّل الأوزان بين عام وآخر. وإن كانت جامعتك تطلب «النسبة المكافئة» (معيارين فقط)، يمكنك ببساطة حذف المعيار الثالث من الحاسبة وستتولى هي حساب النسبة على أساس مجموع الأوزان الجديد تلقائيًا دون أي خطوة إضافية.</p>

    <h2>الفرق بين النسبة الموزونة والمكافئة والمعدل التراكمي</h2>
    <p>مصطلحات القبول قد تربك الطالب في البداية، لكن الفروق بينها واضحة ومحددة:</p>
    <ul>
      <li><strong>النسبة الموزونة:</strong> تجمع ثلاثة معايير أو أكثر بأوزان مختلفة (الثانوية + القدرات + التحصيلي عادةً)، وهي ما تحسبه هذه الأداة.</li>
      <li><strong>النسبة المكافئة:</strong> تجمع معيارين فقط، غالبًا الثانوية والقدرات بنسب متساوية أو غير متساوية، وتستخدمها بعض التخصصات الأدبية.</li>
      <li><strong>المعدل التراكمي (GPA):</strong> هو متوسط درجات الطالب في مواد دراسته على مدار فصل أو سنة أو مرحلة كاملة، ويُحسب من ٥ أو من ٤ أو من ١٠٠ حسب النظام. تتحول هذه القيمة إلى نسبة مئوية قبل إدخالها في حاسبة القبول.</li>
    </ul>
    <p>إن كنت تريد <strong>حساب الموزونة</strong> بدقة فتأكد أولًا من تحويل معدلك التراكمي إلى نسبة مئوية صحيحة. فمثلًا، معدل ٤٫٧ من ٥ يساوي ٩٤٪، ومعدل ٣٫٨ من ٤ يساوي ٩٥٪، ومعدل ٨٨ من ١٠٠ يساوي ٨٨٪ مباشرة. استخدم <a href="/gpa/">حاسبة المعدل التراكمي</a> لإجراء هذا التحويل بسهولة وبدقة، ثم انقل الناتج إلى حقل «الثانوية العامة» هنا. وحين تريد حساب نسبة أي درجة بسرعة (مثل نسبة درجة اختبار فرعي أو نسبة نجاح في مادة واحدة)، فإن <a href="/percentage/">حاسبة النسبة المئوية</a> جاهزة لذلك في خطوة واحدة.</p>

    <h2>نصائح عملية لرفع نسبتك الموزونة</h2>
    <p>النسبة الموزونة ليست قدرًا محتومًا؛ يمكنك رفعها بإجراءات مدروسة وذكية:</p>
    <ul>
      <li><strong>ركّز على المعيار ذي الوزن الأعلى:</strong> إن كان وزن القدرات ٤٠٪ فإن كل درجة تزيدها في القدرات تساوي تقريبًا ١٫٣ درجة في الثانوية (التي وزنها ٣٠٪). تحضير مكثف لاختبار القدرات قد يرفع نسبتك النهائية أكثر من السعي خلف درجات ثانوية هامشية في مواد فرعية.</li>
      <li><strong>أعد اختبار التحصيلي إن كانت درجتك منخفضة:</strong> يُسمح بإعادة الاختبار أكثر من مرة، وتُعتمد أعلى درجة. فارق ١٠ درجات في التحصيلي قد يرفع نسبتك الموزونة بنحو ٣ نقاط إن كان وزنه ٣٠٪، وهو فارق قد يفتح لك تخصصًا كان مغلقًا.</li>
      <li><strong>قارن سيناريوهات القبول قبل التقديم:</strong> استخدم الحاسبة لمحاكاة درجات متوقعة في كل معيار، لترى أي تخصص تستطيع التنافس عليه قبل التقديم فعليًا. جرّب ثلاث سيناريوهات: متفائل، واقعي، ومحافظ.</li>
      <li><strong>تابع التحديثات الرسمية:</strong> بعض الجامعات تعدّل أوزانها سنويًا، وقد تضيف معايير جديدة كاختبارات مهارات أو مقابلات شخصية. سجّل أوزان هذا العام فقط من المصدر الرسمي لجامعتك.</li>
      <li><strong>لا تتجاهل اختبار اللغة الإنجليزية:</strong> إن كانت جامعتك تضمّه في الموزونة، فإن تحضيرًا جيدًا لاختبار STEP قد يرفع نسبتك بشكل ملحوظ لأن المنافسة فيه أقل حدة من القدرات.</li>
    </ul>
    <p>تذكر أن النسبة الموزونة عتبة قبول لا ضمانًا له؛ بعض التخصصات التنافسية كالطب تطلب بعدها مقابلة شخصية أو اختبارًا تخصصيًا، وبعض الكليات الصحية تشترط اجتياز اختبارات مهارية إضافية. اعتبر هذه الحاسبة أداة تخطيط تساعدك على معرفة موقفك وتقدير فرصك بواقعية، لا بديلًا عن متابعة بوابة القبول الرسمية لجامعتك والاستعداد للمقابلات والاختبارات التخصصية بنفس الجدية.</p>
  </article>

