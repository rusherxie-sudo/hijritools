---
import ToolLayout from '../../layouts/ToolLayout.astro';
import Icon from "../../components/Icon.astro";
import { toolIconId } from "../../data/icons.js";
import Faq from "../../components/Faq.astro";
import Disclaimer from '../../components/Disclaimer.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import { getTool } from '../../data/tools.js';
import { webAppJsonLd, faqJsonLd, graph } from '../../lib/seo.js';

const tool = getTool('discount');
const faqs = [
  {
    q: 'كيف أحسب سعر المنتج بعد الخصم؟',
    a: 'اضرب السعر الأصلي في (١ ناقص نسبة الخصم مقسومة على ١٠٠). مثال: منتج بـ ٢٠٠ ريال وعليه خصم ١٥٪، يصير سعره بعد الخصم ١٧٠ ريال وتوفّر ٣٠ ريال.',
  },
  {
    q: 'كيف أعرف نسبة الخصم بين سعرين؟',
    a: 'اطرح السعر بعد التخفيض من السعر الأصلي، ثم اقسم الناتج على السعر الأصلي واضربه في ١٠٠. مثال: من ٢٠٠ إلى ١٧٠ يعني خصم ١٥٪.',
  },
  {
    q: 'هل تشمل الحاسبة ضريبة القيمة المضافة؟',
    a: 'لا، الحاسبة تحسب الخصم على السعر المُدخل فقط. إذا أردت إضافة الضريبة بعد الخصم، استخدم حاسبة ضريبة القيمة المضافة المخصصة لكل دولة خليجية.',
  },
];
const jsonLd = graph(
  webAppJsonLd({ name: tool.titleAr, description: tool.descAr, path: '/discount/' }),
  faqJsonLd(faqs),
);
---
<ToolLayout title={tool.titleAr} description={tool.descAr} path="/discount/" jsonLd={jsonLd}>
  <div class="tool-head">
    <span class="tool-head-chip"><Icon id={toolIconId(tool.slug)} size={28} /></span>
    <div class="tool-head-text">
      <h1>{tool.titleAr}</h1>
      <p class="tool-intro">{tool.descAr}</p>
    </div>
  </div>

  <div class="card">
    <h2>السعر بعد الخصم</h2>
    <div class="row">
      <div class="field"><label for="orig1">السعر الأصلي</label><input type="number" id="orig1" value="200" min="0" /></div>
      <div class="field"><label for="pct1">نسبة الخصم ٪</label><input type="number" id="pct1" value="15" min="0" /></div>
    </div>
    <div class="result" id="res1">
      <div class="result-main num" id="after1">170</div>
      <div class="result-grid">
        <div class="stat"><div class="v num" id="saved1">30</div><div class="l">قيمة التوفير</div></div>
      </div>
    </div>
  </div>

  <div class="card">
    <h2>كم نسبة الخصم؟</h2>
    <div class="row">
      <div class="field"><label for="orig2">السعر الأصلي</label><input type="number" id="orig2" value="200" min="0" /></div>
      <div class="field"><label for="sale2">السعر بعد التخفيض</label><input type="number" id="sale2" value="170" min="0" /></div>
    </div>
    <div class="result" id="res2"><span class="result-main"><span class="num" id="rate2">15</span>٪</span></div>
  </div>

  <article class="prose" style="margin-block-start:var(--space-8)">
    <h2>حاسبة الخصم: الأداة العملية لتسوّق أذكى في السعودية</h2>
    <p>
      تُعدّ <strong>حاسبة الخصم</strong> من أكثر الأدوات استخدامًا في مواسم التسوّق في المملكة العربية السعودية، إذ تساعد المتسوّق على معرفة السعر الحقيقي بعد التخفيض بدقّة ثانية واحدة، دون الحاجة إلى فتح الآلة الحاسبة أو إجراء العمليات يدويًا. سواء كنت تتابع عروض <strong>الجمعة البيضاء</strong> أو تنظر إلى لوحة "خصم ٥٠٪" في أحد المتاجر الكبرى، فإنّ <strong>حساب الخصم</strong> بطريقة صحيحة يضمن ألّا تدفع أكثر ممّا يجب، وأن تُقارن بين المنتجات بثقة.
    </p>

    <h2>كيف تعمل حاسبة الخصم؟</h2>
    <p>
      تعتمد <strong>حاسبة الخصم</strong> على معادلة بسيطة: <em>السعر بعد الخصم = السعر الأصلي × (١ − نسبة الخصم ÷ ١٠٠)</em>. فعلى سبيل المثال، إن كان السعر الأصلي لمنتج ٢٠٠ ريال سعودي والخصم المعلن ١٥٪، فإنّ:
    </p>
    <ul>
      <li>السعر بعد الخصم = ٢٠٠ × (١ − ٠٫١٥) = ٢٠٠ × ٠٫٨٥ = <strong>١٧٠ ريالًا</strong>.</li>
      <li>قيمة التوفير = ٢٠٠ − ١٧٠ = <strong>٣٠ ريالًا</strong>.</li>
    </ul>
    <p>
      وبهذا يكون المبلغ الذي تدّخره واضحًا أمامك، وتستطيع أن تقرّر فورًا إن كان العرض يستحقّ الشراء أم لا. كما يمكنك دمج هذه النتيجة مع <a href="/percentage/">حاسبة النسبة المئوية</a> لتحويل النسب بين السياقات المختلفة، أو معرفة أثر الضريبة على السعر النهائي عبر <a href="/vat/">حاسبة ضريبة القيمة المضافة</a>.
    </p>

    <h2>معرفة نسبة الخصم من سعرين: خطوات تفصيلية</h2>
    <p>
      أحيانًا يُعلن المتجر السعر القديم والسعر الجديد دون ذكر نسبة الخصم صراحة، وهنا تأتي أهميّة <strong>معرفة نسبة الخصم</strong> من خلال سعرين فقط. الخطوات بالتفصيل:
    </p>
    <ol>
      <li>اطرح السعر الجديد من السعر الأصلي لمعرفة قيمة التخفيض. مثال: ٢٠٠ − ١٧٠ = ٣٠ ريالًا.</li>
      <li>اقسم ناتج الطرح على السعر الأصلي: ٣٠ ÷ ٢٠٠ = ٠٫١٥.</li>
      <li>اضرب الناتج في ١٠٠ لتحويله إلى نسبة مئوية: ٠٫١٥ × ١٠٠ = <strong>١٥٪</strong>.</li>
    </ol>
    <p>
      هذه الطريقة مفيدة جدًا عند مقارنة عروض متعدّدة؛ فقد يبدو خصم "٤٠ ريالًا" أكبر من خصم "٣٠ ريالًا"، لكن إن كان المنتج الأول سعره ٥٠٠ ريال والثاني ٢٠٠ ريال، فإنّ نسبة الخصم الفعلية تكون ٨٪ مقابل ١٥٪، أي أنّ العرض الثاني أوفر بكثير. الأداة في الأعلى تقوم بهذه العملية تلقائيًا في بطاقة "كم نسبة الخصم؟".
    </p>

    <h2>مواسم التسوّق السعودية: متى تكون حاسبة الخصم ضرورية؟</h2>
    <p>
      تشهد السعودية مواسم تسوّق كبرى تجعل <strong>حساب الخصم</strong> فيها ضرورة لا رفاهية. أبرزها:
    </p>
    <ul>
      <li><strong>الجمعة البيضاء (وايت فرايداي):</strong> تنطلق عادة في نوفمبر، وتقدّم المتاجر الإلكترونية مثل نون وأمازون السعودية خصومات تصل أحيانًا إلى ٨٠٪. استخدم الحاسبة للتأكّد من أنّ السعر المُعَلَّم بخط أحمر هو فعلًا السعر الأصلي، وليس سعرًا مُرفَعًا اصطناعيًا قبل التخفيض.</li>
      <li><strong>تخفيضات نهاية الموسم:</strong> في يناير ويوليو تُفرّغ المتاجر مخزونها بخصومات تدريجية تبدأ من ٢٥٪ وتصل إلى ٧٠٪. احسب النسبة بنفسك للتأكّد من تراكم الخصم على كل طبقة.</li>
      <li><strong>ليالي رمضان والعيد:</strong> تُقدّم المتاجر الكبرى مثل العثيم وتموين ولولو هايبر ماركت عروض "اشترِ واحدة واحصل على الثانية بنصف السعر"، وهو ما يعادل خصمًا فعليًا ٢٥٪ على كل وحدة. حاسبة الخصم تساعدك على تحويل هذه العروض إلى نسبة واضحة قابلة للمقارنة.</li>
      <li><strong>حجوزات السفر والفنادق:</strong> موسم الحج والعمرة يحمل عروضًا مركّبة على الطيران والفنادق؛ حوّل القيمة المطلقة للخصم إلى نسبة لتعرف أيّ عرض أفضل.</li>
    </ul>

    <h2>أخطاء شائعة في حساب الخصم</h2>
    <p>
      يقع كثيرون في أخطاء عند <strong>حساب الخصم</strong> يدويًا، أبرزها الجمع بين خصمين بطريقة خاطئة. فمثلًا، إن كان على المنتج خصم ٢٠٪ ثم خصم إضافي ١٠٪ على السعر المخفّض، فالنسبة الإجمالية ليست ٣٠٪ بل ٢٨٪، لأنّ الخصم الثاني يُطبَّق على المبلغ المتبقي. للتوضيح: منتج بـ ٢٠٠ ريال، بعد الخصم الأول يصير ١٦٠ ريالًا، ثم نخصم ١٠٪ من ١٦٠ فيصير ١٤٤ ريالًا، أي التوفير الكلّي ٥٦ ريالًا (٢٨٪ من ٢٠٠). استخدم الحاسبة على مرحلتين للحصول على النتيجة الصحيحة.
    </p>
    <p>
      خطأ آخر شائع هو نسيان ضريبة القيمة المضافة. في السعودية الضريبة ١٥٪، فإذا أردت معرفة المبلغ النهائي الذي ستدفعه على الطرف، احسب الخصم أولًا ثم أضف الضريبة عبر <a href="/vat/">حاسبة ضريبة القيمة المضافة السعودية</a> لتفادي أي مفاجأة عند الدفع.
    </p>

    <h2>نصائح لتسوّق ذكي باستخدام حاسبة الخصم</h2>
    <p>
      قارن بين المتاجر قبل الشراء: انقل السعر الأصلي والسعر المخفّض إلى الحاسبة لكل متجر، واختر الأعلى نسبةً لا الأعلى قيمة مطلقة للتوفير. احذر من "الخصم الصوري": بعض المتاجر ترفع السعر قبل التخفيض لإظهار نسبة أكبر، فتابع الأسعار التاريخية عبر متصفّحات التسوّق، وتذكّر أنّ <strong>معرفة نسبة الخصم</strong> الحقيقية تبدأ من السعر الذي اشتريتَه فعليًا قبل العرض.
    </p>
    <p>
      اجمع العروض بحكمة: بطاقات الائتمان والمحافظ الإلكترونية تقدّم استرجاع نقدي (كاش باك) يصل إلى ٥٪، وهو يُضاف إلى الخصم الأساسي. لكن انتبه أنّه يُحتسب على السعر بعد الخصم لا قبله. استخدم هذه الصفحة كمرجع يومي خلال مواسم التسوّق، واحفظها في مفضّلتك لتصل إليها بسرعة وقت الحاجة. كما يمكنك الاطّلاع على <a href="/percentage/">حاسبة النسبة المئوية</a> لمزيد من العمليات المرتبطة بالنسب.
    </p>
  </article>

  <Disclaimer variant="calc" />

  <Faq faqs={faqs} />

  <RelatedTools slugs={tool.related} />
</ToolLayout>

<script>
  import { priceAfterDiscount, savedAmount, discountRate } from '../../lib/discount.js';
  const $ = (id) => document.getElementById(id);
  const val = (id) => parseFloat($(id).value);
  const show = (id, v) => { $(id).textContent = Number.isFinite(v) ? v : '-'; };

  function calc1() {
    show('after1', priceAfterDiscount(val('orig1'), val('pct1')));
    show('saved1', savedAmount(val('orig1'), val('pct1')));
  }
  function calc2() {
    show('rate2', discountRate(val('orig2'), val('sale2')));
  }
  ['orig1', 'pct1'].forEach((id) => $(id).addEventListener('input', calc1));
  ['orig2', 'sale2'].forEach((id) => $(id).addEventListener('input', calc2));
  calc1(); calc2();
</script>
