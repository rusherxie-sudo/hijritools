---
import ToolLayout from '../../layouts/ToolLayout.astro';
import Icon from "../../components/Icon.astro";
import { toolIconId } from "../../data/icons.js";
import Faq from "../../components/Faq.astro";
import Disclaimer from '../../components/Disclaimer.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import { getTool } from '../../data/tools.js';
import { gccOrder, countries } from '../../data/countries.js';
import { webAppJsonLd, faqJsonLd, graph } from '../../lib/seo.js';

const tool = getTool('hijri');
const faqs = [
  { q: 'ما هو تقويم أم القرى؟', a: 'هو التقويم الهجري الرسمي المعتمد في المملكة العربية السعودية ومعظم دول الخليج، ويُحسب فلكيًا مسبقًا لسنوات قادمة، وتعتمده أنظمة التشغيل والتطبيقات حول العالم.' },
  { q: 'لماذا يختلف التاريخ الهجري بين الدول أحيانًا؟', a: 'لأن بداية الشهر الهجري ترتبط برؤية الهلال، وتختلف الرؤية بين الدول، فقد يفرق التاريخ بيوم واحد. لذلك نوفّر خيار تعديل الدولة لمطابقة التاريخ المعتمد محليًا.' },
  { q: 'هل التحويل دقيق؟', a: 'نعم، يعتمد التحويل على بيانات تقويم أم القرى الرسمية. وتبقى المناسبات الرسمية معتمدة حسب إعلان الجهات المختصة في كل دولة.' },
];
const jsonLd = graph(
  webAppJsonLd({ name: tool.titleAr, description: tool.descAr, path: '/hijri/' }),
  faqJsonLd(faqs),
);
---
<ToolLayout title={tool.titleAr} description={tool.descAr} path="/hijri/" jsonLd={jsonLd}>
  <div class="tool-head">
    <span class="tool-head-chip"><Icon id={toolIconId(tool.slug)} size={28} /></span>
    <div class="tool-head-text">
      <h1>{tool.titleAr}</h1>
      <p class="tool-intro">{tool.descAr}</p>
    </div>
  </div>

  <div class="field" style="max-width:280px">
    <label for="country">الدولة (لضبط فرق رؤية الهلال)</label>
    <select id="country">
      {gccOrder.map((cc) => (<option value={cc}>{countries[cc].nameAr}</option>))}
    </select>
  </div>

  <!-- 今日伊历 -->
  <div class="result" id="today-box">
    <div class="num result-main" id="today-hijri">…</div>
    <hr class="gold-divider" />
    <div class="num" id="today-greg" style="color:var(--color-text-muted)">…</div>
    <div id="today-weekday" style="margin-block-start:.5rem"></div>
    <div id="today-sacred"></div>
  </div>


  <!-- 方向分段切换 -->
  <div class="segmented" role="radiogroup" aria-label="اتجاه التحويل">
    <button type="button" class="seg-btn active" data-dir="g2h" role="radio" aria-checked="true">ميلادي إلى هجري</button>
    <button type="button" class="seg-btn" data-dir="h2g" role="radio" aria-checked="false">هجري إلى ميلادي</button>
  </div>

  <!-- 公历 → 伊历 -->
  <div class="card" id="card-g2h">
    <h2>تحويل من ميلادي إلى هجري</h2>
    <div class="field" style="max-width:280px">
      <label for="g-date">اختر التاريخ الميلادي</label>
      <input type="date" id="g-date" />
    </div>
    <div class="result hidden" id="g2h-result">
      <div class="num" id="g2h-out" style="font-size:1.5rem;font-weight:700;color:var(--color-primary-dark)"></div>
      <div id="g2h-weekday" style="color:var(--color-text-muted)"></div>
      <div id="g2h-sacred"></div>
    </div>
  </div>

  <!-- 伊历 → 公历 -->
  <div class="card hidden" id="card-h2g">
    <h2>تحويل من هجري إلى ميلادي</h2>
    <div class="row">
      <div class="field"><label for="h-year">السنة</label><input type="number" id="h-year" value="1447" min="1356" max="1500" /></div>
      <div class="field"><label for="h-month">الشهر</label><select id="h-month"></select></div>
      <div class="field"><label for="h-day">اليوم</label><input type="number" id="h-day" value="1" min="1" max="30" /></div>
    </div>
    <button class="btn" id="h2g-btn">تحويل</button>
    <div class="result hidden" id="h2g-result">
      <div class="num" id="h2g-out" style="font-size:1.5rem;font-weight:700;color:var(--color-primary-dark)"></div>
      <div id="h2g-weekday" style="color:var(--color-text-muted)"></div>
    </div>
    <p class="error-text hidden" id="h2g-err">تاريخ هجري غير صالح أو خارج النطاق المدعوم (١٣٥٦–١٥٠٠ هـ).</p>
  </div>

  <!-- 倒计时 -->
  <div class="card">
    <h2>العد التنازلي للمناسبات</h2>
    <div class="result-grid" id="countdown"></div>
  </div>

  <!-- المحتوى التعليمي -->
  <div class="card tool-guide">
    <h2>ما هو تقويم أم القرى؟</h2>
    <p>تقويم أم القرى هو التقويم الهجري الرسمي المعتمد في المملكة العربية السعودية، الصادر عن مجمع الملك عبدالله بن عبدالعزيز لخدمة القرآن الكريم والسنة النبوية. يُحسب فلكيًا بدقة عالية قبل سنوات قادمة، وتتعتمده أنظمة التشغيل (Apple, Google, Microsoft) حول العالم. هذا يعني أن أي تحويل هجري على هاتفك أو حاسوبك يطابق نتائج تقويم أم القرى.</p>
    <p>تعتمد دول الخليج الست (السعودية، الإمارات، قطر، الكويت، البحرين، عُمان) تقويم أم القرى أساسًا لتحديد بدايات الأشهر والمناسبات الرسمية.</p>

    <h2>كيف يختلف التاريخ الهجري عن الميلادي؟</h2>
    <p>السنة الهجرية أقصر من الميلادية بنحو ١١ يومًا، لأن السنة الميلادية تتبع دوران الأرض حول الشمس (٣٦٥.٢٥ يومًا)، بينما السنة الهجرية تتبع دوران القمر حول الأرض (٣٥٤.٣٧ يومًا في المتوسط). هذا الفرق يجعل العمر الهجري أكبر من الميلادي بحوالي سنة واحدة كل ٣٣ سنة.</p>
    <p>مثلًا: شخص عمره ٣٣ سنة ميلادية يكون عمره ٣٤ سنة هجرية تقريبًا. وفي عمر ٩٩ سنة ميلادية يقترب عمره الهجري من ١٠٢ سنة.</p>

    <h2>استخدامات التحويل بين التقويمين</h2>
    <ul>
      <li><strong>التوثيق الرسمي:</strong> بعض المعاملات الحكومية في السعودية والخليج تتطلب تاريخ الميلاد بالتقويم الهجري (كتابة بطاقة الهوية، جواز السفر، القطاع الصحي).</li>
      <li><strong>التخطيط الديني:</strong> حساب مواعيد رمضان والأعياد ومناسك الحج، خاصةً في الدول التي تعتمد رؤية الهلال المحلية.</li>
      <li><strong>التقويم الدراسي:</strong> بداية ونهاية العام الدراسي في بعض الدول الخليجية تُحدد بالتقويم الهجري.</li>
      <li><strong>الخدمات المالية:</strong> بعض عقود التأمين والاستثمار تستخدم التاريخ الهجري لحساب فترات الاستحقاق.</li>
    </ul>

    <h2>الأشهر الحرم وأثرها</h2>
    <p>الأشهر الحرم أربعة: <strong>محرّم، رجب، ذو القعدة، ذو الحجة</strong>. في هذه الأشهر يُحرم القتال وتُضاعف الحسنات والأعمال الصالحة. شهر محرم تحديدًا هو أول الأشهر الحرم وأول شهر في السنة الهجرية، ويُعد من أفضل الأشهر للعبادة والذكر.</p>

    <h2>مصادر رسمية للتاريخ الهجري</h2>
    <ul>
      <li><a href="https://www.qurity.gov.sa" target="_blank" rel="noopener">مجمع الملك عبدالله بن عبدالعزيز لخدمة القرآن الكريم والسنة النبوية</a> — التقويم الرسمي لأم القرى</li>
      <li><a href="https://www.ummulqura.org.sa" target="_blank" rel="noopener">البوابة الإلكترونية لتقويم أم القرى</a> — البيانات الفلكية التاريخية والقادمة</li>
    </ul>

    <h2>التقويم الهجري اليوم: كيف تعرف تاريخ اليوم بالهجري؟</h2>
    <p>لمعرفة <strong>التقويم الهجري اليوم</strong> بسهولة ودقة، يكفي فتح هذه الصفحة لتظهر لك الأداة في الأعلى التاريخ الهجري الموافق لليوم الحالي فورًا، وفقًا لتقويم أم القرى المعتمد في المملكة العربية السعودية ودول مجلس التعاون الخليجي. يُعرض التاريخ الهجري مع اسم الشهر ويوم الأسبوع، إلى جانب التاريخ الميلادي المقابل، فلا حاجة إلى أي حساب يدوي. كما يمكنك اختيار دولتك من القائمة لأعلى لضبط فرق رؤية الهلال، إذ قد يتقدم التاريخ أو يتأخر يومًا بين دولة وأخرى بسبب اختلاف الرؤية المحلية للهلال.</p>
    <p>يُعد الاطلاع على <strong>تقويم هجري</strong> موثوق أمرًا ضروريًا يوميًا للمسلمين في الخليج، لأن كثيرًا من المعاملات الرسمية والشخصية مرتبطة بالتاريخ الهجري. فعلى سبيل المثال، يُعلن عن شهر رمضان المبارك وأيام عيد الفطر وعيد الأضحى وموسم الحج بناءً على التقويم الهجري، كما تُحدد إجازات الموظفين في القطاع الحكومي والخاص وفقًا للتقويم الهجري الرسمي في المملكة العربية السعودية والإمارات وقطر والكويت والبحرين وسلطنة عُمان.</p>

    <h2>أمثلة عملية على تحويل التاريخ بين الهجري والميلادي</h2>
    <p>لفهم آلية التحويل بين التقويمين، إليك أمثلة واقعية مستمدة من تقويم أم القرى. التحويل من الميلادي إلى الهجري: التاريخ <span class="num">14 يونيو 2026</span> ميلادي يوافق <span class="num">28 ذو الحجة 1447</span> هجري. والتحويل العكسي من الهجري إلى الميلادي: التاريخ <span class="num">1 محرم 1447</span> هجري يوافق <span class="num">26 يونيو 2025</span> ميلادي. يمكنك التحقق من هذه التحويلات باستخدام الأداة أعلاه باختيار التاريخ الميلادي أو إدخال التاريخ الهجري يدويًا.</p>
    <p>من المهم ملاحظة أن الفرق بين السنة الهجرية والميلادية يبلغ نحو <span class="num">11</span> يومًا سنويًا، مما يعني أن التاريخ الهجري يتقدم على الميلادي بمقدار أحد عشر يومًا كل سنة ميلادية. فإذا صادف أول محرم في عام معين يوم <span class="num">26 يونيو</span>، فإن أول محرم في العام التالي سيصادف نحو <span class="num">15 يونيو</span>، وهكذا. هذا الفرق المتراكم يجعل التحويل بين التقويمين ضرورة يومية للمواطنين والمقيمين في دول الخليج.</p>

    <h2>استخدام التقويم الهجري في المعاملات الرسمية بدول الخليج</h2>
    <p>يعتمد التقويم الهجري بشكل رسمي في المملكة العربية السعودية في جميع الوثائق الحكومية، بما في ذلك بطاقات الهوية الوطنية وجوازات السفر وعقود التوظيف وشهادات الميلاد والوفاة والسجلات المدنية. كما تعتمده بعض الوزارات والهيئات في الإمارات العربية المتحدة وقطر والكويت لتحديد بدايات ونهايات السنة المالية والدراسية، ولا سيما في المسائل المتعلقة بالمحاكم الشرعية والأحوال الشخصية.</p>
    <p>في القطاع المصرفي والمالي الخليجي، تُحدد فترات استحقاق بعض المنتجات المالية الإسلامية كالمرابحة والصكوك وفقًا للتقويم الهجري، لأن هذه العقود تستند إلى أحكام الشريعة الإسلامية التي تعتمد الشهر القمري. كذلك تُحسب زكاة الفطر وكفارة اليمين وكفارة الصيام بالأيام الهجرية، مما يجعل وجود <strong>تقويم هجري</strong> دقيق وموثوق ضرورة عملية يومية للمسلمين في الخليج، ولهذا توفر هذه الأداة عرضًا فوريًا لـ <strong>التقويم الهجري اليوم</strong> مع إمكانية التحويل في الاتجاهين.</p>
  </div>

  <Disclaimer variant="hijri" />

  <Faq faqs={faqs} />

  <RelatedTools slugs={tool.related} />
</ToolLayout>

<script>
  import {
    gregorianToHijri, hijriToGregorian, formatHijri, formatGregorian,
    HIJRI_MONTHS_AR, WEEKDAYS_AR, isSacredMonth,
  } from '../../lib/hijri.js';
  import { todayUtc, parseISODate, utcDate, toISODate, diffInDays } from '../../lib/date-utils.js';
  import { countdownTargets } from '../../data/hijri-holidays.js';

  const $ = (id) => document.getElementById(id);
  const countrySel = $('country');
  const offsets = { sa: 0, ae: 0, qa: 0, kw: 0, bh: 0, om: 0 };
  const getOffset = () => offsets[countrySel.value] ?? 0;

  // 圣月徽章：在圣月时显示金色胶囊，否则清空。
  const sacredBadge = (hm) => isSacredMonth(hm)
    ? '<span style="display:inline-block;margin-block-start:.5rem;padding:.15rem .7rem;border-radius:999px;background:var(--color-accent-light);color:var(--color-accent-deep);font-size:var(--fs-small);font-weight:700">🕌 شهر من الأشهر الحُرُم</span>'
    : '';

  // 填充伊历月下拉
  const hMonth = $('h-month');
  for (let m = 1; m <= 12; m++) {
    const o = document.createElement('option');
    o.value = String(m); o.textContent = `${m} - ${HIJRI_MONTHS_AR[m]}`;
    hMonth.appendChild(o);
  }

  function renderToday() {
    const today = todayUtc();
    const off = getOffset();
    const h = gregorianToHijri(today, off);
    $('today-hijri').textContent = formatHijri(h);
    $('today-greg').textContent = formatGregorian(today);
    $('today-weekday').textContent = WEEKDAYS_AR[h.weekday];
    $('today-sacred').innerHTML = sacredBadge(h.hm);
    renderCountdown(today, off);
  }

  function renderG2H() {
    const d = parseISODate($('g-date').value);
    const box = $('g2h-result');
    if (!d) { box.classList.add('hidden'); return; }
    try {
      const h = gregorianToHijri(d, getOffset());
      $('g2h-out').textContent = formatHijri(h);
      $('g2h-weekday').textContent = WEEKDAYS_AR[h.weekday];
      $('g2h-sacred').innerHTML = sacredBadge(h.hm);
      box.classList.remove('hidden');
    } catch { box.classList.add('hidden'); }
  }

  function renderH2G() {
    const hy = parseInt($('h-year').value, 10);
    const hm = parseInt($('h-month').value, 10);
    const hd = parseInt($('h-day').value, 10);
    const box = $('h2g-result'); const err = $('h2g-err');
    try {
      const g = hijriToGregorian(hy, hm, hd, getOffset());
      const back = gregorianToHijri(g, getOffset());
      $('h2g-out').textContent = formatGregorian(g);
      $('h2g-weekday').textContent = WEEKDAYS_AR[back.weekday];
      box.classList.remove('hidden'); err.classList.add('hidden');
    } catch {
      box.classList.add('hidden'); err.classList.remove('hidden');
    }
  }

  function renderCountdown(today, off) {
    const grid = $('countdown');
    grid.innerHTML = '';
    const todayH = gregorianToHijri(today, off);
    for (const t of countdownTargets) {
      // 找今年或明年的该伊历日对应公历
      let hy = todayH.hy;
      let g = hijriToGregorian(hy, t.hm, t.hd, off);
      if (diffInDays(today, g) < 0) g = hijriToGregorian(hy + 1, t.hm, t.hd, off);
      const days = diffInDays(today, g);
      const el = document.createElement('div');
      el.className = 'stat';
      el.innerHTML = `<div class="v num">${days}</div><div class="l">يوم حتى ${t.nameAr}</div>`;
      grid.appendChild(el);
    }
  }

  // 方向分段切换：仅切显示，转换逻辑不变。
  const cards = { g2h: $('card-g2h'), h2g: $('card-h2g') };
  for (const btn of document.querySelectorAll('.seg-btn')) {
    btn.addEventListener('click', () => {
      const dir = btn.dataset.dir;
      for (const b of document.querySelectorAll('.seg-btn')) {
        const on = b === btn;
        b.classList.toggle('active', on);
        b.setAttribute('aria-checked', String(on));
      }
      cards.g2h.classList.toggle('hidden', dir !== 'g2h');
      cards.h2g.classList.toggle('hidden', dir !== 'h2g');
    });
  }

  // 初始化
  $('g-date').value = toISODate(todayUtc());
  renderToday();
  renderG2H();
  countrySel.addEventListener('change', () => { renderToday(); renderG2H(); renderH2G(); });
  $('g-date').addEventListener('change', renderG2H);
  $('h2g-btn').addEventListener('click', renderH2G);
  // 伊历→公历也即时计算（与公历→伊历方向交互一致）
  for (const id of ['h-year', 'h-month', 'h-day']) $(id).addEventListener('input', renderH2G);
  $('h-month').addEventListener('change', renderH2G);
</script>
