---
import ToolLayout from '../../layouts/ToolLayout.astro';
import Icon from "../../components/Icon.astro";
import { toolIconId } from "../../data/icons.js";
import Faq from "../../components/Faq.astro";
import Disclaimer from '../../components/Disclaimer.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import { getTool } from '../../data/tools.js';
import { webAppJsonLd, faqJsonLd, graph } from '../../lib/seo.js';

const tool = getTool('bmi');
const faqs = [
  { q: 'ما هو مؤشر كتلة الجسم BMI؟', a: 'هو رقم يربط بين وزنك وطولك لتقدير ما إذا كان وزنك صحيًا. يُحسب بقسمة الوزن بالكيلوغرام على مربّع الطول بالمتر.' },
  { q: 'كم مؤشر كتلة الجسم الطبيعي؟', a: 'حسب منظمة الصحة العالمية، يكون الوزن طبيعيًا إذا كان المؤشر بين 18.5 و24.9. أقل من ذلك نحافة، ومن 25 إلى 29.9 زيادة في الوزن، و30 فأكثر سمنة.' },
  { q: 'هل مؤشر كتلة الجسم دقيق للجميع؟', a: 'هو مؤشر تقريبي عام ولا يفرّق بين العضلات والدهون، فقد لا يناسب الرياضيين أو كبار السن. للتقييم الدقيق راجع طبيبك المختص.' },
];
const jsonLd = graph(
  webAppJsonLd({ name: tool.titleAr, description: tool.descAr, path: '/bmi/' }),
  faqJsonLd(faqs),
);
---
<ToolLayout title={tool.titleAr} description={tool.descAr} path="/bmi/" jsonLd={jsonLd}>
  <div class="tool-head">
    <span class="tool-head-chip"><Icon id={toolIconId(tool.slug)} size={28} /></span>
    <div class="tool-head-text">
      <h1>{tool.titleAr}</h1>
      <p class="tool-intro">{tool.descAr}</p>
    </div>
  </div>

  <div class="card">
    <div class="row">
      <div class="field"><label for="weight">الوزن (كجم)</label><input type="number" id="weight" inputmode="decimal" value="70" /></div>
      <div class="field"><label for="height">الطول (سم)</label><input type="number" id="height" inputmode="decimal" value="175" /></div>
    </div>
  </div>

  <div class="result" id="result">
    <div style="color:var(--color-text-muted)">مؤشر كتلة الجسم</div>
    <div class="result-main num" id="bmi-value">-</div>
    <div id="bmi-cat" style="font-weight:700;font-size:1.15rem"></div>
    <p class="error-text hidden" id="bmi-err">يرجى إدخال وزن وطول صحيحين لحساب مؤشر كتلة الجسم.</p>

    <div class="bmi-scale" id="bmi-scale" hidden>
      <div class="bmi-bar">
        <span class="seg bmi-seg-low"></span>
        <span class="seg bmi-seg-normal"></span>
        <span class="seg bmi-seg-over"></span>
        <span class="seg bmi-seg-obese"></span>
        <span class="bmi-marker" id="bmi-marker"></span>
      </div>
      <div class="bmi-scale-labels">
        <span style="width:14%">نحافة</span>
        <span style="width:26%">طبيعي</span>
        <span style="width:20%">زيادة</span>
        <span style="width:40%">سمنة</span>
      </div>
    </div>
  </div>

  <Disclaimer variant="health" />

  <Faq faqs={faqs} />

  <RelatedTools slugs={tool.related} />
</ToolLayout>

<script>
  import { bmi, bmiCategory } from '../../lib/health.js';
  const $ = (id) => document.getElementById(id);
  const val = (id) => parseFloat($(id).value);

  // 分类配色（与刻度条四段一致）：[文字色] 按 BMI 落入的档位。
  const catColor = (v) => v < 18.5 ? '#8A6516' : v < 25 ? '#0E5C40' : v < 30 ? '#9A5A1E' : '#9A3322';

  function run() {
    const v = bmi(val('weight'), val('height'));
    if (!Number.isFinite(v)) {
      $('bmi-value').textContent = '-';
      $('bmi-cat').textContent = '';
      $('bmi-scale').hidden = true;
      $('bmi-err').classList.remove('hidden');
      return;
    }
    $('bmi-err').classList.add('hidden');
    $('bmi-value').textContent = v;
    const cat = $('bmi-cat');
    cat.textContent = bmiCategory(v) ?? '';
    cat.style.color = catColor(v);
    // 指针位置：15–40 刻度，clamp 防溢出。
    const pos = Math.min(98, Math.max(2, (v - 15) / 25 * 100));
    $('bmi-marker').style.left = pos + '%';
    $('bmi-marker').style.borderColor = catColor(v);
    $('bmi-scale').hidden = false;
  }
  ['weight', 'height'].forEach((id) => $(id).addEventListener('input', run));
  run();
</script>
