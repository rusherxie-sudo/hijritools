---
import ToolLayout from '../../layouts/ToolLayout.astro';
import Icon from "../../components/Icon.astro";
import { toolIconId } from "../../data/icons.js";
import Faq from "../../components/Faq.astro";
import Disclaimer from '../../components/Disclaimer.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import { getTool } from '../../data/tools.js';
import { webAppJsonLd, faqJsonLd, graph } from '../../lib/seo.js';

const tool = getTool('water');
const faqs = [
  { q: 'كم لتر ماء أحتاج في اليوم؟', a: 'القاعدة التقريبية الشائعة هي نحو ٣٥ مل لكل كيلوغرام من وزنك. مثلًا من وزنه ٧٠ كجم يحتاج قرابة ٢٫٤٥ لتر يوميًا. تحسب الأداة الكمية باللتر وعدد الأكواب تلقائيًا.' },
  { q: 'هل أزيد كمية الماء عند الرياضة أو الحر؟', a: 'نعم. في أجواء الخليج الحارّة ومع التمارين أو التعرّق الشديد يحتاج الجسم كمية أكبر، فأضف نحو ٥٠٠ مل لكل ساعة نشاط مكثّف.' },
  { q: 'هل تُحسب القهوة والشاي ضمن الكمية؟', a: 'السوائل كلها تسهم في الترطيب، لكن يُفضّل أن يكون الماء النقي هو المصدر الأساسي، وتقليل المشروبات الغنية بالكافيين أو السكر.' },
  { q: 'ما هي علامات نقص شرب الماء؟', a: 'أبرز العلامات: جفاف الفم، لون البول الداكن، الصداع، الإرهاق، الدوخة، وجفاف الجلد. إذا لاحظت هذه الأعراض فاشرب كوبًا من الماء فورًا.' },
  { q: 'هل شرب الماء بكثرة مضر؟', a: 'الإفراط الشديد في شرب الماء (أكثر من ٣-٤ لترات في ساعة واحدة) قد يسبب تسمم الماء. لكن الاحتياج الطبيعي اليومي (٢-٣ لتر) آمن تمامًا لمعظم الناس.' },
  { q: 'كم كوب ماء يعادل اللتر؟', a: 'اللتر الواحد يعادل ٤ أكواب (الكوب = ٢٥٠ مل). فإذا كان احتياجك ٢ لتر يوميًا فهذا يعني ٨ أكواب.' },
  { q: 'متى أفضل وقت لشرب الماء خلال اليوم؟', a: 'يُفضل توزيع شرب الماء على مدار اليوم: كوب عند الاستيقاظ، كوب قبل كل وجبة، وكوب بين الوجبات. تجنبي شرب كميات كبيرة دفعة واحدة.' },
];
const jsonLd = graph(
  webAppJsonLd({ name: tool.titleAr, description: tool.descAr, path: '/water/' }),
  faqJsonLd(faqs),
);
---
<ToolLayout title={tool.titleAr} description={tool.descAr} path="/water/" jsonLd={jsonLd}>
  <div class="tool-head">
    <span class="tool-head-chip"><Icon id={toolIconId(tool.slug)} size={28} /></span>
    <div class="tool-head-text">
      <h1>{tool.titleAr}</h1>
      <p class="tool-intro">{tool.descAr}</p>
    </div>
  </div>

  <div class="card">
    <div class="field" style="max-width:280px">
      <label for="weight">الوزن (كجم)</label>
      <input type="number" id="weight" inputmode="decimal" value="70" />
    </div>
  </div>

  <div class="result" id="result">
    <div style="color:var(--color-text-muted)">احتياجك اليومي من الماء</div>
    <div class="result-main"><span class="num" id="liters">-</span> <span style="font-size:1rem">لتر/يوم</span></div>
    <hr class="gold-divider" />
    <div class="result-grid">
      <div class="stat"><div class="v num" id="ml">-</div><div class="l">مليلتر</div></div>
      <div class="stat"><div class="v num" id="cups">-</div><div class="l">كوب (٢٥٠ مل)</div></div>
    </div>
  </div>

  <Disclaimer variant="health" />

  <article class="prose" style="margin-block-start:var(--space-8)">
    <h2>كم لتر ماء تحتاج يوميًا؟ — الدليل الكامل</h2>
    <p>الماء هو أساس الحياة، وجسم الإنسان يتكون من حوالي ٦٠٪ ماء. تعتمد كمية الماء التي تحتاجها يوميًا على <strong>وزنك ومستوى نشاطك والمناخ</strong> الذي تعيش فيه. في دول الخليج ذات المناخ الحار، تزداد الحاجة للماء بشكل ملحوظ.</p>
    <p>القاعدة الطبية العامة: <strong>٣٥ مل من الماء لكل كيلوغرام من وزن الجسم</strong>. فإذا كان وزنك ٧٠ كجم، فأنت تحتاج حوالي ٢٫٤٥ لتر يوميًا (ما يعادل ١٠ أكواب).</p>
    <p>العوامل التي تزيد احتياجك للماء:</p>
    <ul>
      <li><strong>الرياضة والتمارين</strong> — أضف ٥٠٠ مل لكل ساعة نشاط.</li>
      <li><strong>الجو الحار</strong> — في الصيف الخليجي قد تحتاج ١-٢ لتر إضافي.</li>
      <li><strong>الحمل والرضاعة</strong> — تحتاج الحامل والمرضع حوالي ٣ لترات يوميًا.</li>
    </ul>
    <p>استخدم <a href="/bmi/">حاسبة مؤشر كتلة الجسم</a> لمعرفة إذا كان وزنك في المدى الصحي، ثم احسب احتياجك من الماء هنا.</p>

    <h2>جدول احتياجك من لتر ماء حسب وزن الجسم</h2>
    <p>إذا تساءلت يومًا «كم احتاج لتر ماء يوميًا؟»، فالإجابة تبدأ بمعرفة وزنك. القاعدة الطبية المعتمدة هي ٣٥ مل لكل كيلوغرام، ويلخّص الجدول التالي احتياجات الأوزان الشائعة:</p>
    <table>
      <thead>
        <tr><th>الوزن (كجم)</th><th>الكمية بالمل</th><th>عدد لتر ماء</th><th>عدد الأكواب (٢٥٠ مل)</th></tr>
      </thead>
      <tbody>
        <tr><td class="num">٥٠</td><td class="num">١٧٥٠</td><td class="num">١٫٧٥</td><td class="num">٧</td></tr>
        <tr><td class="num">٦٠</td><td class="num">٢١٠٠</td><td class="num">٢٫١٠</td><td class="num">٨</td></tr>
        <tr><td class="num">٧٠</td><td class="num">٢٤٥٠</td><td class="num">٢٫٤٥</td><td class="num">١٠</td></tr>
        <tr><td class="num">٨٠</td><td class="num">٢٨٠٠</td><td class="num">٢٫٨٠</td><td class="num">١١</td></tr>
        <tr><td class="num">٩٠</td><td class="num">٣١٥٠</td><td class="num">٣٫١٥</td><td class="num">١٣</td></tr>
        <tr><td class="num">١٠٠</td><td class="num">٣٥٠٠</td><td class="num">٣٫٥٠</td><td class="num">١٤</td></tr>
      </tbody>
    </table>
    <p>هذه القيم أساسية وتزداد بحسب النشاط والمناخ. لا تكفي معرفة الوزن وحده، إذ يُعدّ حساب الماء عملية دقيقة تشمل عوامل متعددة، ولذلك صُمّمت هذه الأداة لتمنحك نتيجة فورية وفق وزنك. كلما اقترب وزنك من <a href="/ideal-weight/">وزنك المثالي</a>، كان احتياجك من لتر ماء أكثر استقرارًا.</p>

    <h2>كم احتاج لتر ماء في دول الخليج ذات المناخ الحار؟</h2>
    <p>تتميّز دول الخليج العربي (السعودية، الإمارات، الكويت، قطر، البحرين، عُمان) بصيف حارّ تجاوزت درجات حرارته ٥٠ درجة مئوية في السنوات الأخيرة. في هذا المناخ القاسي يفقد الجسم كميات كبيرة من الماء عبر العرق حتى دون ممارسة الرياضة، ما يجعل حساب الماء أكثر أهمية من أي مكان آخر.</p>
    <p>توصيات خاصة لأهل الخليج:</p>
    <ul>
      <li><strong>الصيف (يونيو–سبتمبر):</strong> أضف ما لا يقل عن ١–٢ لتر ماء إضافي يوميًا فوق احتياجك الأساسي.</li>
      <li><strong>العمل في الهواء الطلق:</strong> اشرب كوبًا كل ٢٠ دقيقة، وتجنّب أوقات الذروة بين الظهيرة والعصر.</li>
      <li><strong>المكيّفات:</strong> الهواء الجاف داخل المباني يزيد فقدان الماء عبر الجلد والتنفس، فاحرص على كوب إضافي كل ساعتين.</li>
      <li><strong>رمضان في الصيف:</strong> وزّع شربك بين الإفطار والسحور، واجعل هدفك ٣ لترات على الأقل خارج فترة الصيام.</li>
    </ul>

    <h2>احتياج لتر ماء في الحالات الخاصة</h2>
    <h3>الرياضة والنشاط البدني</h3>
    <p>عند ممارسة التمارين الرياضية يفقد الجسم ماءً سريعًا عبر العرق والتنفّس المسرّع. يُنصح بشرب ٥٠٠ مل قبل الرياضة بساعتين، و٢٠٠ مل كل ١٥–٢٠ دقيقة أثناء التمرين، و٥٠٠ مل بعده لتعويض الفقد. للرياضيين المحترفين قد يصل الاحتياج إلى ٤–٥ لترات يوميًا. لمعرفة حرقك من السعرات حسب النشاط، استخدم <a href="/calories/">حاسبة السعرات الحرارية</a>، فكلما زاد الحرق زاد احتياجك للماء.</p>

    <h3>الحمل</h3>
    <p>تحتاج الحامل كميات أكبر من الماء لدعم تكوين السائل الأمنيوسي وزيادة حجم الدم وتغذية الجنين. التوصية اليومية نحو ٣ لترات (١٢–١٣ كوبًا). الجفاف أثناء الحمل قد يؤدي إلى مضاعفات خطيرة، لذا راقبي لون البول باستمرار، واجعلي حساب الماء جزءًا من روتينك اليومي.</p>

    <h3>الرضاعة</h3>
    <p>تُنتج المرضع قرابة ٧٥٠ مل من الحليب يوميًا، فتحتاج لتعويضها بشرب ٣ إلى ٣٫٥ لتر يوميًا. الشرب المنتظم قبل وبعد الرضاعة يحسّن إدرار الحليب ويحافظ على ترطيب الأم.</p>

    <h3>كبار السن</h3>
    <p>يقلّ إحساس العطش مع التقدّم في العمر، لذا قد لا يدرك كبار السن حاجتهم للماء. يجب الالتزام بجدول شرب منتظم لا يقل عن ١٫٥ لتر يوميًا حتى دون الشعور بالعطش.</p>

    <h2>نصائح عملية لزيادة تناول لتر ماء يوميًا</h2>
    <ul>
      <li>ابدأ يومك بكوب ماء فور الاستيقاظ لتنشيط الأعضاء.</li>
      <li>احمل زجاجة ماء معك أينما ذهبت لقياس حساب الماء بدقة.</li>
      <li>أضف شرائح الليمون أو النعناع لتحسين الطعم دون سعرات.</li>
      <li>اضبط تنبيهات في هاتفك كل ساعة لتذكيرك بالشرب.</li>
      <li>اشرب كوبًا قبل كل وجبة لتحسين الهضم والتحكّم بالشهية.</li>
    </ul>
    <p>للحصول على صورة شاملة عن صحتك، ابدأ بمعرفة <a href="/ideal-weight/">وزنك المثالي</a> ومؤشر كتلة الجسم، ثم احسب احتياجك من السعرات والماء، فالترطيب عنصر أساسي في أي خطة صحية متكاملة.</p>
  </article>

  <Faq faqs={faqs} />

  <RelatedTools slugs={tool.related} />
</ToolLayout>

<script>
  import { waterIntakeMl } from '../../lib/health.js';
  const $ = (id) => document.getElementById(id);

  function run() {
    const ml = waterIntakeMl(parseFloat($('weight').value));
    if (!Number.isFinite(ml)) {
      ['liters', 'ml', 'cups'].forEach((id) => { $(id).textContent = '-'; });
      return;
    }
    $('ml').textContent = Math.round(ml);
    $('liters').textContent = (Math.round(ml / 100) / 10).toFixed(1);
    $('cups').textContent = Math.round(ml / 250);
  }
  $('weight').addEventListener('input', run);
  run();
</script>
