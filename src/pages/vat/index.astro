---
import ToolLayout from '../../layouts/ToolLayout.astro';
import Icon from "../../components/Icon.astro";
import { toolIconId } from "../../data/icons.js";
import Faq from "../../components/Faq.astro";
import Disclaimer from '../../components/Disclaimer.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import { getTool } from '../../data/tools.js';
import { gccOrder, countries } from '../../data/countries.js';
import { vatRates } from '../../data/vat.js';
import { webAppJsonLd, faqJsonLd, graph } from '../../lib/seo.js';

const flags = { sa: '🇸🇦', ae: '🇦🇪', qa: '🇶🇦', kw: '🇰🇼', bh: '🇧🇭', om: '🇴🇲' };

const tool = getTool('vat');
const faqs = [
  { q: 'ما نسبة ضريبة القيمة المضافة في دول الخليج؟', a: 'السعودية ١٥٪، الإمارات ٥٪، البحرين ١٠٪، عُمان ٥٪، بينما لا تطبّقها قطر والكويت حاليًا.' },
  { q: 'كيف أستخرج الضريبة من سعر شامل؟', a: 'اختر دولتك ثم استخدم وضع «استخراج الضريبة» لإدخال السعر الشامل ومعرفة قيمة الضريبة والصافي.' },
  { q: 'كيف أضيف الضريبة إلى سعر صافٍ؟', a: 'اختر دولتك ثم استخدم وضع «إضافة الضريبة»: أدخل السعر الصافي لتظهر قيمة الضريبة والسعر الإجمالي الشامل.' },
];
const jsonLd = graph(
  webAppJsonLd({ name: tool.titleAr, description: tool.descAr, path: '/vat/' }),
  faqJsonLd(faqs),
);
---
<ToolLayout title={tool.titleAr} description={tool.descAr} path="/vat/" jsonLd={jsonLd}>
  <div class="tool-head">
    <span class="tool-head-chip"><Icon id={toolIconId(tool.slug)} size={28} /></span>
    <div class="tool-head-text">
      <h1>{tool.titleAr}</h1>
      <p class="tool-intro">{tool.descAr}</p>
    </div>
  </div>

  <ul class="vat-cards">
    {gccOrder.map((cc) => (
      <li>
        <a class="vat-card" href={`/vat/${cc}/`}>
          <span class="vat-flag">{flags[cc]}</span>
          <span class="vat-card-text">
            <span class="vat-name">{countries[cc].nameAr}</span>
            <span class="vat-rate">{vatRates[cc].rate > 0 ? `نسبة الضريبة ${vatRates[cc].rate}%` : 'غير مطبقة حاليًا'}</span>
          </span>
          <Icon id="ico-chev" size={18} class="vat-chev" />
        </a>
      </li>
    ))}
  </ul>

  <Disclaimer variant="regulatory" />

  <Faq faqs={faqs} />

  <RelatedTools slugs={tool.related} />
</ToolLayout>
