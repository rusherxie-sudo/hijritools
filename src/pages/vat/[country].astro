---
import ToolLayout from '../../layouts/ToolLayout.astro';
import Faq from "../../components/Faq.astro";
import Disclaimer from '../../components/Disclaimer.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import CountrySwitcher from '../../components/CountrySwitcher.astro';
import { getTool } from '../../data/tools.js';
import { countries } from '../../data/countries.js';
import { vatRates } from '../../data/vat.js';
import { webAppJsonLd, faqJsonLd, graph } from '../../lib/seo.js';

// 每个国家自动生成一页（法规工具的国家一等维度）。
export function getStaticPaths() {
  const tool = getTool('vat');
  return tool.countries.map((cc) => ({ params: { country: cc } }));
}

const { country } = Astro.params;
const tool = getTool('vat');
const c = countries[country];
const rate = vatRates[country];

const title = `حاسبة ضريبة القيمة المضافة (VAT) في ${c.nameAr}`;
const description = `احسب ضريبة القيمة المضافة (VAT) في ${c.nameAr} (${rate.rate}٪): أضف الضريبة إلى السعر أو استخرجها من السعر الشامل بالعملة المحلية.`;
const faqs = rate.rate > 0
  ? [
      { q: `كم نسبة ضريبة القيمة المضافة في ${c.nameAr}؟`, a: `النسبة ${rate.rate}٪ وفق ${rate.source}.` },
      { q: `كيف أضيف ضريبة القيمة المضافة إلى السعر في ${c.nameAr}؟`, a: `اضرب السعر الصافي في ${rate.rate}٪ وأضف الناتج إلى السعر، أو استخدم خيار «إضافة الضريبة» في الحاسبة أعلاه ليحسبها لك تلقائيًا.` },
      { q: `كيف أستخرج قيمة الضريبة من السعر الشامل؟`, a: `اقسم السعر الشامل على ${(1 + rate.rate / 100).toFixed(2)} للحصول على السعر الصافي، والفرق بينهما هو قيمة الضريبة. أو اختر «استخراج الضريبة» في الحاسبة.` },
    ]
  : [
      { q: `هل تُطبَّق ضريبة القيمة المضافة في ${c.nameAr}؟`, a: `لا، لا تُطبَّق ضريبة القيمة المضافة في ${c.nameAr} حاليًا وفق ${rate.source}، لذا السعر الشامل يساوي السعر الصافي.` },
      { q: `هل قد تُفرض الضريبة مستقبلًا في ${c.nameAr}؟`, a: `قد تتغيّر الأنظمة الضريبية مع الوقت؛ يُنصح بمراجعة الجهة الرسمية في ${c.nameAr} للتأكد من آخر التحديثات.` },
    ];
const jsonLd = graph(
  webAppJsonLd({ name: title, description, path: `/vat/${country}/` }),
  faqJsonLd(faqs),
);
---
<ToolLayout title={title} description={description} path={`/vat/${country}/`} jsonLd={jsonLd}>
  <h1>{title}</h1>
  <p class="tool-intro">{description}</p>

  <CountrySwitcher toolSlug="vat" countryCodes={tool.countries} active={country} />

  {rate.rate > 0 ? (
    <div class="card">
      <div class="row">
        <div class="field">
          <label for="amount">المبلغ ({c.currencyAr})</label>
          <input type="number" id="amount" value="100" min="0" data-rate={rate.rate} />
        </div>
        <div class="field" style="flex:0 1 200px">
          <label for="mode">العملية</label>
          <select id="mode">
            <option value="add">إضافة الضريبة (السعر صافٍ)</option>
            <option value="remove">استخراج الضريبة (السعر شامل)</option>
          </select>
        </div>
      </div>
      <p style="color:var(--color-text-muted)">النسبة المطبّقة: <strong class="num">{rate.rate}٪</strong></p>

      <div class="result" id="result">
        <div class="result-grid">
          <div class="stat"><div class="v num" id="net">0</div><div class="l">الصافي</div></div>
          <div class="stat"><div class="v num" id="vat">0</div><div class="l">الضريبة ({rate.rate}٪)</div></div>
          <div class="stat"><div class="v num" id="gross">0</div><div class="l">الإجمالي الشامل</div></div>
        </div>
      </div>
    </div>
  ) : (
    <div class="card">
      <p>لا تُطبّق <strong>{c.nameAr}</strong> ضريبة القيمة المضافة حاليًا، لذا يساوي السعر الشامل السعر الصافي.</p>
      <p style="color:var(--color-text-muted)">{rate.source}</p>
    </div>
  )}

  <Disclaimer variant="regulatory" />

  <!-- المحتوى التعليمي -->
  <div class="card tool-guide">
    <h2>ما هي ضريبة القيمة المضافة (VAT)؟</h2>
    <p>ضريبة القيمة المضافة هي ضريبة غير مباشرة تفرض على معظم السلع والخدمات. يدفعها المستهلك النهائي، بينما تقوم الشركات بجبايتها وتوريدها للجهات الضريبية. تختلف النسبة من دولة لأخرى.</p>

    <h2>نسب ضريبة القيمة المضافة في دول الخليج</h2>
    <table style="width:100%;text-align:right;direction:rtl">
      <thead><tr><th>الدولة</th><th>النسبة</th><th>سنة التطبيق</th></tr></thead>
      <tbody>
        <tr><td>السعودية</td><td class="num">١٥٪</td><td>٢٠٢٠</td></tr>
        <tr><td>الإمارات</td><td class="num">٥٪</td><td>٢٠١٨</td></tr>
        <tr><td>البحرين</td><td class="num">١٠٪</td><td>٢٠١٩</td></tr>
        <tr><td>عُمان</td><td class="num">٥٪</td><td>٢٠٢١</td></tr>
        <tr><td>قطر</td><td class="num">٠٪</td><td>—</td></tr>
        <tr><td>الكويت</td><td class="num">٠٪</td><td>—</td></tr>
      </tbody>
    </table>

    <h2>كيف تحسب الضريبة؟</h2>
    <p><strong>إضافة الضريبة:</strong> السعر الصافي × (١ + نسبة الضريبة/١٠٠) = السعر الشامل. مثلًا: ١٠٠ × ١.١٥ = ١١٥ ريال (بضريبة ١٥٪).</p>
    <p><strong>استخراج الضريبة:</strong> السعر الشامل ÷ (١ + نسبة الضريبة/١٠٠) = السعر الصافي. مثلًا: ١١٥ ÷ ١.١٥ = ١٠٠ ريال صافٍ، قيمة الضريبة = ١٥ ريال.</p>

    <h2>ما السلع المعفاة؟</h2>
    <p>تعفى بعض السلع والخدمات من الضريبة، منها: التعليم الأساسي، الرعاية الصحية، وتأجير العقارات السكنية. تحقق من الجهات الرسمية في دولتك.</p>

    <h2>مصدر البيانات</h2>
    <p>{rate.source}</p>
  </div>

  <Faq faqs={faqs} />

  <RelatedTools slugs={tool.related} />
</ToolLayout>

<script>
  import { addVat, removeVat } from '../../lib/vat.js';
  const $ = (id) => document.getElementById(id);
  const amountEl = $('amount');
  if (amountEl) {
    const rate = parseFloat(amountEl.dataset.rate) || 0;
    const run = () => {
      const amount = parseFloat(amountEl.value) || 0;
      const r = $('mode').value === 'remove' ? removeVat(amount, rate) : addVat(amount, rate);
      $('net').textContent = r.net.toLocaleString('en-US');
      $('vat').textContent = r.vat.toLocaleString('en-US');
      $('gross').textContent = r.gross.toLocaleString('en-US');
    };
    amountEl.addEventListener('input', run);
    $('mode').addEventListener('change', run);
    run();
  }
</script>
