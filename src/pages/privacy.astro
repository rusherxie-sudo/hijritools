---
import ToolLayout from '../layouts/ToolLayout.astro';
import { graph } from '../lib/seo.js';

const title = 'سياسة الخصوصية';
const description = 'سياسة خصوصية HijriTools: كيف نتعامل مع ملفات تعريف الارتباط وإعلانات Google AdSense وتحليلات Google، وكيف يمكنك ضبط تفضيلات الإعلانات وإلغاء الاشتراك في التتبّع.';
---
<ToolLayout title={title} description={description} path="/privacy/" jsonLd={graph()}>
  <h1>سياسة الخصوصية</h1>
  <section class="prose">
    <p style="color:var(--color-text-muted)">آخر تحديث: يونيو 2026</p>
    <p>
      تشرح هذه السياسة كيف يتعامل موقع HijriTools مع المعلومات عند استخدامك للموقع.
      باستخدامك الموقع فإنك توافق على ما ورد في هذه السياسة.
    </p>

    <h2>المعلومات التي نجمعها</h2>
    <p>
      لا يتطلّب الموقع إنشاء حساب أو تسجيل دخول. تتم جميع الحسابات داخل متصفحك، ولا نخزّن
      المبالغ أو التواريخ أو البيانات التي تُدخلها في الأدوات على خوادمنا. وقد نجمع بيانات
      إحصائية مجهّلة عن الزيارات (مثل الصفحات المزارة ونوع الجهاز) لتحسين الموقع.
    </p>

    <h2>ملفات تعريف الارتباط (Cookies)</h2>
    <p>
      يستخدم الموقع وشركاؤه ملفات تعريف الارتباط وتقنيات مشابهة لتشغيل الموقع وقياس الأداء
      وعرض الإعلانات. يمكنك ضبط متصفحك لرفض ملفات تعريف الارتباط، لكن قد يؤثّر ذلك على بعض الوظائف.
    </p>

    <h2>إعلانات Google AdSense</h2>
    <p>نستخدم خدمة Google AdSense لعرض الإعلانات. تستعين Google والشركاء الإعلانيون بملفات تعريف الارتباط لعرض إعلانات بناءً على زياراتك السابقة لهذا الموقع ولمواقع أخرى:</p>
    <ul>
      <li>تستخدم Google ملفات تعريف ارتباط خاصة بالإعلانات (مثل ملف DoubleClick/DART) لعرض إعلانات مبنية على اهتماماتك وزياراتك السابقة.</li>
      <li>تستخدم الجهات الإعلانية الخارجية (الطرف الثالث) ملفات تعريف الارتباط لعرض إعلانات مخصَّصة بناءً على زياراتك لهذا الموقع ولمواقع أخرى.</li>
    </ul>

    <h2>تحليلات Google (Google Analytics 4)</h2>
    <p>
      نستخدم Google Analytics 4 لقياس عدد الزيارات وسلوك التصفّح بشكل مجمّع ومجهّل، بهدف تحسين
      المحتوى والأدوات. لا تُستخدم هذه البيانات لتحديد هويتك الشخصية.
    </p>

    <h2>خياراتك والتحكّم في الإعلانات</h2>
    <ul>
      <li>يمكنك إيقاف الإعلانات المخصّصة من <a href="https://www.google.com/settings/ads" target="_blank" rel="noopener nofollow">إعدادات إعلانات Google</a>.</li>
      <li>يمكنك إلغاء الاشتراك في الإعلانات المبنية على الاهتمامات من الجهات الإعلانية الخارجية عبر <a href="https://www.aboutads.info/choices/" target="_blank" rel="noopener nofollow">www.aboutads.info/choices</a>.</li>
      <li>يمكنك إدارة ملفات تعريف الارتباط أو حذفها من إعدادات متصفّحك في أي وقت.</li>
    </ul>

    <h2>روابط الطرف الثالث</h2>
    <p>
      قد يحتوي الموقع على روابط لمواقع خارجية لا نتحكّم في سياسات خصوصيتها، وننصح بمراجعة سياسة
      الخصوصية الخاصة بكل موقع تزوره.
    </p>

    <h2>التعديلات على هذه السياسة</h2>
    <p>قد نحدّث سياسة الخصوصية من وقت لآخر، وسنُعلم المستخدمين بأي تغيير جوهري يطرأ عليها عبر تحديث هذه الصفحة.</p>

    <h2>التواصل</h2>
    <p>لأي استفسار حول الخصوصية، راسلنا على <a href="mailto:contact@hijritools.com">contact@hijritools.com</a>.</p>
  </section>
</ToolLayout>
