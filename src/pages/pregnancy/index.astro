---
import ToolLayout from '../../layouts/ToolLayout.astro';
import Icon from "../../components/Icon.astro";
import { toolIconId } from "../../data/icons.js";
import Faq from "../../components/Faq.astro";
import Disclaimer from '../../components/Disclaimer.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import { getTool } from '../../data/tools.js';
import { webAppJsonLd, faqJsonLd, graph } from '../../lib/seo.js';

const tool = getTool('pregnancy');
const faqs = [
  { q: 'كيف أحسب الحمل بالهجري؟', a: 'أدخلي تاريخ أول يوم في آخر دورة شهرية بالتقويم الهجري أو الميلادي، وتحسب الحاسبة موعد الولادة المتوقع وعمر الحمل بالتقويمين.' },
  { q: 'كيف يُحسب موعد الولادة؟', a: 'بإضافة ٢٨٠ يومًا (٤٠ أسبوعًا) إلى أول يوم في آخر دورة شهرية، وفق قاعدة نيجيله (Naegele).' },
  { q: 'هل النتيجة مؤكدة؟', a: 'النتيجة تقديرية. تختلف مدة الحمل بين النساء، ويبقى تقدير الطبيب بالموجات فوق الصوتية هو الأدق.' },
  { q: 'كيف يُحسب عمر الحمل بالأسابيع؟', a: 'يُحسب بعدد الأيام من أول يوم في آخر دورة شهرية حتى اليوم مقسومًا على ٧، وتعرضه الحاسبة تلقائيًا بالأسابيع والأيام.' },
  { q: 'ما هي مراحل الحمل الثلاثة (الثلوث)؟', a: 'الثلث الأول من الأسبوع ١ إلى ١٣، والثلث الثاني من الأسبوع ١٤ إلى ٢٧، والثلث الثالث من الأسبوع ٢٨ حتى الولادة. لكل ثلث تغيّراته الخاصة بك وبطفلك.' },
  { q: 'هل موعد الولادة يختلف بالتقويم الهجري؟', a: 'لا يختلف الموعد الفعلي للولادة سواء بالتقويم الهجري أو الميلادي. حاسبتنا تعرض الموعد بالتقويمين لراحتك، وغالبًا ما تفضل الأمهات في الخليج معرفة التاريخ الهجري لتسجيل المولود.' },
  { q: 'متى يجب مراجعة الطبيبة أثناء الحمل؟', a: 'يُنصح بزيارة الطبيبة فور تأكيد الحمل، ثم بانتظام حسب جدول المتابعة (كل ٤ أسابيع في الثلث الأول والثاني، وكل أسبوعين في الثلث الثالث).' },
];
const jsonLd = graph(
  webAppJsonLd({ name: tool.titleAr, description: tool.descAr, path: '/pregnancy/' }),
  faqJsonLd(faqs),
);
---
<ToolLayout title={tool.titleAr} description={tool.descAr} path="/pregnancy/" jsonLd={jsonLd}>
  <div class="tool-head">
    <span class="tool-head-chip"><Icon id={toolIconId(tool.slug)} size={28} /></span>
    <div class="tool-head-text">
      <h1>{tool.titleAr}</h1>
      <p class="tool-intro">{tool.descAr}</p>
    </div>
  </div>

  <div class="card">
    <div class="field" style="max-width:280px">
      <label for="lmp">أول يوم في آخر دورة شهرية</label>
      <input type="date" id="lmp" />
    </div>
    <button class="btn" id="calc">احسبي</button>
  </div>

  <div class="result hidden" id="result">
    <div style="color:var(--color-text-muted)">موعد الولادة المتوقع</div>
    <div class="result-main num" id="due">-</div>
    <div class="num" id="due-hijri" style="color:var(--color-primary-dark)"></div>
    <hr class="gold-divider" />
    <div class="result-grid">
      <div class="stat"><div class="v" id="gest">-</div><div class="l">عمر الحمل الحالي</div></div>
      <div class="stat"><div class="v num" id="trimester">-</div><div class="l">الثلث</div></div>
      <div class="stat"><div class="v num" id="remaining">-</div><div class="l">يوم متبقٍ</div></div>
    </div>
  </div>

  <Disclaimer variant="health" />

  <article class="prose" style="margin-block-start:var(--space-8)">
    <h2>كيف تعمل حاسبة الحمل؟</h2>
    <p>تعتمد حاسبة الحمل على قاعدة نيجيله (Naegele's Rule): يُضاف ٢٨٠ يومًا (٤٠ أسبوعًا) إلى أول يوم في آخر دورة شهرية (LMP). هذه الطريقة القياسية التي تستخدمها الطبيبات والأطباء حول العالم لحساب الموعد المتوقع للولادة.</p>
    <p>مهم: تاريخ أول يوم في آخر دورة ≠ تاريخ الإباضة أو الحمل الفعلي. الاختلاف بيوم أو أيام أمر طبيعي.</p>

    <h2>فائدة حساب الحمل بالتقويمين</h2>
    <p>كثير من الأمهات في دول الخليج يفضّلن معرفة موعد الولادة بالتقويم الهجري لتسجيل المولود لدى الجهات الرسمية (التجنيد، الجوازات، القطاع الصحي). حاسبتنا تعرض الموعد بالتقويمين معًا لراحتك.</p>

    <h2>مراحل الحمل الثلاثة</h2>
    <ul>
      <li><strong>الثلث الأول (الأسبوع ١–١٣):</strong> تكوّن أعضاء الجنين، فترة أعلى خطر للإجهاض. النصائح: تناول حمض الفوليك، تجنب الأدوية دون استشارة الطبيبة.</li>
      <li><strong>الثلث الثاني (الأسبوع ١٤–٢٧):</strong> حركة الجنين تبدأ، نمو سريع. النصائح: فحص سكر الحمل (الأسبوع ٢٤–٢٨)، متابعة التغذية.</li>
      <li><strong>الثلث الثالث (الأسبوع ٢٨–٤٠):</strong> اكتمال رئتي الجنين، استعدادات الولادة. النصائح: متابعة حركة الجنين يوميًا، تجهيز حقيبة المستشفى.</li>
    </ul>

    <h2>متى يجب مراجعة الطبيبة؟</h2>
    <ul>
      <li>نزيف مهبلي غير طبيعي —فورًا</li>
      <li>صداع شديد أو تشوش في الرؤية —فورًا</li>
      <li>انخفاض حركة الجنين عن المعتاد —خلال ٢٤ ساعة</li>
      <li>انفجار ماء الرشح —فورًا</li>
      <li>تقلصات منتظمة قبل الأسبوع ٣٧ — قد تكون ولادة مبكرة</li>
    </ul>

    <h2>مميزات حاسبتنا</h2>
    <ul>
      <li><strong>التقويم الهجري والميلادي معًا</strong> — يظهر موعد الولادة وعمر الحمل بالتقويمين، مما يناسب الأمهات في دول الخليج اللواتي يسجّلن المواليد بالتاريخ الهجري.</li>
      <li><strong>عمر الحمل بالأسابيع والأيام</strong> — تعرفي بالضبط في أي أسبوع أنت وكم يومًا متبقيًا.</li>
      <li><strong>تحديد الثلث</strong> — تعرض الحاسبة في أي ثلث من الحمل أنت حاليًا (الأول، الثاني، أو الثالث).</li>
    </ul>
    <p>للحصول على أدق نتيجة، تأكدي من إدخال <strong>أول يوم في آخر دورة شهرية</strong> وليس تاريخ الإباضة أو التلقيح. كما يمكنك استخدام <a href="/ovulation/">حاسبة التبويض</a> لمعرفة أيام الخصوبة المثلى إذا كنت تخططين للحمل.</p>

    <h2>حساب الحمل بالهجري: لماذا وكيف؟</h2>
    <p>كثير من الأمهات في المملكة العربية السعودية ودول مجلس التعاون الخليجي يبحثن عن طريقة <strong>حساب الحمل بالهجري</strong> لأن الأوراق الرسمية ووثائق تسجيل المواليد تعتمد التقويم الهجري. حاسبتنا تتيح لك إدخال تاريخ أول يوم في آخر دورة شهرية، فتُخرج لكِ موعد الولادة المتوقع وعمر الحمل بالتقويمين الهجري والميلادي معًا، دون الحاجة إلى أي تحويل يدوي.</p>
    <p>طريقة <strong>حساب حمل هجري</strong> لا تختلف من حيث المبدأ عن الحساب بالميلادي: يُضاف ٢٨٠ يومًا (أي ٤٠ أسبوعًا) إلى تاريخ أول يوم في آخر دورة شهرية وفق قاعدة نيجيله. الفرق فقط في التقويم المستخدم للعرض. وعند الرغبة في <strong>حساب الحمل ب الهجري</strong> بمعرفة الأشهر الهجرية التي تمر خلال فترة الحمل، تُحوَّل التواريخ الميلادية إلى هجرية عبر تقويم أم القر المعتمد رسميًا في المملكة العربية السعودية، وهو ما تعتمده حاسبتنا تلقائيًا.</p>

    <h2>كيف تُحوَّل تواريخ الحمل بين الهجري والميلادي؟</h2>
    <p>يعتمد التحويل بين التقويمين على تقويم أم القر، وهو التقويم الرسمي في المملكة العربية السعودية. السنة الهجرية أقصر من الميلادية بحوالي ١١ يومًا، لذا فإن مدة الحمل الكاملة (٢٨٠ يومًا) تساوي تقريبًا ٩ أشهر هجرية و٨–١٢ يومًا. يمكنك استخدام <a href="/hijri/">حاسبة تحويل التواريخ بين الهجري والميلادي</a> لتحويل أي تاريخ طبي بين التقويمين بدقة، سواء كان تاريخ آخر دورة شهرية أو موعد الولادة المتوقع أو تاريخ فحص سكر الحمل.</p>
    <p>عند إدخال التاريخ بالميلادي في حاسبة الحمل، تُجرى العملية الحسابية (إضافة ٢٨٠ يومًا) ثم تُعرض النتيجة بالتقويمين. هذا يضمن دقة الحساب بغض النظر عن التقويم الذي تختارينه للإدخال، ويتيح لكِ متابعة الحمل بالهجري بسهولة تامة.</p>

    <h2>أشهر الحمل الهجرية وتطابقها مع مراحل الحمل</h2>
    <p>يمر الحمل الكامل بـ ٩ أشهر ميلادية تقريبًا، أي ما يعادل ٩ أشهر هجرية و٨–١٢ يومًا. وبما أن السنة الهجرية تختلف عن الميلادية، فإن أسماء الأشهر الهجرية التي يمر بها الحمل تختلف من امرأة لأخرى حسب تاريخ بداية الحمل. فيما يلي تطابق تقريبي بين الأشهر الهجرية ومراحل الحمل:</p>
    <ul>
      <li><strong>الشهران الهجريان الأول والثاني:</strong> يتوافقان مع بداية الثلث الأول من الحمل، وتشمل فترة تكوّن الأعضاء الأساسية للجنين (القلب، الدماغ، الحبل الشوكي).</li>
      <li><strong>الشهور الهجرية الثالث إلى الخامس:</strong> تتوافق مع نهاية الثلث الأول والثلث الثاني، وتبدأ فيها حركة الجنين وتتضح معالمه في الفحوصات.</li>
      <li><strong>الشهور الهجرية السادس إلى التاسع:</strong> تتوافق مع نهاية الثلث الثاني والثلث الثالث، وفترة اكتمال نمو رئتي الجنين واستعدادات الولادة.</li>
    </ul>
    <p>تعرض حاسبتنا الشهر الهجري الحالي للحمل تلقائيًا، فلا حاجة لتحويل التاريخ يدويًا في كل زيارة طبية.</p>

    <h2>حساب الحمل في السعودية ودول الخليج: تسجيل المواليد بالهجري</h2>
    <p>في المملكة العربية السعودية، تُسجَّل جميع وثائق المواليد الرسمية بالتاريخ الهجري، بما في ذلك شهادة الميلاد الصادرة عن الأحوال المدنية، وملف الطفل الصحي في المستشفى، وبطاقة الأحوال، والجواز السعودي، ووثائق التأمين الصحي. لذلك تُعدّ معرفة <strong>حساب الحمل بالهجري</strong> ضرورة عملية لكل أم سعودية أو مقيمة، لأن موعد الولادة المتوقع بالهجري يُدوَّن في الملف الطبي منذ الزيارة الأولى.</p>
    <p>أما دول الخليج الأخرى —الإمارات، الكويت، قطر، البحرين، سلطنة عُمان— فتعتمد الهجري في كثير من وثائقها الرسمية إلى جانب الميلادي، خاصة في القطاعات الدينية والقضائية وبعض الإجراءات الصحية. لذا، عند توقع موعد الولادة، يُفضّل معرفة التاريخ الهجري المتوقع مسبقًا لتجهيز الأوراق اللازمة. حاسبتنا تعرض موعد الولادة بالتقويمين لتسهيل هذه العملية. كما يمكنك بعد الولادة استخدام <a href="/age/">حاسبة العمر بالهجري والميلادي</a> لمتابعة عمر طفلك بالتقويمين بدقة.</p>

    <h2>الأثلاث الثلاثة من الحمل بالتقويم الهجري</h2>
    <p>ينقسم الحمل إلى ثلاثة أثلاث (Trimesters)، ولكل ثلث خصائصه وتطوراته الخاصة. فيما يلي شرح مفصّل لكل ثلث مع التطابق التقريبي مع التقويم الهجري:</p>

    <h3>الثلث الأول (الأسبوع ١–١٣)</h3>
    <p>يبدأ من أول يوم في آخر دورة شهرية ويمتد لـ ١٣ أسبوعًا (نحو ٣ أشهر هجرية). في هذه المرحلة يتكوّن الكيس الأمنيوسي والمشيمة، وتبدأ الأعضاء الأساسية كالقلب والدماغ بالتكوّن، ويُسمع نبض قلب الجنين من الأسبوع السادس تقريبًا. قد تظهر أعراض الغثيان والتعب وتغيرات الثدي. يُنصح بتناول حمض الفوليك وتجنب الأدوية دون استشارة الطبيبة، وتُعدّ هذه الفترة الأكثر حساسية للإجهاض.</p>

    <h3>الثلث الثاني (الأسبوع ١٤–٢٧)</h3>
    <p>يمتد من الأسبوع ١٤ إلى ٢٧ (نحو ٣ أشهر هجرية). تبدأ حركة الجنين وتُحس بها الأم عادةً من الأسبوع ١٨–٢٢، ويُجرى الفحص التفصيلي بالموجات فوق الصوتية (Anatomy Scan) بين الأسبوعين ١٨ و٢٢ لاستبعاد التشوهات الخلقية، كما يُجرى فحص سكر الحمل بين الأسبوعين ٢٤ و٢٨. عادة ما تتحسن أعراض الغثيان وتعود الطاقة للأم في هذه المرحلة.</p>

    <h3>الثلث الثالث (الأسبوع ٢٨–٤٠)</h3>
    <p>يمتد من الأسبوع ٢٨ حتى الولادة (نحو ٣ أشهر هجرية و٨–١٢ يومًا). تكتمل رئتا الجنين ويزداد وزنه بسرعة، وتُجرى متابعة دقيقة لحركة الجنين كل يوم، وتُجهَّز حقيبة المستشفى وخطة الولادة. تزداد الزيارات الطبية في هذه المرحلة (كل أسبوعين ثم كل أسبوع قرب الموعد المتوقع)، وقد تظهر تقلصات براكستون هيكس التدريبية.</p>

    <h2>نصائح عملية لمتابعة الحمل بالهجري</h2>
    <ul>
      <li>سجّلي تاريخ أول يوم في آخر دورة شهرية بالتقويمين الهجري والميلادي للحصول على أدق حساب.</li>
      <li>استخدمي <a href="/hijri/">حاسبة التحويل بين الهجري والميلادي</a> لتحويل أي تاريخ طبي بين التقويمين (فحوصات، مواعيد زيارات، نتائج تحاليل).</li>
      <li>استخدمي <a href="/ovulation/">حاسبة التبويض</a> للتخطيط للحمل في المستقبل ومعرفة أيام الخصوبة المثلى.</li>
      <li>تابعي عمر الجنين بالأسابيع والأيام في كل زيارة طبية، فهو الأدق طبيًا.</li>
      <li>احتفظي بموعد الولادة المتوقع بالتقويمين لتسهيل تسجيل المولود في الأحوال المدنية بعد الولادة.</li>
    </ul>
    <p>النتيجة التي تقدمها الحاسبة تقديرية وليست بديلًا عن المتابعة الطبية. يبقى تقدير الطبيبة بالموجات فوق الصوتية هو الأدق، خاصة في الثلث الأول، وقد يختلف موعد الولادة الفعلي عن المتوقع بأسبوعين قبلًا أو بعدًا.</p>
  </article>

  <Faq faqs={faqs} />

  <RelatedTools slugs={tool.related} />
</ToolLayout>

<script>
  import { pregnancyFromLMP } from '../../lib/pregnancy.js';
  import { formatGregorian, formatHijri } from '../../lib/hijri.js';
  import { parseISODate, todayUtc } from '../../lib/date-utils.js';

  const $ = (id) => document.getElementById(id);
  function run() {
    const lmp = parseISODate($('lmp').value);
    const res = $('result');
    if (!lmp) { res.classList.add('hidden'); return; }
    const r = pregnancyFromLMP(lmp, todayUtc(), 0);
    $('due').textContent = formatGregorian(r.dueDate);
    $('due-hijri').textContent = formatHijri(r.dueDateHijri);
    $('gest').textContent = `${r.gestationalAge.weeks} أسبوع ${r.gestationalAge.days} يوم`;
    $('trimester').textContent = r.trimester;
    $('remaining').textContent = Math.max(0, r.daysRemaining);
    res.classList.remove('hidden');
  }
  $('calc').addEventListener('click', run);
  $('lmp').addEventListener('change', run);
</script>
