---
import ToolLayout from '../../layouts/ToolLayout.astro';
import Faq from "../../components/Faq.astro";
import Disclaimer from '../../components/Disclaimer.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import { getTool } from '../../data/tools.js';
import { buildHijriYear } from '../../lib/calendar.js';
import { WEEKDAYS_AR } from '../../lib/hijri.js';
import { webAppJsonLd, faqJsonLd, graph } from '../../lib/seo.js';

// 多年年历：1448 为当前年（主推），保留 1447，预铺 1449。
export function getStaticPaths() {
  return [
    { params: { hy: '1448' } },
    { params: { hy: '1447' } },
    { params: { hy: '1449' } },
  ];
}

const { hy } = Astro.params;
const hyNum = Number(hy);
const year = buildHijriYear(hyNum); // 构建期执行，结果直接进 HTML（零客户端 JS）
const tool = getTool('calendar');

// 周日起的短星期名（网格表头）。
const SHORT_WEEKDAYS = ['أحد', 'اثنين', 'ثلاثاء', 'أربعاء', 'خميس', 'جمعة', 'سبت'];

// 某月公历跨度标签（如「٢٦ يونيو - ٢٤ يوليو ٢٠٢٥»）。
function gregRange(m) {
  const a = m.days[0], b = m.days[m.days.length - 1];
  const ay = a.greg.y, by = b.greg.y;
  const left = a.gregLabel;
  const right = by !== ay ? `${b.gregLabel} ${by}` : `${b.gregLabel} ${by}`;
  return ay !== by ? `${left} ${ay} – ${right}` : `${left} – ${right}`;
}

const title = hy === '1448'
  ? `التقويم الهجري ${hy} هـ — العام الهجري الحالي`
  : `التقويم الهجري ${hy} هـ`;
const description = `التقويم الهجري لعام ${hy} هـ كاملًا بالأشهر والأيام والمناسبات الإسلامية وما يقابلها بالتقويم الميلادي، وفق تقويم أم القرى. اعرف بداية الأشهر والأعياد.`;

// FAQ 直接给关键节日的公历答案，吃问句长尾。
const ramadan = year.months[8].days[0];   // 1 رمضان
const fitr = year.months[9].days[0];       // 1 شوال
const adha = year.months[11].days[9];      // 10 ذو الحجة
const faqs = [
  { q: `متى رمضان ${hy}؟`, a: `يبدأ شهر رمضان ${hy} هـ يوم ${ramadan.gregLabel} ${ramadan.greg.y} م تقريبًا وفق تقويم أم القرى، وقد يختلف يومًا حسب رؤية الهلال.` },
  { q: `متى عيد الفطر ${hy}؟`, a: `عيد الفطر ${hy} هـ يوافق ${fitr.gregLabel} ${fitr.greg.y} م تقريبًا.` },
  { q: `متى عيد الأضحى ${hy}؟`, a: `عيد الأضحى ${hy} هـ (١٠ ذو الحجة) يوافق ${adha.gregLabel} ${adha.greg.y} م تقريبًا.` },
];

const jsonLd = graph(
  webAppJsonLd({ name: title, description, path: `/calendar/${hy}/` }),
  faqJsonLd(faqs),
);
---
<ToolLayout title={title} description={description} path={`/calendar/${hy}/`} jsonLd={jsonLd} wide>
  <h1>التقويم الهجري {hy} هـ</h1>
  <p class="tool-intro">{description}</p>

  <nav class="cal-years" aria-label="سنوات هجرية أخرى">
    {['1447', '1448', '1449'].map((y) => (
      y === hy
        ? <span class="cal-year-cur num" aria-current="page">{y} هـ</span>
        : <a href={`/calendar/${y}/`} class="num">{y} هـ</a>
    ))}
  </nav>

  <div class="cal-year">
    {year.months.map((m) => (
      <section class="cal-month">
        <h2 id={`month-${m.hm}`}>
          {m.monthName} {hy}
          {m.sacred && <span class="cal-sacred">🕌 شهر حرام</span>}
        </h2>
        <div class="cal-sub">{gregRange(m)}</div>
        <div class="cal-grid">
          {SHORT_WEEKDAYS.map((w) => (<div class="cal-head">{w}</div>))}
          {Array.from({ length: m.firstWeekday }).map(() => (<div class="cal-empty"></div>))}
          {m.days.map((d) => (
            <div class={`cal-day${d.holiday ? ' cal-day--holiday' : ''}${d.weekday === 5 ? ' cal-day--friday' : ''}`} title={d.holiday ? d.holiday.nameAr : undefined}>
              <span class="d-h num">{d.hd}</span>
              <span class="d-g num">{d.greg.d}</span>
            </div>
          ))}
        </div>
        {m.days.some((d) => d.holiday) && (
          <ul class="cal-events">
            {m.days.filter((d) => d.holiday).map((d) => (
              <li><span class="num">{d.hd}</span> {m.monthName}: {d.holiday.nameAr}</li>
            ))}
          </ul>
        )}
      </section>
    ))}
  </div>

  <article class="prose" style="margin-block-start:var(--space-8)">
    <h2>ما هو التقويم الهجري؟</h2>
    <p>التقويم الهجري (أو التقويم الإسلامي) هو التقويم الرسمي المعتمد في المملكة العربية السعودية وعدد من الدول الإسلامية لتحديد المناسبات الدينية كشهر رمضان والأعياد. يعتمد على دورة القمر، حيث يتكوّن من اثني عشر شهرًا قمريًا، ويبلغ مجموع أيامه 354 أو 355 يومًا، أي أنه أقصر من التقويم الميلادي (الجرجوري) بنحو 11 يومًا كل سنة. ولهذا تختلف بداية الأشهر الهجرية عن نظيرتها الميلادية من عام لآخر.</p>
    <p>يبدأ التقويم الهجري من هجرة النبي محمد ﷺ من مكة إلى المدينة المنورة سنة 622 ميلادية، وهي الحدث الذي يُعتبر نقطة الصفر للتأريخ الإسلامي. ولمعرفة التحويل الدقيق بين التاريخين، يمكنك استخدام <a href="/hijri/">أداة تحويل التاريخ الهجري إلى ميلادي</a> التي تعتمد على تقويم أم القرى.</p>

    <h2>تقويم أم القرى — المرجع الرسمي</h2>
    <p>تقويم أم القرى هو التقويم الرسمي المعتمد في المملكة العربية السعودية منذ عام 1346 هـ، ويُستخدم في الأحوال المدنية والقضاء والتعاملات الإدارية. سُمّي بهذا الاسم نسبةً إلى مكة المكرمة (أم القرى) المذكورة في القرآن الكريم. يعتمد هذا التقويم على معايير فلكية دقيقة لحساب أطوار القمر وولادة الهلال، مما يجعله قابلًا للحساب مسبقًا والاعتماد عليه في الجداول السنوية. جميع التواريخ المعروضة في هذه الصفحة مبنية على تقويم أم القرى، وقد يختلف يومًا في بعض الحالات عن الرؤية البصرية للهلال التي تعتمد عليها بعض الدول الإسلامية.</p>

    <h2>بداية ونهاية العام {hy} هـ</h2>
    <p>يبدأ العام الهجري {hy} في يوم الأول من شهر محرّم، ويوافق هذا اليوم وفق تقويم أم القرى تاريخ {year.months[0].days[0].gregLabel} {year.months[0].days[0].greg.y} ميلاديًا تقريبًا. وينتهي العام {hy} هـ في اليوم الأخير من شهر ذي الحجّة، الموافق {year.months[11].days[year.months[11].days.length - 1].gregLabel} {year.months[11].days[year.months[11].days.length - 1].greg.y} م. وبهذا يبلغ طول العام الهجري {hy} نحو 354 أو 355 يومًا، تتوزّع على اثني عشر شهرًا قمريًا.</p>

    <h2>المناسبات الإسلامية الكبرى في {hy} هـ</h2>
    <p>تتوزّع المناسبات الإسلامية الرئيسية على مدار العام {hy} هـ، وإليك أبرزها مع ما يقابلها بالتقويم الميلادي وفق تقويم أم القرى:</p>
    <ul>
      <li><strong>رأس السنة الهجرية:</strong> 1 محرّم {hy} هـ يوافق {year.months[0].days[0].gregLabel} {year.months[0].days[0].greg.y} م، وهو أول أيام العام الهجري.</li>
      <li><strong>شهر رمضان {hy}:</strong> يبدأ 1 رمضان {hy} هـ الموافق {year.months[8].days[0].gregLabel} {year.months[8].days[0].greg.y} م، وهو شهر الصيام والقرآن عند المسلمين.</li>
      <li><strong>عيد الفطر {hy}:</strong> 1 شوّال {hy} هـ يوافق {year.months[9].days[0].gregLabel} {year.months[9].days[0].greg.y} م، وهو عيد المسلمين بعد صيام رمضان.</li>
      <li><strong>يوم عرفة {hy}:</strong> 9 ذو الحجّة {hy} هـ يوافق {year.months[11].days[8].gregLabel} {year.months[11].days[8].greg.y} م، وهو يوم الحج الأكبر ويصادف يوم الوقوف بعرفة.</li>
      <li><strong>عيد الأضحى {hy}:</strong> 10 ذو الحجّة {hy} هـ يوافق {year.months[11].days[9].gregLabel} {year.months[11].days[9].greg.y} م، وهو عيد النحر وأكبر أعياد المسلمين.</li>
    </ul>
    <p>ولمتابعة العدّ التنازلي لبداية هذه المناسبات، يُمكنك الاطلاع على <a href="/countdown/">عدّاد الأيام للأعياد والمناسبات الإسلامية</a> الذي يعرض الأيام المتبقية حتى كل عيد بالأيام والساعات.</p>

    <h2>التقويم الهجري 1447 — لمحة عن السنوات القريبة</h2>
    <p>إلى جانب عام {hy} هـ، يهتم كثير من الباحثين بـ <strong>التقويم الهجري 1447</strong> الذي يُعد من السنوات القريبة، حيث بدأ عام 1447 هـ في 26 يونيو 2025 ميلاديًا وانتهى في يونيو 2026 م. ويُمكنك تصفّح <a href="/calendar/1447/">التقويم الهجري 1447</a> في صفحته المستقلة للاطلاع على تفاصيل أيامه وأشهره ومناسباته. كما يُمكنك الرجوع إلى <a href="/calendar/1448/">التقويم الهجري 1448</a> أو <a href="/calendar/1449/">التقويم الهجري 1449</a> حسب السنة التي تبحث عنها. ولمعرفة كم عمرك بالسنة الهجرية أو حساب الفرق بين تاريخين ميلاديين وهجريين، تتوفر <a href="/age/">أداة حساب العمر بالتقويم الهجري</a>.</p>

    <h2>أشهر التقويم الهجري والشهور الحُرُم</h2>
    <p>يتكوّن التقويم الهجري من اثني عشر شهرًا مرتبة كما نزل بها التشريع: محرّم، صفر، ربيع الأول، ربيع الآخر، جمادى الأولى، جمادى الآخرة، رجب، شعبان، رمضان، شوّال، ذو القعدة، ذو الحجّة. ومن هذه الأشهر أربعة تُعرف بـ«الأشهر الحُرُم» ذكرها القرآن الكريم، وهي: محرّم، ورجب، وذو القعدة، وذو الحجّة. وفي صفحة التقويم {hy} هـ أعلاه تظهر الأشهر الحُرُم بعلامة خاصة بجوار اسم الشهر.</p>

    <h2>الفرق بين التقويم الهجري والميلادي</h2>
    <p>الفرق الأساسي بين التقويمين هو طول السنة: السنة الهجرية أقصر بنحو 11 يومًا من السنة الميلادية، لأنها قمرية بحتة بينما الميلادية شمسية. ونتيجة لذلك، يتحوّل شهر رمضان والأعياد عبر المواسم كل عام، فيمرّ المسلمون برمضان في الصيف والشتاء على مدى دورة تبلغ نحو 33 سنة. هذا التنقّل يجعل التقويم الهجري مرتبطًا بالرؤية الشرعية للهلال، وإن كانت المعايير الفلكية الحديثة كأم القرى توفّر دقة عالية في الحساب المسبق. لذلك تجد أن التقويم الهجري {hy} قد يبدأ في فصل مختلف عن تقويم السنة السابقة أو اللاحقة.</p>

    <h2>خلاصة</h2>
    <p>التقويم الهجري {hy} هـ يمثّل مرجعًا دينيًا ومدنيًا مهمًا للمسلمين في السعودية والخليج وكل العالم الإسلامي. هذه الصفحة تعرض الأشهر الاثني عشر كاملةً مع أيامها وما يقابلها ميلاديًا، مع إبراز الأعياد والمناسبات الكبرى. اعتمدنا على تقويم أم القرى الرسمي، ويُنصح دائمًا بالتحقق من الرؤية الشرعية للهلال قبل اعتماد أي تاريخ بشكل نهائي لما يتعلّق بالعبادات.</p>
  </article>

  <Disclaimer variant="hijri" />

  <Faq faqs={faqs} />

  <RelatedTools slugs={tool.related} />
</ToolLayout>
