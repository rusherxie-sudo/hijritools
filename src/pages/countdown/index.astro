---
import ToolLayout from '../../layouts/ToolLayout.astro';
import Icon from "../../components/Icon.astro";
import { toolIconId } from "../../data/icons.js";
import Faq from "../../components/Faq.astro";
import Disclaimer from '../../components/Disclaimer.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import { getTool } from '../../data/tools.js';
import { gccOrder, countries } from '../../data/countries.js';
import { hijriHolidays } from '../../data/hijri-holidays.js';
import { hijriToGregorian, formatGregorian, HIJRI_MONTHS_AR } from '../../lib/hijri.js';
import { webAppJsonLd, faqJsonLd, graph } from '../../lib/seo.js';

const tool = getTool('countdown');

const currentHijriYear = 1448;
const holidayTable = hijriHolidays.map((h) => {
  const g = hijriToGregorian(currentHijriYear, h.hm, h.hd, 0);
  return { ...h, gregDate: formatGregorian(g), hijriYear: currentHijriYear };
});

const faqs = [
  {
    q: 'كم باقي على رمضان؟',
    a: 'تعرض الأداة أعلى الصفحة عدد الأيام المتبقية حتى أول رمضان وفق تقويم أم القرى، ويتحدّث العدّ تلقائيًا كل يوم. وقد تختلف البداية الفعلية يومًا حسب رؤية الهلال في دولتك.',
  },
  {
    q: 'هل العدّ التنازلي دقيق لكل دول الخليج؟',
    a: 'نعم؛ اختر دولتك من القائمة لضبط فرق رؤية الهلال بفارق يوم واحد، فيتغيّر العدّ والتاريخ الميلادي المقابل بما يناسب التقويم المعتمد محليًا في السعودية والإمارات وقطر والكويت والبحرين وعُمان.',
  },
  {
    q: 'كيف أعمل عدّ تنازلي لمناسبتي أو تاريخ معيّن؟',
    a: 'من خانة «العدّ لأي تاريخ» اختر أي تاريخ ميلادي قادم — كزواج أو سفر أو امتحان — لتظهر لك الأيام المتبقية والتاريخ الهجري المقابل له فورًا.',
  },
  {
    q: 'متى يبدأ رمضان ١٤٤٨ هجريًا؟',
    a: `رمضان ١٤٤٨ يبدأ فلكيًا يوم ١ رمضان ١٤٤٨ هـ بإذن الله، وقد يختلف الموعد الفعلي يومًا واحدًا حسب رؤية الهلال في بلدك. تستطيع اختيار دولتك من القائمة لمشاهدة العدّ الأنسب.`,
  },
  {
    q: 'كم يومًا بين رمضان وعيد الفطر؟',
    a: 'شهر رمضان ٢٩ أو ٣٠ يومًا حسب رؤية الهلال. لذلك فإن الفارق بين أول رمضان وأول شوال (عيد الفطر) هو ٢٩ أو ٣٠ يومًا بالضبط.',
  },
  {
    q: 'متى عيد الأضحى ١٤٤٨ هجريًا؟',
    a: `يقف الحجاج يوم ٩ ذي الحجة (يوم عرفة)، ويكون عيد الأضحى في ١٠ ذي الحجة ١٤٤٨ هـ. الأداة تحدّث العدّ لكل من يوم عرفة وعيد الأضحى تلقائيًا.`,
  },
  {
    q: 'هل يُحدّث العدّ التنازلي تلقائيًا كل يوم؟',
    a: 'نعم، العدّ التنازلي مبني على تاريخ اليوم الفعلي لجهازك، ويتغيّر تلقائيًا عند فتح الصفحة في أي يوم جديد دون حاجة لتحديث يدوي.',
  },
];
const jsonLd = graph(
  webAppJsonLd({ name: tool.titleAr, description: tool.descAr, path: '/countdown/' }),
  faqJsonLd(faqs),
);
---
<ToolLayout title={tool.titleAr} description={tool.descAr} path="/countdown/" jsonLd={jsonLd}>
  <div class="tool-head">
    <span class="tool-head-chip"><Icon id={toolIconId(tool.slug)} size={28} /></span>
    <div class="tool-head-text">
      <h1>{tool.titleAr}</h1>
      <p class="tool-intro">{tool.descAr}</p>
    </div>
  </div>

  <div class="field" style="max-width:280px">
    <label for="country">الدولة (لضبط فرق رؤية الهلال)</label>
    <select id="country">
      {gccOrder.map((cc) => (<option value={cc}>{countries[cc].nameAr}</option>))}
    </select>
  </div>

  <!-- 三大节日倒计时 -->
  <div class="result-grid" id="events"></div>


  <!-- 自定义日期倒计时 -->
  <div class="card">
    <h2>العدّ لأي تاريخ</h2>
    <p style="color:var(--color-text-muted);margin-block-end:var(--space-4)">
      اختر تاريخًا ميلاديًا لمعرفة الأيام المتبقية والتاريخ الهجري المقابل له.
    </p>
    <div class="field" style="max-width:280px">
      <label for="custom-date">التاريخ المستهدف</label>
      <input type="date" id="custom-date" />
    </div>
    <div class="result hidden" id="custom-result">
      <div class="result-main"><span class="num" id="custom-days">0</span> يومًا متبقيًا</div>
      <hr class="gold-divider" />
      <div id="custom-hijri" class="num" style="color:var(--color-text-muted)"></div>
      <div id="custom-greg" class="num" style="color:var(--color-text-muted)"></div>
    </div>
    <p class="error-text hidden" id="custom-err">يرجى اختيار تاريخ صالح ضمن النطاق المدعوم.</p>
  </div>

  <div class="card" style="margin-block-start:var(--space-8)">
    <h2>المناسبات الإسلامية لعام ١٤٤٨ هـ</h2>
    <p style="color:var(--color-text-muted);margin-block-end:var(--space-4)">
      التواريخ الميلادية تقريبية حسب تقويم أم القرى، وقد تختلف يومًا واحدًا حسب رؤية الهلال في دولتك.
    </p>
    <table class="holiday-table">
      <thead>
        <tr><th>المناسبة</th><th>التاريخ الهجري</th><th>التاريخ الميلادي (تقديري)</th></tr>
      </thead>
      <tbody>
        {holidayTable.map((h) => (
          <tr>
            <td>{h.nameAr}</td>
            <td class="num">{h.hd} {HIJRI_MONTHS_AR[h.hm]} {h.hijriYear}</td>
            <td class="num">{h.gregDate}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <Disclaimer variant="calc" />

  <!-- المحتوى التعليمي -->
  <div class="card tool-guide">
    <h2>لماذا نستخدم التقويم الهجري للعدّ التنازلي؟</h2>
    <p>كثير من المناسبات الإسلامية (رمضان، عيد الفطر، عيد الأضحى، الحج) تُحدد بالتقويم الهجري. العدّ التنازلي بالتقويمين معًا يساعدك على التخطيط: المناسبات الدينية والهجرية بالتقويم الهجري، والاجتماعات والسفر بالموعد الميلادي.</p>

    <h2>أبرز المناسبات الإسلامية</h2>
    <ul>
      <li><strong>رمضان:</strong> شهر الصيام، يتغير تاريخه سنويًا بالتقويم الميلادي (يتقدم ~١١ يومًا كل سنة)</li>
      <li><strong>عيد الفطر:</strong> أول شوال، بعد رمضان بـ ١ يوم</li>
      <li><strong>عيد الأضحى:</strong> tenth of Dhul Hijjah، يوم النحر</li>
      <li><strong>أول محرم:</strong> رأس السنة الهجرية</li>
      <li><strong>ليلة الإسراء والمعراج:</strong> ٢٧ رجب</li>
    </ul>

    <h2>فائدة العدّ التنازلي</h2>
    <p>معرفةعدد الأيام المتبقية على مناسبة قادمة تساعدك على:</p>
    <ul>
      <li>تجهيز كل ما تحتاجه قبل رمضان (الصيام، الصدقات، الخطط)</li>
      <li>حجز رحلات الحج والعمرة مبكرًا</li>
      <li>التخطيط للاحتفالات والمناسبات العائلية</li>
      <li>إعداد جدول دراسي أو عمل يتوافق مع الموسم</li>
    </ul>

    <h2>دقة التواريخ</h2>
    <p>تعتمد التواريخ على تقويم أم القرى الرسمي. قد يختلف التاريخ الفعلي يومًا واحدًا حسب رؤية الهلال في بعض الدول.</p>
  </div>

  <Faq faqs={faqs} />

  <RelatedTools slugs={tool.related} />
</ToolLayout>

<script>
  import { daysBetween, nextHijriEvent, EVENTS } from '../../lib/countdown.js';
  import { gregorianToHijri, formatHijri, formatGregorian } from '../../lib/hijri.js';
  import { todayUtc, parseISODate, toISODate } from '../../lib/date-utils.js';

  const $ = (id) => document.getElementById(id);
  const countrySel = $('country');
  // 海湾各国相对沙特官历的偏移（与 hijri 页保持一致，默认 0）。
  const offsets = { sa: 0, ae: 0, qa: 0, kw: 0, bh: 0, om: 0 };
  const getOffset = () => offsets[countrySel.value] ?? 0;

  // 剩余天数文案：0=اليوم，1=غدًا，其余=N يومًا。
  function daysLabel(n) {
    if (n === 0) return 'اليوم';
    if (n === 1) return 'غدًا';
    return `<span class="num">${n}</span> يومًا متبقيًا`;
  }

  function renderEvents() {
    const today = todayUtc();
    const off = getOffset();
    const grid = $('events');
    grid.innerHTML = '';
    for (const ev of EVENTS) {
      const g = nextHijriEvent(today, ev.hm, ev.hd, off);
      const days = daysBetween(today, g);
      const el = document.createElement('div');
      el.className = 'stat';
      el.innerHTML =
        `<div class="l" style="font-weight:700;color:var(--color-primary-dark);font-size:var(--fs-base)">${ev.nameAr}</div>` +
        `<div class="v">${days}</div>` +
        `<div class="l">${daysLabel(days)}</div>` +
        `<div class="l num" style="margin-block-start:.4rem">${formatGregorian(g)}</div>`;
      grid.appendChild(el);
    }
  }

  function renderCustom() {
    const box = $('custom-result');
    const err = $('custom-err');
    const d = parseISODate($('custom-date').value);
    if (!d) { box.classList.add('hidden'); err.classList.add('hidden'); return; }
    try {
      const today = todayUtc();
      const off = getOffset();
      const days = daysBetween(today, d);
      const h = gregorianToHijri(d, off);
      $('custom-days').textContent = days;
      $('custom-greg').textContent = formatGregorian(d);
      $('custom-hijri').textContent = formatHijri(h);
      box.classList.remove('hidden');
      err.classList.add('hidden');
    } catch {
      box.classList.add('hidden');
      err.classList.remove('hidden');
    }
  }

  // 初始化：自定义日期默认填今天。
  $('custom-date').value = toISODate(todayUtc());
  renderEvents();
  renderCustom();
  countrySel.addEventListener('change', () => { renderEvents(); renderCustom(); });
  $('custom-date').addEventListener('change', renderCustom);
</script>

<style>
  .holiday-table { width: 100%; border-collapse: collapse; }
  .holiday-table th { text-align: start; padding: var(--space-2) var(--space-3); border-block-end: 2px solid var(--color-primary-dark); color: var(--color-primary-dark); font-weight: 700; }
  .holiday-table td { padding: var(--space-2) var(--space-3); border-block-end: 1px solid var(--color-border); }
  .holiday-table tbody tr:hover { background: var(--color-primary-light); }
</style>
