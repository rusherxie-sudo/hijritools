---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ShareButtons from '../components/ShareButtons.astro';
import { breadcrumbJsonLd } from '../lib/seo.js';

const {
  title,
  description,
  path = '/',
  jsonLd = null,
  noindex = false,
  wide = false, // 首页等需要宽骨架的页面设 true；工具页默认收窄正文
  breadcrumb = null, // 可选自定义面包屑 [{name, path}]；缺省时工具页自动用「首页 > 当前页」
} = Astro.props;

const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://hijritools.com';
const canonical = `${site}${path}`;
const ogImage = `${site}/og.png`;
const fullTitle = title.includes('HijriTools') ? title : `${title} | HijriTools`;

// GA4 初始化脚本（用 set:html={表达式} 原样输出，避免 JSX 转义单引号为 &#39; 破坏脚本）。
const gaId = 'G-EW5LTTLXTY';
const gaInit = `window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${gaId}');`;

// 面包屑：首页与 noindex 页不显示；其余默认两级（首页 > 当前页），可被 breadcrumb prop 覆盖。
const crumbs = !noindex && path !== '/'
  ? (breadcrumb ?? [{ name: 'الرئيسية', path: '/' }, { name: title, path }])
  : null;

// 把 BreadcrumbList 注入页面已有的 @graph（零页面改动即获面包屑结构化数据）。
const finalJsonLd = crumbs && jsonLd && Array.isArray(jsonLd['@graph'])
  ? { ...jsonLd, '@graph': [...jsonLd['@graph'], breadcrumbJsonLd(crumbs)] }
  : jsonLd;
---
<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Google Analytics 4（G-EW5LTTLXTY）。仅生产环境注入，避免本地 dev/preview 污染 GA4 数据。 -->
    {import.meta.env.PROD && (
      <Fragment>
        <script async is:inline src="https://www.googletagmanager.com/gtag/js?id=G-EW5LTTLXTY"></script>
        <script is:inline set:html={gaInit}></script>
      </Fragment>
    )}
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex
      ? <meta name="robots" content="noindex, follow" />
      : <link rel="canonical" href={canonical} />}
    {!noindex && <link rel="alternate" hreflang="ar" href={canonical} />}
    {!noindex && <link rel="alternate" hreflang="x-default" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="HijriTools" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ar" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- 字体：Tajawal 自托管 woff2（src/styles/fonts.css），无第三方往返；预载最常用的阿语字重。 -->
    <link rel="preload" href="/fonts/tajawal-400-arabic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/tajawal-700-arabic.woff2" as="font" type="font/woff2" crossorigin />
    {finalJsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(finalJsonLd)} />
    )}
  </head>
  <body>
    <SiteHeader />
    <main>
      <div class={wide ? 'container' : 'container container--content'}>
        {crumbs && (
          <nav class="breadcrumb" aria-label="مسار التنقل">
            <ol>
              {crumbs.map((c, i) => (
                <li>
                  {i < crumbs.length - 1
                    ? <a href={c.path}>{c.name}</a>
                    : <span aria-current="page">{c.name}</span>}
                </li>
              ))}
            </ol>
          </nav>
        )}
        <slot />
        {!noindex && <ShareButtons title={title} url={canonical} />}
      </div>
    </main>
    <SiteFooter />
  </body>
</html>
